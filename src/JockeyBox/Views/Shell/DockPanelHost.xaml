<UserControl x:Class="JockeyBox.Views.Shell.DockPanelHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Stretch"
             Width="0" Visibility="Collapsed">
    <!-- The dock column. One caption bar for every pane, so seven panels cannot
         drift into seven different headers, and a splitter on the inner edge so the
         width is the operator's choice rather than a number baked into the layout. -->
    <Border x:Name="Frame" Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="8,6,6,4" LastChildFill="False">
                    <TextBlock x:Name="Caption" DockPanel.Dock="Left" Text=""
                               FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="PopOutButton" DockPanel.Dock="Right" Content="&#x2197;"
                            Width="22" Height="20" Padding="0" FontSize="10" Margin="2,0,0,0"
                            Click="OnPopOutClick"
                            AutomationProperties.Name="Open this panel in its own window"
                            ToolTip="Open in its own window"/>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="&#x2715;"
                            Width="22" Height="20" Padding="0" FontSize="10"
                            Click="OnCloseClick"
                            AutomationProperties.Name="Close the docked panel"
                            ToolTip="Close"/>
                </DockPanel>

                <ContentControl x:Name="ContentHost" Focusable="False"/>
            </DockPanel>

            <!-- A Thumb, not a GridSplitter: a GridSplitter resizes Grid columns, and
                 the width this column trades is the host's own, so a splitter would
                 need a second column definition to push against. The Thumb reports the
                 drag delta and the host clamps and persists it. -->
            <Thumb Grid.Column="1" x:Name="Splitter" Cursor="SizeWE"
                   DragDelta="OnSplitterDrag" DragCompleted="OnSplitterDragCompleted"
                   AutomationProperties.Name="Resize the docked panel">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border Width="1" Background="{StaticResource BorderBrush}"
                                    HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
