<Window x:Class="JockeyBox.Views.Shell.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel" Width="560" Height="640"
        MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <!-- A docked panel, undocked. Same content element, same caption, plus the two
         window concerns the dock cannot express: always-on-top and its own geometry. -->
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8,6,6,4" LastChildFill="False">
            <TextBlock x:Name="Caption" DockPanel.Dock="Left" Text=""
                       FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Center"/>
            <CheckBox x:Name="TopmostToggle" DockPanel.Dock="Right" Content="On top"
                      FontSize="10" VerticalAlignment="Center"
                      Click="OnTopmostChanged"
                      AutomationProperties.Name="Keep this window above other windows"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="6,0,6,6">
            <ContentControl x:Name="ContentHost" Focusable="False"/>
        </Border>
    </Grid>
</Window>
