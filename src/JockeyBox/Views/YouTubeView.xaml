<UserControl x:Class="JockeyBox.Views.YouTubeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JockeyBox.Views"
             Background="Transparent">

    <UserControl.Resources>
        <views:YtDurationConverter x:Key="DurationText"/>
        <views:ViewCountConverter x:Key="ViewsText"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E06C7A"/>

        <!-- Dim uppercase label used for every section head. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Dim meta text (counts, status, selected item). -->
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Result row: two lines, no chrome, clear hover + selected state. -->
        <Style x:Key="MediaRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,3"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Playlist row: one dense line, same family as the results but tabular. -->
        <Style x:Key="TrackRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,0"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" Height="26">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square icon button used in the pane footers / toolbars. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Same, but only live while a playlist track is selected. -->
        <Style x:Key="TrackIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPlaylistTrack}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same, but only live while a search result is selected. -->
        <Style x:Key="ResultIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedResult}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Playlist-level buttons in the manage strip. -->
        <Style x:Key="PlaylistIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPlaylist}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact toolbar text button. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- Quiet toggle that reveals a secondary strip (import / playlist manage). -->
        <Style x:Key="StripToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card holding one pane. -->
        <Style x:Key="PaneCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>

        <!-- Real column splitter between the two panes, with a grip. -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="grip" Width="2" Height="26" CornerRadius="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Two panes, both full height ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Search results ============ -->
            <Border Grid.Column="0" Style="{StaticResource PaneCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section head + search feedback -->
                    <Grid Grid.Row="0" Height="14">
                        <TextBlock Text="SEARCH RESULTS" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Searching&#x2026;" FontSize="10.5"
                                       Foreground="{StaticResource AccentBBrush}" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource MetaText}"
                                       MaxWidth="170" ToolTip="{Binding SearchStatus}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Search + import disclosure -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="24" FontSize="12" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchKeyDown"
                                 ToolTip="Search YouTube by title, artist or a phrase"/>
                        <Button Grid.Column="1" Content="Search" Style="{StaticResource ToolButton}"
                                Width="64" Margin="6,0,0,0"
                                Command="{Binding SearchCommand}" ToolTip="Search YouTube"/>
                        <ToggleButton Grid.Column="2" x:Name="ImportToggle" Content="&#x2B07;"
                                      Style="{StaticResource StripToggle}" Margin="6,0,0,0"
                                      ToolTip="Import a video or playlist by URL"/>
                    </Grid>

                    <!-- Import strip, hidden until asked for -->
                    <Grid Grid.Row="2" Height="24" Margin="0,6,0,0"
                          Visibility="{Binding IsChecked, ElementName=ImportToggle,
                                       Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="URL" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Height="24" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding ImportUrl, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnImportKeyDown"
                                 ToolTip="Paste a YouTube video or playlist link"/>
                        <Button Grid.Column="2" Content="Import" Style="{StaticResource ToolButton}"
                                Width="56" Margin="6,0,0,0"
                                Command="{Binding ImportCommand}"
                                ToolTip="Add a YouTube video or playlist by URL"/>
                    </Grid>

                    <!-- Results -->
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <ListBox x:Name="ResultList" ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult}"
                                 ItemContainerStyle="{StaticResource MediaRow}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Standard"
                                 MouseDoubleClick="OnResultDoubleClick"
                                 PreviewMouseRightButtonDown="OnResultRightClick"
                                 KeyDown="OnResultKeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play"
                                              Command="{Binding PlacementTarget.DataContext.PlayResultCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Download"
                                              Command="{Binding PlacementTarget.DataContext.DownloadResultCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Add to playlist"
                                              Command="{Binding PlacementTarget.DataContext.AddResultToPlaylistCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding Uploader}" FontSize="10.5"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                <TextBlock Text="  &#x00B7;  " FontSize="10.5"
                                                           Foreground="{StaticResource TextDimBrush}"/>
                                                <TextBlock Text="{Binding Duration, Converter={StaticResource DurationText}}"
                                                           FontFamily="Consolas" FontSize="10.5"
                                                           Foreground="{StaticResource TextDimBrush}"/>
                                                <TextBlock Text="  &#x00B7;  " FontSize="10.5"
                                                           Foreground="{StaticResource TextDimBrush}"/>
                                                <TextBlock Text="{Binding ViewCount, Converter={StaticResource ViewsText}}"
                                                           FontSize="10.5" Foreground="{StaticResource TextDimBrush}"/>
                                                <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Margin="8,0,0,0"
                                                           Foreground="{StaticResource AccentBBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="&#x25B6;" FontSize="9" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Search YouTube, or import a link with &#x2B07;."
                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Results.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsSearching}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Actions on the selected result, inline with its name -->
                    <Grid Grid.Row="4" Height="22" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="&#x25B6;" Style="{StaticResource ResultIconButton}"
                                    Command="{Binding PlayResultCommand}"
                                    ToolTip="Play the selected result through Deck B (Enter or double-click)"/>
                            <Button Content="&#x2B07;" Style="{StaticResource ResultIconButton}"
                                    Command="{Binding DownloadResultCommand}"
                                    ToolTip="Download the selected result into the library"/>
                            <Button Content="+" Style="{StaticResource ResultIconButton}"
                                    Command="{Binding AddResultToPlaylistCommand}"
                                    ToolTip="Add the selected result to the selected playlist"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Title}"
                                   Style="{StaticResource MetaText}" HorizontalAlignment="Right"
                                   Margin="8,0,2,0"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                          ToolTip="Drag to resize"/>

            <!-- ============ Playlist ============ -->
            <Border Grid.Column="2" Style="{StaticResource PaneCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section head + counts -->
                    <Grid Grid.Row="0" Height="14">
                        <TextBlock Text="PLAYLIST" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding CountsText}" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CountsText}"/>
                    </Grid>

                    <!-- Playlist picker + filter + manage disclosure -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Height="24" FontSize="11" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Playlists}"
                                  SelectedItem="{Binding SelectedPlaylist}" DisplayMemberPath="Name"
                                  ToolTip="{Binding SelectedPlaylist.Name}"/>
                        <TextBlock Grid.Column="1" Text="FILTER" Style="{StaticResource SectionLabel}"
                                   Margin="8,0,4,0"/>
                        <TextBox Grid.Column="2" Width="88" Height="24" FontSize="11"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding PlaylistFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter playlist tracks by title or artist"/>
                        <ToggleButton Grid.Column="3" x:Name="ManageToggle" Content="&#x22EF;"
                                      Style="{StaticResource StripToggle}" Margin="6,0,0,0"
                                      ToolTip="New, rename, delete, download the playlist"/>
                    </Grid>

                    <!-- Playlist manage strip, hidden until asked for -->
                    <Grid Grid.Row="2" Height="22" Margin="0,6,0,0"
                          Visibility="{Binding IsChecked, ElementName=ManageToggle,
                                       Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="22" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Name for a new playlist, or the new name when renaming"/>
                        <Button Grid.Column="1" Content="+" Style="{StaticResource IconButton}" Height="22"
                                Width="22" Margin="5,0,0,0"
                                Command="{Binding CreatePlaylistCommand}" ToolTip="Create playlist"/>
                        <Button Grid.Column="2" Content="&#x270E;" Style="{StaticResource PlaylistIconButton}"
                                Height="22" Width="22" Margin="4,0,0,0"
                                Command="{Binding RenamePlaylistCommand}"
                                ToolTip="Rename the selected playlist"/>
                        <Button Grid.Column="3" Content="&#x2715;" Style="{StaticResource PlaylistIconButton}"
                                Height="22" Width="22" Margin="4,0,0,0"
                                Command="{Binding RemovePlaylistCommand}"
                                ToolTip="Delete the selected playlist"/>
                        <Button Grid.Column="4" Content="&#x2B07;" Style="{StaticResource PlaylistIconButton}"
                                Height="22" Width="22" Margin="4,0,0,0"
                                Command="{Binding DownloadPlaylistCommand}"
                                ToolTip="Queue every track in this playlist that is not in the library yet"/>
                    </Grid>

                    <ListView Grid.Row="3" x:Name="PlaylistTracksList" ItemsSource="{Binding PlaylistTracksView}"
                              SelectedItem="{Binding SelectedPlaylistTrack}"
                              ItemContainerStyle="{StaticResource TrackRow}"
                              Background="Transparent" BorderThickness="0"
                              Margin="0,4,0,0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              MouseDoubleClick="OnPlaylistTrackDoubleClick"
                              PreviewMouseRightButtonDown="OnPlaylistTrackRightClick"
                              KeyDown="OnPlaylistTrackKeyDown">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Play"
                                          Command="{Binding PlacementTarget.DataContext.PlayPlaylistTrackCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Download"
                                          Command="{Binding PlacementTarget.DataContext.DownloadPlaylistTrackCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Remove from playlist"
                                          Command="{Binding PlacementTarget.DataContext.RemoveTrackCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding DisplayName}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Artist}"
                                               FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="8,0,0,0"
                                               ToolTip="{Binding Artist}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                               FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" Margin="6,0,4,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StateGlyph}" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="InLibrary">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Queued">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty playlist hint, sits over the (empty) list -->
                    <TextBlock Grid.Row="3" Margin="0,4,0,0"
                               Text="No tracks here yet. Import a link, or add a result with +."
                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PlaylistTracksView.IsEmpty}" Value="True"/>
                                            <Condition Binding="{Binding IsImporting}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Track actions, inline with the selected track -->
                    <Grid Grid.Row="4" Height="22" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="&#x25B6;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding PlayPlaylistTrackCommand}"
                                    ToolTip="Play the selected track"/>
                            <Button Content="&#x2B07;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding DownloadPlaylistTrackCommand}"
                                    ToolTip="Download the selected track"/>
                            <Button Content="&#x2715;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding RemoveTrackCommand}"
                                    ToolTip="Remove the selected track from the playlist"/>
                            <Button Content="&#x2191;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding MoveTrackUpCommand}"
                                    ToolTip="Move the selected track up"/>
                            <Button Content="&#x2193;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding MoveTrackDownCommand}"
                                    ToolTip="Move the selected track down"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPlaylistTrack.DisplayName}"
                                   Style="{StaticResource MetaText}" HorizontalAlignment="Right"
                                   Margin="8,0,2,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Status ============ -->
        <Grid Grid.Row="1" Height="16" Margin="2,4,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="10.5"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" ToolTip="{Binding StatusText}"/>
            <TextBlock Grid.Column="1" Text="Importing&#x2026;" FontSize="10.5"
                       Foreground="{StaticResource AccentBBrush}" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Grid.Column="2" Text="Working&#x2026;" FontSize="10.5"
                       Foreground="{StaticResource AccentABrush}" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</UserControl>
