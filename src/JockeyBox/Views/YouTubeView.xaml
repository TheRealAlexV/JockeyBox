<UserControl x:Class="JockeyBox.Views.YouTubeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JockeyBox.Views"
             Unloaded="OnViewUnloaded"
             DataContextChanged="OnViewDataContextChanged"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Shared row design, context menu and filter/sort strip, identical to
             the library and Spotify lists. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/JockeyBox;component/Views/Shared/TrackRows.xaml"/>
            <ResourceDictionary Source="/JockeyBox;component/Views/Shared/TrackMenu.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <views:YtDurationConverter x:Key="DurationText"/>
        <views:ViewCountConverter x:Key="ViewsText"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E06C7A"/>

        <!-- Dim uppercase label used for every section head. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Dim meta text (counts, status, selected item). -->
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Result row: two lines, no chrome, clear hover + selected state. -->
        <Style x:Key="MediaRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,3"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Playlist row: one dense line, same family as the results but tabular. -->
        <Style x:Key="TrackRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,0"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" Height="26">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square icon button used in the pane footers / toolbars. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Same, but only live while a playlist track is selected. -->
        <Style x:Key="TrackIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPlaylistTrack}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same, but only live while a search result is selected. -->
        <Style x:Key="ResultIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedResult}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Playlist-level buttons in the manage strip. -->
        <Style x:Key="PlaylistIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPlaylist}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact toolbar text button. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- Quiet toggle that reveals a secondary strip (import / playlist manage). -->
        <Style x:Key="StripToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small per-result action inside a media row; the row itself stays selectable. -->
        <Style x:Key="RowMiniButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- The preview action, spelled out: a bare play glyph was invisible next to the row. -->
        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Content" Value="PREVIEW"/>
            <Setter Property="ToolTip" Value="Streams instantly, nothing is saved"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        </Style>

        <!-- Card holding one pane. -->
        <Style x:Key="PaneCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>

        <!-- Real column splitter between the two panes, with a grip. -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="grip" Width="2" Height="26" CornerRadius="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= YouTube account / write strip =================
             Compact, one row above the panes: sign-in, remote playlist creation,
             and the two per-track writes. Every button's tooltip explains why it
             is disabled when it is. -->
        <!-- One wrapping strip instead of nine rigid columns. At a wide window this is
             still a single 26px row; when the pane cannot hold every button they flow
             onto a second line instead of running under the right edge. -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">

            <!-- Search lives in this strip, not in the pane: a 42 px input row of
                 its own cost the results list a whole row, and at the designed size
                 the pane barely has three. Same controls, same behaviour, same
                 reachability - they just wrap onto another line when narrow instead
                 of shortening the list. -->
            <TextBox Width="150" FontSize="11.5" VerticalContentAlignment="Center"
                     MinHeight="24" Margin="0,0,6,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchKeyDown"
                     ToolTip="Search YouTube by title, artist, a phrase, or a video / playlist link"
                     AutomationProperties.Name="Search YouTube"/>
            <Button Content="Search" Style="{StaticResource ToolButton}"
                    MinWidth="64" Margin="0,0,10,0" VerticalAlignment="Center"
                    Command="{Binding SearchCommand}" ToolTip="Search YouTube"/>

            <!-- Filter and sort for the results, kept with the query they narrow. -->
            <ContentControl x:Name="FilterHost" Focusable="False" VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            ContentTemplate="{StaticResource FilterSortStrip}"/>

            <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource MetaText}"
                       MaxWidth="140" VerticalAlignment="Center" Margin="0,0,10,0"
                       ToolTip="{Binding SearchStatus}" TextTrimming="CharacterEllipsis"/>

            <Button Content="{Binding YouTubeConnectLabel}"
                    Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                    Command="{Binding ConnectYouTubeCommand}"
                    ToolTip="Sign in with Google, or change the connected channel"/>

            <Button Content="Import my playlists"
                    Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                    Command="{Binding ImportMyPlaylistsCommand}"
                    ToolTip="{Binding ImportMyPlaylistsHint}"/>

            <Button Content="Add to YouTube"
                    Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                    Command="{Binding AddSelectedToYouTubeCommand}"
                    ToolTip="{Binding AddToYouTubeHint}"/>

            <Button Content="Remove from YouTube"
                    Style="{StaticResource ToolButton}" Margin="0,0,10,0"
                    Command="{Binding RemoveFromYouTubeCommand}"
                    ToolTip="{Binding RemoveFromYouTubeHint}"/>

            <!-- Creating a channel playlist is its own job, so it travels as one unit:
                 a named field, its privacy and the button that creates it. Without the
                 label an empty box reads as an unlabelled control. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="New playlist" Style="{StaticResource SectionLabel}" Margin="0,0,6,0"/>
                <TextBox Width="118" Height="24" Padding="6,2" FontSize="11"
                         VerticalContentAlignment="Center"
                         Text="{Binding RemotePlaylistName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Name for a new playlist created on your YouTube channel"/>

                <ComboBox Width="82" Height="24" FontSize="11" Margin="6,0,0,0"
                          ItemsSource="{Binding PrivacyOptions}"
                          SelectedItem="{Binding SelectedRemotePrivacy}"
                          ToolTip="Privacy of the new YouTube playlist"/>

                <Button Content="+ Remote"
                        Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                        Command="{Binding CreateRemotePlaylistCommand}"
                        ToolTip="{Binding CreateRemoteHint}"/>
            </StackPanel>
        </WrapPanel>

        <!-- ================= Two panes, both full height ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Search results ============ -->
            <Border Grid.Column="0" Style="{StaticResource PaneCard}">
                <!-- The results list must never be squeezed shut.
                     Measured on the live tree at 1400x900: the pane is handed 150 px
                     and its fixed chrome needs 105 (head 14, search 42, paste 27,
                     action foot 22, preview strip 0 while idle) plus 52 for the filter
                     strip and the column headers. The star row was therefore receiving
                     nothing and ResultList measured 0x0 at every window size, so no
                     result could ever be shown at the size the app is designed for.
                     The Grid now has a floor of chrome + 52 + two whole rows (68) =
                     257, and the ScrollViewer scrolls the pane when the slot cannot
                     give that much: the list keeps its rows, the chrome stays
                     reachable, and neither vanishes. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <!-- Thinner and dimmer than a list's own bar, and only there
                             while the pane is too short: it reads as "there is more
                             pane", not as a second scrollbar to choose between. -->
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Width" Value="6"/>
                            <Setter Property="Opacity" Value="0.55"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                <!-- Floor = the chrome left in the pane (head 14 + column headers 26
                     + paste 27 + action foot 22 = 89) plus two whole rows (68). The
                     search row and filter strip now live in the tab toolbar, so this
                     fits inside the 150 px the pane gets at the designed size and
                     three rows show without scrolling. -->
                <Grid MinHeight="157">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- The pane's section title and search feedback moved to the tab
                         toolbar. That 14 px row was the difference between two and
                         three whole result rows at the designed window size. -->

                    <!-- Paste row: a link (or bare id) becomes a listing of what it holds -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="URL" Style="{StaticResource SectionLabel}"
                                       Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="ImportUrlBox" FontSize="11"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ImportUrl, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnImportKeyDown"
                                     ToolTip="A YouTube video link, a playlist link, or a bare video / playlist id"/>
                            <Button Grid.Column="2" Content="Load" Style="{StaticResource ToolButton}"
                                    Width="52" Margin="6,0,0,0"
                                    Command="{Binding LoadImporterCommand}"
                                    ToolTip="List what this link contains (Enter does the same)"/>
                            <ToggleButton Grid.Column="3" Content="Downloaded"
                                          Style="{StaticResource StripToggle}"
                                          Width="Auto" MinWidth="86" Margin="6,0,0,0"
                                          IsChecked="{Binding IsDownloadedView, Mode=TwoWay}"
                                          ToolTip="Browse the files that came from YouTube"/>
                        </Grid>

                        <!-- One short line, never a dialog -->
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ImportError}" FontSize="10.5"
                                       TextWrapping="Wrap" Foreground="{StaticResource AccentBBrush}"
                                       Visibility="{Binding HasImportError,
                                                    Converter={StaticResource BoolToVisibility}}"/>
                            <Button Grid.Column="1" Content="Retry" Style="{StaticResource ToolButton}"
                                    Width="48" Margin="6,0,0,0" VerticalAlignment="Top"
                                    Command="{Binding RetryImportCommand}"
                                    Visibility="{Binding CanRetryImport,
                                                 Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Content pane: search results, an importer listing, or the downloaded view.
                         ClipToBounds: this cell is the pane's star row, so when a short window
                         squeezes it shut its own filter strip and headers would otherwise paint
                         over the preview bar below instead of being cut at the row boundary. -->
                    <Grid Grid.Row="0" Margin="0,4,0,0" ClipToBounds="True">

                        <!-- Search results -->
                        <Grid Visibility="{Binding ShowSearchResults,
                                          Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="68"/>
                            </Grid.RowDefinitions>
                            <ContentControl Grid.Row="0" Content="{StaticResource TrackColumnHeaders}"
                                            Focusable="False" IsTabStop="False"/>
                        <ListBox Grid.Row="1" x:Name="ResultList" ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult}"
                                 ItemContainerStyle="{StaticResource MediaRow}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="OnResultDoubleClick"
                                 PreviewMouseRightButtonDown="OnResultRightClick"
                                 KeyDown="OnResultKeyDown"
                                 ItemTemplate="{StaticResource YouTubeResultRow}"
                                 ContextMenu="{StaticResource TrackMenu}">
                        </ListBox>

                        <!-- Empty state for the list body. It belongs in the list row
                             (2), never in row 0 with the filter strip, it must not
                             swallow clicks meant for the list behind it, and it is a
                             single trimmed line. ClipToBounds is what stops it spilling
                             onto the preview bar when the list row is squeezed to a few
                             pixels by a short window. -->
                        <Grid Grid.Row="2" ClipToBounds="True">
                            <TextBlock IsHitTestVisible="False"
                                       Text="Type a title or artist above, or paste a link to list a playlist."
                                       FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       MaxWidth="340" Margin="12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Results.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsSearching}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        </Grid>

                        <!-- Importer listing: what the pasted link holds, in source order -->
                        <Grid Visibility="{Binding ShowImporter, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,2,0,0">
                                <TextBlock Text="{Binding ImportHeader}" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding ImportTitle}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ImportTitle}"/>
                                <TextBlock Text="{Binding ImportMeta}" Style="{StaticResource MetaText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ImportMeta}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{Binding DownloadSelectedText}"
                                        Style="{StaticResource ToolButton}"
                                        Command="{Binding DownloadSelectedCommand}"
                                        ToolTip="Queue the checked rows through the download queue"/>
                                <Button Content="Download all" Style="{StaticResource ToolButton}"
                                        Margin="6,0,0,0"
                                        Command="{Binding DownloadAllCommand}"
                                        Visibility="{Binding ShowDownloadAll,
                                                     Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Queue every row in this listing"/>
                                <Button Content="Close" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                        Command="{Binding CloseImporterCommand}"
                                        ToolTip="Leave the listing and go back to search results"/>
                            </StackPanel>

                            <ListBox Grid.Row="2" Margin="0,6,0,0" ItemsSource="{Binding ImporterRows}"
                                     ItemContainerStyle="{StaticResource MediaRow}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Standard">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                                      ToolTip="Include this row in Download selected"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="10.5"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                                       FontFamily="Consolas" FontSize="10.5"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="10.5"
                                                       Width="100" TextAlignment="Right" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDimBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="3" Text="{Binding ImportEmptyText}"
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" MaxWidth="250">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImporterRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        </Grid>

                        <!-- Files that came from YouTube, resolved from the ledger, not the file name -->
                        <Grid Visibility="{Binding IsDownloadedView,
                                          Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding DownloadedSummary}"
                                       Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                       Margin="0,2,0,0" ToolTip="{Binding DownloadedSummary}"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Play" Style="{StaticResource ToolButton}"
                                        Command="{Binding PlayDownloadedCommand}"
                                        ToolTip="Load the selected file on a deck"/>
                                <Button Content="Show in Explorer" Style="{StaticResource ToolButton}"
                                        Margin="6,0,0,0"
                                        Command="{Binding RevealDownloadedCommand}"
                                        ToolTip="Reveal the selected file in Explorer"/>
                                <Button Content="Refresh" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                        Command="{Binding RefreshDownloadedCommand}"
                                        ToolTip="Re-read the ledger and the disk"/>
                            </StackPanel>

                            <ListBox Grid.Row="2" Margin="0,6,0,0" ItemsSource="{Binding DownloadedFiles}"
                                     SelectedItem="{Binding SelectedDownloadedFile}"
                                     ItemContainerStyle="{StaticResource MediaRow}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Standard">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="&#x25B6;"
                                                        Style="{StaticResource RowMiniButton}"
                                                        Command="{Binding DataContext.PlayDownloadedFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Play this file on a deck"/>
                                                <Button Content="&#x2197;"
                                                        Style="{StaticResource RowMiniButton}"
                                                        Command="{Binding DataContext.RevealDownloadedFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Reveal this file in Explorer"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="3" Text="No file from YouTube is in the library yet."
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" MaxWidth="250">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DownloadedFiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- Preview strip: position / seek / play-pause for what the deck is playing.
                         Collapsed while there is nothing to show: an idle strip is 32 px of
                         dead height in a pane that only gets 150 px, and it is exactly what
                         pushed the results list to zero. It appears the moment there is a
                         stream, a load in flight, a status line or a position to report. -->
                    <views:PreviewBar Grid.Row="2" DataContext="{Binding Preview}">
                        <views:PreviewBar.Style>
                            <Style TargetType="views:PreviewBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:PreviewBar.Style>
                    </views:PreviewBar>

                    <!-- Actions on the selected result, inline with its name -->
                    <Grid Grid.Row="3" Height="22" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="&#x25B6;" Style="{StaticResource ResultIconButton}"
                                    Command="{Binding PlayResultCommand}"
                                    ToolTip="Play the selected result through Deck B (Enter or double-click)"/>
                            <Button Content="&#x2B07;" Style="{StaticResource ResultIconButton}"
                                    Command="{Binding DownloadResultCommand}"
                                    ToolTip="Download the selected result into the library"/>
                            <Button Content="&#x2193;&#x25B6;" Style="{StaticResource ResultIconButton}"
                                    Command="{Binding DownloadAndPlayResultCommand}"
                                    ToolTip="Download the selected result and play the stream while it downloads"/>
                            <Button Content="+" Style="{StaticResource ResultIconButton}"
                                    Command="{Binding AddResultToPlaylistCommand}"
                                    ToolTip="Add the selected result to the selected playlist"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.Title}"
                                   Style="{StaticResource MetaText}" HorizontalAlignment="Right"
                                   Margin="8,0,2,0"/>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                          ToolTip="Drag to resize"/>

            <!-- ============ Playlist ============ -->
            <Border Grid.Column="2" Style="{StaticResource PaneCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section head + counts + cache age + refresh.
                         The rail is the channel's playlists when connected, so it
                         also says how old that list is: a dim "updated N min ago"
                         is stale data made visible instead of a blocking spinner. -->
                    <Grid Grid.Row="0" Height="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PLAYLIST" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CountsText}" FontFamily="Consolas" FontSize="10.5"
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CountsText}"/>
                        <TextBlock Grid.Column="2" Text="{Binding RemoteStampText}" FontSize="9"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Opacity="{Binding RemoteStampOpacity}"
                                   ToolTip="When this playlist list was read from YouTube. The rail keeps the last-known list (5 min) instead of spending quota on every tab switch; ↻ forces a fresh read.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsYouTubeConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="3" Content="&#x21BB;" FontSize="10" Padding="4,0" Height="14"
                                MinWidth="18" Margin="6,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RefreshRemoteCommand}"
                                ToolTip="{Binding ImportMyPlaylistsHint}"
                                Background="Transparent" BorderBrush="Transparent"
                                Foreground="{StaticResource TextDimBrush}"
                                Visibility="{Binding IsYouTubeConnected,
                                             Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <!-- Playlist picker + filter + manage disclosure -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" FontSize="11" VerticalContentAlignment="Center"
                                  x:Name="PlaylistPicker"
                                  AutomationProperties.Name="YouTube playlist"
                                  HorizontalContentAlignment="Stretch"
                                  ItemsSource="{Binding RailView}"
                                  IsSynchronizedWithCurrentItem="False"
                                  SelectedItem="{Binding SelectedRail}"
                                  ToolTip="{Binding SelectedRail.ToolTip}"
                                  MaxDropDownHeight="420">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPlaylists}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <!-- Two groups, in this order: the playlists on the
                                 signed-in channel (YouTube's order), then the local
                                 imports the channel does not have. Nothing is hidden:
                                 a list that is only here stays here, just labelled. -->
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="9"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       Margin="2,5,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ToolTip}"/>
                                        <!-- Item count for a channel playlist, or the
                                             source marker for a local one. -->
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                                   FontSize="9" Margin="6,0,0,0"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Empty rail: the picker collapses, this hint takes its cell. -->
                        <TextBlock Grid.Column="0"
                                   FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Text"
                                            Value="No playlists yet &#x2014; Connect YouTube, or import a playlist URL"/>
                                    <Setter Property="ToolTip"
                                            Value="Connecting YouTube lists your channel's playlists here. You can also paste a playlist URL in the import strip, or create a local one with + in the manage strip (&#x22EF;)."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPlaylists}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsYouTubeConnected}" Value="False">
                                            <Setter Property="Text"
                                                    Value="Not connected &#x2014; local imports only. Connect YouTube to list your playlists"/>
                                            <Setter Property="ToolTip"
                                                    Value="With no Google account this rail lists only the playlists imported into JockeyBox. Connect YouTube to see your channel's own playlists and to write to them."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Write status of the selected rail row: only a playlist that
                             also exists on the signed-in channel can receive writes. -->
                        <TextBlock Grid.Column="1" FontSize="9" Margin="8,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="True">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="Local only"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Setter Property="ToolTip"
                                            Value="This playlist lives only in JockeyBox. Add to YouTube / Remove from YouTube need one that also exists on your channel - create it with + Remote, or Import my playlists."/>
                                    <Style.Triggers>
                                        <!-- No rail row selected: no write status to report. -->
                                        <DataTrigger Binding="{Binding SelectedPlaylist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelectedPlaylistRemote}" Value="True">
                                            <Setter Property="Text" Value="On YouTube &#x2713;"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                            <Setter Property="ToolTip"
                                                    Value="This playlist exists on your YouTube channel, so Add to YouTube and Remove from YouTube write straight to it."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="FILTER" Style="{StaticResource SectionLabel}"
                                   Margin="8,0,4,0"/>
                        <TextBox Grid.Column="3" Width="88" FontSize="11"
                                 x:Name="PlaylistFilterBox"
                                 AutomationProperties.Name="Filter playlist tracks"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding PlaylistFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter playlist tracks by title or artist"/>
                        <ToggleButton Grid.Column="4" x:Name="ManageToggle" Content="&#x22EF;"
                                      Style="{StaticResource StripToggle}" Margin="6,0,0,0"
                                      ToolTip="New, rename, delete, download - these make and edit local playlists; + Remote creates one on YouTube"/>
                    </Grid>

                    <!-- Playlist manage strip, hidden until asked for -->
                    <Grid Grid.Row="2" Height="22" Margin="0,6,0,0"
                          Visibility="{Binding IsChecked, ElementName=ManageToggle,
                                       Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="22" MinHeight="22" Padding="6,2" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Name for a new playlist, or the new name when renaming"/>
                        <Button Grid.Column="1" Content="+" Style="{StaticResource IconButton}" Height="22"
                                Width="22" Margin="5,0,0,0"
                                Command="{Binding CreatePlaylistCommand}" ToolTip="Create playlist"/>
                        <Button Grid.Column="2" Content="&#x270E;" Style="{StaticResource PlaylistIconButton}"
                                Height="22" Width="22" Margin="4,0,0,0"
                                Command="{Binding RenamePlaylistCommand}"
                                ToolTip="Rename the selected playlist"/>
                        <Button Grid.Column="3" Content="&#x2715;" Style="{StaticResource PlaylistIconButton}"
                                Height="22" Width="22" Margin="4,0,0,0"
                                Command="{Binding RemovePlaylistCommand}"
                                ToolTip="Delete the selected playlist"/>
                        <Button Grid.Column="4" Content="&#x2B07;" Style="{StaticResource PlaylistIconButton}"
                                Height="22" Width="22" Margin="4,0,0,0"
                                Command="{Binding DownloadPlaylistCommand}"
                                ToolTip="Download every track in this playlist that is not in the library yet"/>
                    </Grid>

                    <ListView Grid.Row="3" x:Name="PlaylistTracksList" ItemsSource="{Binding PlaylistTracksView}"
                              SelectedItem="{Binding SelectedPlaylistTrack}"
                              ItemContainerStyle="{StaticResource TrackRow}"
                              Background="Transparent" BorderThickness="0"
                              Margin="0,4,0,0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              MouseDoubleClick="OnPlaylistTrackDoubleClick"
                              PreviewMouseRightButtonDown="OnPlaylistTrackRightClick"
                              ContextMenuOpening="OnPlaylistContextMenuOpening"
                              KeyDown="OnPlaylistTrackKeyDown">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Play"
                                          Command="{Binding PlacementTarget.DataContext.PlayPlaylistTrackCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Add to queue"
                                          Command="{Binding PlacementTarget.DataContext.AddToQueueCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!-- Filled on open by OnPlaylistContextMenuOpening: one row per
                                     internal playlist plus "New playlist…" (RemotePlaylistTargets). -->
                                <MenuItem x:Name="AddToPlaylistMenu" Header="Add to playlist"
                                          AutomationProperties.Name="Add to playlist"/>
                                <MenuItem Header="Preview (stream)"
                                          Command="{Binding PlacementTarget.DataContext.PreviewPlaylistTrackCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Download"
                                          Command="{Binding PlacementTarget.DataContext.DownloadPlaylistTrackCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Download &amp; play"
                                          Command="{Binding PlacementTarget.DataContext.DownloadAndPlayPlaylistTrackCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Separate karaoke"
                                          AutomationProperties.Name="Separate karaoke"
                                          Command="{Binding PlacementTarget.DataContext.SeparateSelectedKaraokeCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Show in Explorer"
                                          AutomationProperties.Name="Show in Explorer"
                                          Command="{Binding PlacementTarget.DataContext.RevealSelectedFileCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Copy link"
                                          AutomationProperties.Name="Copy link"
                                          Command="{Binding PlacementTarget.DataContext.CopySelectedLinkCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Open on YouTube"
                                          AutomationProperties.Name="Open on YouTube"
                                          Command="{Binding PlacementTarget.DataContext.OpenPlaylistTrackOnYouTubeCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Remove from playlist"
                                          Command="{Binding PlacementTarget.DataContext.RemoveTrackCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Add to YouTube"
                                          Command="{Binding PlacementTarget.DataContext.AddSelectedToYouTubeCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Remove from YouTube"
                                          Command="{Binding PlacementTarget.DataContext.RemoveFromYouTubeCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}"/>
                                        <!-- Karaoke availability from the scan index: the same
                                             text the local library's column shows, one
                                             dictionary hit per row (LocalEntry). -->
                                        <TextBlock Text="{Binding KaraokeStatus}" FontSize="10"
                                                   Margin="0,1,0,0"
                                                   Foreground="{StaticResource AccentABrush}"
                                                   AutomationProperties.Name="{Binding KaraokeAutomationName}"
                                                   ToolTip="Karaoke version: same state as the library column">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LocalEntry}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Artist}"
                                               FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="8,0,0,0"
                                               ToolTip="{Binding Artist}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                               FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" Margin="6,0,4,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource PreviewButton}"
                                            Margin="0,0,2,0"
                                            Command="{Binding DataContext.PreviewPlaylistTrackCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding StateGlyph}" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="InLibrary">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Queued">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty playlist hint, sits over the (empty) list -->
                    <TextBlock Grid.Row="3" Margin="0,4,0,0"
                               Text="No tracks here yet. Add a result with +."
                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PlaylistTracksView.IsEmpty}" Value="True"/>
                                            <!-- With no rail row there is no "here" yet; the
                                                 picker's own hint says what to do instead. -->
                                            <Condition Binding="{Binding HasPlaylists}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Track actions, inline with the selected track -->
                    <Grid Grid.Row="4" Height="22" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="&#x25B6;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding PlayPlaylistTrackCommand}"
                                    ToolTip="Play the selected track"/>
                            <Button Content="&#x2B07;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding DownloadPlaylistTrackCommand}"
                                    ToolTip="Download the selected track"/>
                            <Button Content="&#x2715;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding RemoveTrackCommand}"
                                    ToolTip="Remove the selected track from the playlist"/>
                            <Button Content="&#x2191;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding MoveTrackUpCommand}"
                                    ToolTip="Move the selected track up"/>
                            <Button Content="&#x2193;" Style="{StaticResource TrackIconButton}"
                                    Command="{Binding MoveTrackDownCommand}"
                                    ToolTip="Move the selected track down"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPlaylistTrack.DisplayName}"
                                   Style="{StaticResource MetaText}" HorizontalAlignment="Right"
                                   Margin="8,0,2,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Status ============ -->
        <Grid Grid.Row="2" Height="16" Margin="2,4,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="10.5"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" ToolTip="{Binding StatusText}"/>
            <!-- The account label used to sit in the toolbar and cost it a wrapped
                 line; down here it is the same information for 0 px. -->
            <TextBlock Grid.Column="1" Text="{Binding YouTubeAccountText}" FontSize="10.5"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="220" Margin="8,0,0,0"
                       ToolTip="The Google account YouTube writes will use. Credentials live in %APPDATA%\JockeyBox\youtube-oauth.json.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsYouTubeConnected}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="2" Text="YouTube&#x2026;" FontSize="10.5"
                       Foreground="{StaticResource AccentABrush}" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       ToolTip="A YouTube Data API request is running"
                       Visibility="{Binding IsYouTubeBusy, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Grid.Column="3" Text="Working&#x2026;" FontSize="10.5"
                       Foreground="{StaticResource AccentABrush}" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</UserControl>
