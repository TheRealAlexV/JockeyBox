<UserControl x:Class="JockeyBox.Views.RoutingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- The routing matrix: one row per bus the engine lets the UI point somewhere.
         It was a flyout section, 400 px wide; in the dock it is a panel with a
         caption, a splitter and a pop-out like every other surface.

         An independent XAML root: every key it names resolves from app scope
         (Themes/Dark.xaml) plus whatever it merges itself. It merges nothing. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="10,0,10,10" Focusable="False">
        <StackPanel>
            <TextBlock Text="WHERE EACH BUS PLAYS" FontSize="9" FontWeight="Bold"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="DECK A" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
            <ComboBox Margin="0,3,0,10" MinHeight="24" FontSize="10" Padding="6,0"
                      ItemsSource="{Binding DeckA.Devices}"
                      ItemTemplate="{StaticResource DeviceChoiceRow}"
                      SelectedItem="{Binding DeckA.SelectedDevice, Mode=TwoWay}"
                      AutomationProperties.Name="Deck A output device"
                      ToolTip="Where deck A plays. The same value as Deck A Output in Settings."/>
            <TextBlock Text="DECK B" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
            <ComboBox Margin="0,3,0,10" MinHeight="24" FontSize="10" Padding="6,0"
                      ItemsSource="{Binding DeckB.Devices}"
                      ItemTemplate="{StaticResource DeviceChoiceRow}"
                      SelectedItem="{Binding DeckB.SelectedDevice, Mode=TwoWay}"
                      AutomationProperties.Name="Deck B output device"
                      ToolTip="Where deck B plays. The same value as Karaoke Aid Output in Settings."/>
            <TextBlock Text="MONITOR" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
            <ComboBox Margin="0,3,0,0" MinHeight="24" FontSize="10" Padding="6,0"
                      ItemsSource="{Binding MonitorDeviceChoices}"
                      ItemTemplate="{StaticResource DeviceChoiceRow}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedMonitorDeviceId, Mode=TwoWay}"
                      AutomationProperties.Name="Monitor output device"
                      ToolTip="Where MON plays. The same value as Monitoring device output in Settings."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
