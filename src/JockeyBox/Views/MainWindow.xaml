<Window x:Class="JockeyBox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JockeyBox.ViewModels"
        xmlns:lib="clr-namespace:JockeyBox.Library"
        xmlns:views="clr-namespace:JockeyBox.Views"
        xmlns:activity="clr-namespace:JockeyBox.Activity"
        Title="JockeyBox" Height="900" Width="1400" MinHeight="640" MinWidth="1000"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding AddToQueueCommand}"/>
        <KeyBinding Key="Right" Modifiers="Control+Shift" Command="{Binding PlayNextCommand}"/>
        <KeyBinding Key="Left" Modifiers="Control+Shift" Command="{Binding PlayPreviousCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
        <!-- Shared design for track rows, the right-click menu and the
             filter/sort strip. Referenced by SpotifyView and YouTubeView too,
             so the three lists cannot drift apart again. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Views/Shared/TrackRows.xaml"/>
            <ResourceDictionary Source="/Views/Shared/TrackMenu.xaml"/>
            <ResourceDictionary Source="/Views/Shared/StatusConsole.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <views:ActivityElapsedConverter x:Key="ActivityElapsed"/>

        <!-- Per-deck transport buttons: smaller and dimmer than the main row,
             which stays the primary surface for the active deck. -->
        <Style x:Key="DeckSecondaryButton" TargetType="Button"
               BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======== Deck card (shared by both decks; accent injected per-deck) ========
             A deck is a self-contained player: its own playhead, seek, volume,
             output device and waveform, plus the karaoke sub-stem bar when the
             loaded track has a karaoke partner. -->
        <DataTemplate x:Key="DeckCardTemplate" DataType="{x:Type vm:DeckViewModel}">
            <Border Style="{StaticResource Card}" Padding="12,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="Auto"/>   <!-- track -->
                        <RowDefinition Height="Auto"/>   <!-- output device -->
                        <RowDefinition Height="Auto"/>   <!-- volume -->
                        <RowDefinition Height="Auto"/>   <!-- tempo / BPM -->
                        <RowDefinition Height="Auto"/>   <!-- transport + seek -->
                        <RowDefinition Height="Auto"/>   <!-- karaoke sub-stem -->
                    </Grid.RowDefinitions>

                    <!-- Header: deck name, active marker, local time readout -->
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource DeckAccent}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                Command="{Binding ActivateCommand}"
                                ToolTip="Route the shared seek bar and the lyrics clock to this deck">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="SET ACTIVE"/>
                                    <Setter Property="FontSize" Value="9"/>
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Content" Value="ACTIVE"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DeckAccent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DeckAccent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeReadout}"
                                   HorizontalAlignment="Right" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="8,0"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </DockPanel>

                    <!-- Track info -->
                    <StackPanel Grid.Row="1" Margin="0,5,0,6">
                        <TextBlock Text="{Binding TrackTitle}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TrackDetail}" Foreground="{StaticResource TextDimBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Output device -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,5">
                        <TextBlock Text="OUTPUT" Width="60" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"/>
                    </DockPanel>

                    <!-- Volume -->
                    <DockPanel Grid.Row="3">
                        <TextBlock Text="VOL" Width="60" VerticalAlignment="Center" FontSize="10"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <Slider Minimum="0" Maximum="1.2"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding Volume}"/>
                    </DockPanel>

                    <!-- Tempo / BPM (plan item 5): a slim, centre-detented pitch fader
                         with its auto-centre button and the live readout. The fader is
                         fixed at +/-16 visually; the view model clamps to the configured
                         range. -->
                    <Grid Grid.Row="4" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TEMPO" Width="60" FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RepeatButton Width="20" Height="18" FontSize="10"
                                          Style="{StaticResource NudgeButton}"
                                          Delay="400" Interval="120"
                                          Content="&#x2212;"
                                          Command="{Binding NudgeTempoCommand}" CommandParameter="-0.5"
                                          ToolTip="Slow down by 0.5%"/>
                            <Button Width="22" Height="18" Margin="3,0" Padding="0"
                                    FontSize="9" FontWeight="Bold" Content="0"
                                    Command="{Binding CenterTempoCommand}"
                                    IsEnabled="{Binding IsTempoModified}"
                                    ToolTip="Auto-centre: back to the track's original tempo">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTempoModified}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DeckAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource DeckAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <RepeatButton Width="20" Height="18" FontSize="10"
                                          Style="{StaticResource NudgeButton}"
                                          Delay="400" Interval="120"
                                          Content="+"
                                          Command="{Binding NudgeTempoCommand}" CommandParameter="0.5"
                                          ToolTip="Speed up by 0.5%"/>
                        </StackPanel>

                        <Grid Grid.Column="2" Margin="8,0,10,0" VerticalAlignment="Center">
                            <!-- Centre detent: 0% is the middle of the fader. Drawn
                                 behind the thumb so a centred fader still reads as a
                                 thumb sitting on a mark, not a line through it. -->
                            <Border Width="1" Height="9" HorizontalAlignment="Center"
                                    Background="{StaticResource TextDimBrush}"
                                    IsHitTestVisible="False"/>
                            <Slider Minimum="-16" Maximum="16"
                                    SmallChange="0.1" LargeChange="1"
                                    Value="{Binding TempoPercent, Mode=TwoWay}"
                                    ToolTip="Tempo: -16% (slower) to +16% (faster), centre = original"/>
                        </Grid>

                        <TextBlock Grid.Column="3" Text="{Binding BpmText}" FontFamily="Consolas"
                                   FontSize="17" FontWeight="Bold" MinWidth="96"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   ToolTip="BPM the deck is producing right now"/>

                        <TextBlock Grid.Column="4" Text="{Binding TempoRatio, StringFormat={}{0:F3}}"
                                   FontFamily="Consolas" FontSize="11" Width="44"
                                   Margin="8,0,0,0" TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   ToolTip="Playback ratio (1.000 = original tempo)">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTempoModified}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Transport: this deck's own controls, secondary to the main
                         row. Any click inside the card activates the deck
                         (OnDeckInteract in the code-behind), so these buttons
                         never move a deck the user is not looking at. -->
                    <DockPanel Grid.Row="5" Margin="0,2,0,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23EE;"
                                    ToolTip="Previous track on this deck"
                                    Command="{Binding DataContext.PreviousTrackForDeckCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23EA;"
                                    ToolTip="Back 10 seconds on this deck"
                                    Command="{Binding SkipBackCommand}"/>
                            <Button Style="{StaticResource DeckSecondaryButton}" Content="{Binding PlayGlyph}"
                                    ToolTip="Play or pause this deck"
                                    Command="{Binding PlayPauseCommand}"/>
                            <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23E9;"
                                    ToolTip="Forward 10 seconds on this deck"
                                    Command="{Binding SkipForwardCommand}"/>
                            <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23F9;"
                                    ToolTip="Stop this deck"
                                    Command="{Binding StopCommand}"/>
                            <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23ED;"
                                    ToolTip="Next track on this deck"
                                    Command="{Binding DataContext.NextTrackForDeckCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                        <Slider Margin="8,0,0,0" VerticalAlignment="Center"
                                Minimum="0" Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                PreviewMouseLeftButtonDown="OnDeckSeekStart"
                                PreviewMouseLeftButtonUp="OnDeckSeekEnd"
                                LostMouseCapture="OnDeckSeekLostCapture"/>
                    </DockPanel>

                    <!-- Karaoke sub-stem bar: gain, delay trim and seek. Its waveform
                         now lives in the shared stacked strip below the deck row. -->
                    <Border Grid.Row="6" Margin="0,6,0,0" Padding="0,5,0,0"
                            BorderBrush="{DynamicResource DeckAccent}" BorderThickness="0,1,0,0"
                            Visibility="{Binding HasKaraoke, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock Text="KARAOKE" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource DeckAccent}"
                                           VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Left" Width="26" Height="20" Margin="8,0,0,0"
                                        Padding="0" FontSize="11"
                                        Style="{StaticResource TransportButton}"
                                        Content="{Binding PlayGlyph}"
                                        Command="{Binding PlayPauseCommand}"
                                        ToolTip="Play/pause this deck (the karaoke stem follows the deck playhead)"/>
                                <TextBlock Text="GAIN" FontSize="9" Margin="10,0,6,0"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider DockPanel.Dock="Left" Width="90" VerticalAlignment="Center"
                                        Minimum="0" Maximum="1"
                                        Value="{Binding KaraokeGain}"
                                        ToolTip="0 = original only, 0.5 = both, 1 = karaoke only"/>
                                <TextBlock Text="DELAY MS" FontSize="9" Margin="12,0,6,0"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"/>
                                <RepeatButton DockPanel.Dock="Left" Width="20" Height="18" FontSize="10"
                                              Style="{StaticResource NudgeButton}"
                                              Delay="400" Interval="150"
                                              Command="{Binding NudgeDelayCommand}" CommandParameter="-5"/>
                                <TextBox DockPanel.Dock="Left" Width="56" Margin="3,0"
                                         TextAlignment="Center" FontSize="11"
                                         MinHeight="24" Padding="6,3"
                                         Text="{Binding DelayMs, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>
                                <RepeatButton DockPanel.Dock="Left" Width="20" Height="18" FontSize="10"
                                              Style="{StaticResource NudgeButton}"
                                              Delay="400" Interval="150"
                                              Command="{Binding NudgeDelayCommand}" CommandParameter="5"/>
                            </DockPanel>

                            <!-- Karaoke seek: bound to the deck playhead, so both stems move together. -->
                            <Slider Grid.Row="1" Margin="0,3,0,0" VerticalAlignment="Center"
                                    Minimum="0" Maximum="{Binding DurationSeconds}"
                                    Value="{Binding PositionSeconds, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="OnDeckSeekStart"
                                    PreviewMouseLeftButtonUp="OnDeckSeekEnd"
                                    LostMouseCapture="OnDeckSeekLostCapture"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ======== Browser tabs: dim uppercase headers, accent underline ======== -->
        <Style x:Key="BrowserTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" Padding="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0" ContentSource="Header"
                                                  Margin="0,0,0,6"
                                                  TextBlock.FontSize="11" TextBlock.FontWeight="Bold"/>
                                <Border x:Name="underline" Grid.Row="1" Height="2"
                                        Background="Transparent" CornerRadius="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="underline" Property="Background"
                                        Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== Horizontal splitter between the deck block and the browser ========
             8px hit area, one hairline, a short centred grip. Same family as the
             vertical splitters inside the source tab panes. -->
        <Style x:Key="RowSplitter" TargetType="GridSplitter">
            <Setter Property="Height" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Height="1" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                            <Border x:Name="grip" Width="34" Height="2" CornerRadius="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#3A4150"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background"
                                        Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== Queue row: same dense line as the source track tables ========
             Played rows stay in the list, faded, and the row playing now gets the
             accent bar on the left. -->
        <Style x:Key="QueueRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <!-- Context menu acts on the clicked row, so it carries the row's owner
                 (the queue VM) in Tag: a ContextMenu lives outside the ListView's
                 visual tree, so AncestorType=ListView finds nothing from inside it. -->
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Send to deck A"
                                  Command="{Binding PlacementTarget.Tag.SendToDeckACommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Send to deck B"
                                  Command="{Binding PlacementTarget.Tag.SendToDeckBCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Play now"
                                  Command="{Binding PlacementTarget.Tag.PlayNowFromQueueCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Remove from queue"
                                  Command="{Binding PlacementTarget.Tag.RemoveFromQueueCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,0"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" MinHeight="26">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlayed}" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource BrowserTab}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Margin="4,0,0,8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="0,0,0,0"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ======== Soundboard pad tile ========
             Same card idiom as the rest of the window: dark panel, 1 px border,
             6 px radius. While the pad is sounding the border takes the deck-A
             accent and a soft glow, so the playing pad reads at a glance from
             across the booth. -->
        <DataTemplate x:Key="SoundboardPadTile">
            <Border Width="128" Height="112" Margin="0,0,8,8" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                <Setter Property="Background" Value="#1B2733"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00C8FF" BlurRadius="16"
                                                          ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="8,7,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Width="16" Height="16" Padding="0"
                                FontSize="10" Margin="4,0,0,0" VerticalAlignment="Top"
                                Foreground="{StaticResource TextDimBrush}"
                                Content="&#x00D7;"
                                ToolTip="Remove this sound"
                                Command="{Binding DataContext.RemoveCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                        <!-- Bind: captures the next chord for this pad. While
                             capturing the glyph turns into a dot so the tile says
                             "waiting for keys" without a dialog. -->
                        <Button DockPanel.Dock="Right" Width="16" Height="16" Padding="0"
                                FontSize="9" Margin="0,0,2,0" VerticalAlignment="Top"
                                Command="{Binding DataContext.BindCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Bind a hotkey (click, then press the keys)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="&#x2328;"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Content" Value="&#x25CF;"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- A real stop, only while the pad sounds: the big button
                             below always means "play" and never changes meaning. -->
                        <Button DockPanel.Dock="Right" Width="16" Height="16" Padding="0"
                                FontSize="8" Margin="0,0,2,0" VerticalAlignment="Top"
                                Foreground="{StaticResource AccentABrush}"
                                Content="&#x25A0;"
                                ToolTip="Stop this sound"
                                Command="{Binding DataContext.StopCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Name}"/>
                    </DockPanel>

                    <!-- Hotkey, or a quiet "unbound" so the row never jumps.
                         Clicking the line starts a capture, same as the ⌨ button. -->
                    <TextBlock Grid.Row="1" Margin="0,2,0,0" FontSize="9" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis" Cursor="Hand"
                               ToolTip="Click to bind a key combination">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.BindCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"/>
                        </TextBlock.InputBindings>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Hotkey, TargetNullValue=unbound}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hotkey}" Value="">
                                        <Setter Property="Text" Value="unbound"/>
                                        <Setter Property="Foreground" Value="#5A6270"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Hotkey}" Value="{x:Null}">
                                        <Setter Property="Text" Value="unbound"/>
                                        <Setter Property="Foreground" Value="#5A6270"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Text" Value="press keys…"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Text" Value="{Binding Status}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Play affordance. It always reads as play; the playing state
                         shows on the tile border, the accent glyph and the stop
                         button above. Firing again restarts from the top. -->
                    <Grid Grid.Row="2" Margin="0,6,0,4">
                        <Button Padding="0" FontSize="16"
                                Command="{Binding DataContext.PlayCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Play this sound (fires again from the top)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="&#x25B6;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                        </DataTrigger>
                                        <!-- A downloading pad says so instead of pretending
                                             it can be fired. -->
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Content" Value="&#x2026;"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ProgressBar Height="3" VerticalAlignment="Bottom" Margin="2,0,2,-2"
                                     Minimum="0" Maximum="1" Value="{Binding Progress}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>

                    <Slider Grid.Row="3" Minimum="0" Maximum="1" SmallChange="0.01"
                            Value="{Binding Volume, Mode=TwoWay}"
                            ToolTip="Level of this sound"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ======== Soundboard expander ========
             Header is a toggle on the left and its actions on the right, so
             STOP ALL never doubles as "collapse". -->
        <Style x:Key="SoundboardExpander" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0" Focusable="False" Cursor="Hand"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="hd" Background="Transparent"
                                                    CornerRadius="8" Padding="12,7">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hd" Property="Background"
                                                            Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Chevron follows the expander's own state, so
                                             it needs no template trigger and no name
                                             crossing into the ToggleButton's content. -->
                                        <TextBlock FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#x25B8;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsExpanded,
                                                                         RelativeSource={RelativeSource AncestorType=Expander}}">
                                                            <Setter Property="Text" Value="&#x25BE;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="SOUNDBOARD" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="10"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Button Content="+ ADD SLOT" FontSize="9" Padding="8,4"
                                            Margin="0,0,6,0"
                                            Command="{Binding AddSlotCommand}"
                                            ToolTip="Add an empty pad"/>
                                    <Button Content="STOP ALL" FontSize="9" Padding="8,4"
                                            Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding StopAllCommand}"
                                            ToolTip="Silence every pad"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="body" Grid.Row="1" Padding="12,0,12,10"
                                    Visibility="Collapsed">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- decks + waveforms + transport (never clipped) -->
            <RowDefinition Height="8"/>      <!-- splitter: deck block <-> browser -->
            <RowDefinition Height="*" MinHeight="150"/>   <!-- browser + lyrics -->
            <RowDefinition Height="Auto"/>   <!-- status console: jobs, downloads, log -->
            <RowDefinition Height="Auto"/>   <!-- soundboard -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="JOCKEY" FontSize="20" FontWeight="Black"/>
            <TextBlock Text="BOX" FontSize="20" FontWeight="Black" Foreground="{StaticResource AccentABrush}"/>
            <TextBlock Text="{Binding LoadedTrackTitle}" Margin="24,0,0,0" FontSize="14"
                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <Button DockPanel.Dock="Right" Content="&#x2699; Settings" HorizontalAlignment="Right"
                    Click="OnSettingsClick"/>
        </DockPanel>

        <!-- ================= Deck block: decks / waveforms / crossfader / transport =================
             The deck cards hold controls only: the two waveforms live in one shared
             full-width strip directly below them (A over B), so the peaks read at
             the full width of the window and the two decks line up beat for beat.
             Every row here is Auto: the cards keep their natural height and the
             splitter below balances the whole block against the browser. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- deck cards -->
                <RowDefinition Height="Auto"/>   <!-- stacked waveforms -->
                <RowDefinition Height="Auto"/>   <!-- crossfader -->
                <RowDefinition Height="Auto"/>   <!-- transport -->
            </Grid.RowDefinitions>

        <!-- ================= Decks ================= -->
        <Grid Grid.Row="0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding DeckA}"
                            PreviewMouseLeftButtonDown="OnDeckInteract"
                            ContentTemplate="{StaticResource DeckCardTemplate}">
                <ContentControl.Resources>
                    <SolidColorBrush x:Key="DeckAccent" Color="#00C8FF"/>
                </ContentControl.Resources>
            </ContentControl>

            <ContentControl Grid.Column="2" Content="{Binding DeckB}"
                            PreviewMouseLeftButtonDown="OnDeckInteract"
                            ContentTemplate="{StaticResource DeckCardTemplate}">
                <ContentControl.Resources>
                    <SolidColorBrush x:Key="DeckAccent" Color="#FF3DAD"/>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- ================= Stacked waveforms =================
             One shared strip: deck A's waveform on top, deck B's directly under it,
             each full width with its own playhead and its karaoke sub-stem tucked
             beneath it. The canvases are the same control the deck cards used to
             hold - same Tag ("primary"/"karaoke"), same Loaded/SizeChanged handlers -
             so MainWindow.xaml.cs draws them exactly as before; only their parent
             and therefore their width changed. -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,4" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- deck A -->
                    <RowDefinition Height="Auto"/>   <!-- deck B -->
                </Grid.RowDefinitions>

                <!-- ===== Deck A ===== -->
                <Grid Grid.Row="0" DataContext="{Binding DeckA}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- Quiet bed so the peaks and the beat ticks read against
                             the panel instead of floating on it. -->
                        <Border CornerRadius="3" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10151D" Offset="0"/>
                                    <GradientStop Color="#0A0C10" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas x:Name="WaveformA" Height="30" ClipToBounds="True" Tag="primary"
                                Loaded="OnDeckWaveformLoaded"
                                SizeChanged="OnDeckWaveformSizeChanged"/>
                        <TextBlock Text="A" Margin="7,2,0,0" FontSize="11" FontWeight="Black"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Foreground="{StaticResource AccentABrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Bpm, StringFormat={}{0:0}}"
                                   Margin="0,3,7,0" FontSize="9" FontFamily="Consolas"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextDimBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- No tempo analysis, no number: the card's
                                             BPM readout already says "BPM —". -->
                                        <DataTrigger Binding="{Binding Bpm}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Canvas Grid.Row="1" x:Name="KaraokeWaveformA" Height="12" Margin="0,2,0,0"
                            ClipToBounds="True" Tag="karaoke"
                            Visibility="{Binding HasKaraoke, Converter={StaticResource BoolToVisibility}}"
                            Loaded="OnDeckWaveformLoaded"
                            SizeChanged="OnDeckWaveformSizeChanged"/>
                </Grid>

                <!-- ===== Deck B ===== -->
                <Grid Grid.Row="1" DataContext="{Binding DeckB}" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border CornerRadius="3" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10151D" Offset="0"/>
                                    <GradientStop Color="#0A0C10" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas x:Name="WaveformB" Height="30" ClipToBounds="True" Tag="primary"
                                Loaded="OnDeckWaveformLoaded"
                                SizeChanged="OnDeckWaveformSizeChanged"/>
                        <TextBlock Text="B" Margin="7,2,0,0" FontSize="11" FontWeight="Black"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Foreground="{StaticResource AccentBBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Bpm, StringFormat={}{0:0}}"
                                   Margin="0,3,7,0" FontSize="9" FontFamily="Consolas"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextDimBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Bpm}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Canvas Grid.Row="1" x:Name="KaraokeWaveformB" Height="12" Margin="0,2,0,0"
                            ClipToBounds="True" Tag="karaoke"
                            Visibility="{Binding HasKaraoke, Converter={StaticResource BoolToVisibility}}"
                            Loaded="OnDeckWaveformLoaded"
                            SizeChanged="OnDeckWaveformSizeChanged"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= Crossfader =================
             One fader, equal-power curve: centre plays both decks at -3 dB, the
             ends isolate A and B. Per-deck volume still multiplies in.
             The snap buttons write the same bound property a drag does, so the
             fader moves (and a running crossfade ramp is cancelled) exactly as if
             a hand had grabbed it. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,2" Margin="0,6,0,0">
            <Border.Resources>
                <Style x:Key="CrossfaderSnapButton" TargetType="Button"
                       BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FontSize" Value="9"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>

                <!-- Mic strip toggles: same 18 px height as the master reset
                     button, lit with the accent colour while engaged so MON and
                     MUTE read at a glance from across the booth. -->
                <Style x:Key="MicToggle" TargetType="ToggleButton">
                    <Setter Property="Height" Value="18"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FontSize" Value="9"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background"
                                                Value="{StaticResource HoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background"
                                                Value="{StaticResource AccentABrush}"/>
                                        <Setter Property="Foreground" Value="#08131A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Equal side columns keep the fader exactly centred. -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Transition status: live state, not a control. Collapsed
                     whenever no transition is running. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsTransitioning, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                             Fill="{StaticResource AccentABrush}"/>
                    <TextBlock Text="{Binding TransitionText}" FontSize="10"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"
                               ToolTip="{Binding TransitionText}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentABrush}" Margin="0,0,10,0"/>
                        <Slider x:Name="CrossfaderSlider" Width="340" VerticalAlignment="Center"
                                Minimum="0" Maximum="1"
                                SmallChange="0.01" LargeChange="0.1"
                                Value="{Binding Crossfader, Mode=TwoWay}"
                                ToolTip="Crossfader: left = deck A, centre = both, right = deck B"/>
                        <TextBlock Text="B" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBBrush}" Margin="10,0,0,0"/>
                    </DockPanel>

                    <!-- Snaps on the fader's own 340 px track: A under its left end,
                         Centre under the middle, B under its right end. Keeping the
                         strip the slider's width is what stops the buttons from
                         widening the card and reflowing the fader. -->
                    <Grid Width="340" Margin="0,2,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Left"
                                Style="{StaticResource CrossfaderSnapButton}"
                                Content="A" Foreground="{StaticResource AccentABrush}"
                                Command="{Binding SnapCrossfaderACommand}"
                                AutomationProperties.Name="Crossfader A"
                                ToolTip="Deck A"/>
                        <Button Grid.Column="1" HorizontalAlignment="Center"
                                Style="{StaticResource CrossfaderSnapButton}"
                                Content="C"
                                Command="{Binding SnapCrossfaderCentreCommand}"
                                AutomationProperties.Name="Crossfader Centre"
                                ToolTip="Centre"/>
                        <Button Grid.Column="2" HorizontalAlignment="Right"
                                Style="{StaticResource CrossfaderSnapButton}"
                                Content="B" Foreground="{StaticResource AccentBBrush}"
                                Command="{Binding SnapCrossfaderBCommand}"
                                AutomationProperties.Name="Crossfader B"
                                ToolTip="Deck B"/>
                    </Grid>
                </StackPanel>

                <!-- Master level: deliberately smaller than the fader it sits
                     beside, because the crossfader is still the primary control. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- Talk-over mic: app-domain gain (the Windows recording
                         level is never touched), a voice-only monitor send that
                         is off by default (open speakers + live mic = feedback)
                         and a mute that closes the voice without closing the
                         device. Fits on the master row, so the 1400x900 stack
                         does not grow a row. -->
                    <!-- Karaoke mode: Main plays the karaoke stem, the Karaoke aid
                         bus plays the original vocal stem (operator headphones).
                         Same flag the Settings dialog shows, so either one flips
                         the other at the next bind. -->
                    <ToggleButton Style="{StaticResource MicToggle}" Width="62" Content="KARAOKE"
                                  Margin="0,0,10,0"
                                  IsChecked="{Binding KaraokeModeEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Karaoke mode"
                                  ToolTip="Play the karaoke stem on Main; the original goes to the Karaoke aid output"/>

                    <TextBlock Text="{Binding MicStripLabel}" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0"
                               Foreground="{StaticResource TextDimBrush}"
                               ToolTip="{Binding MicStatusText}"/>
                    <Slider x:Name="MicLevelSlider" Width="90" VerticalAlignment="Center"
                            Minimum="0" Maximum="2"
                            SmallChange="0.01" LargeChange="0.1"
                            Value="{Binding MicLevel, Mode=TwoWay}"
                            AutomationProperties.Name="Microphone level"
                            ToolTip="Microphone level: an app gain, 100% = unity, up to 200%. The Windows recording level is not changed."/>
                    <TextBlock Text="{Binding MicLevel, StringFormat={}{0:0%}}"
                               FontFamily="Consolas" FontSize="10" Width="38"
                               Margin="7,0,4,0" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}"
                               ToolTip="Microphone gain"/>
                    <Border Width="4" Height="18" Margin="0,0,5,0" CornerRadius="1"
                            Background="#0A0C10" VerticalAlignment="Center"
                            ToolTip="Peak of the loudest enabled recording device">
                        <Rectangle Fill="{StaticResource AccentABrush}"
                                   Opacity="{Binding MicPeak, Mode=OneWay}"/>
                    </Border>
                    <ToggleButton Style="{StaticResource MicToggle}" Width="34" Content="MON"
                                  Margin="0,0,4,0"
                                  IsChecked="{Binding MicMonitorEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Microphone monitor"
                                  ToolTip="Also send the voice to the monitor output. Headphones only: an open speaker plus a live mic feeds back."/>
                    <ToggleButton Style="{StaticResource MicToggle}" Width="38" Content="MUTE"
                                  Margin="0,0,12,0"
                                  IsChecked="{Binding MicMuted, Mode=TwoWay}"
                                  AutomationProperties.Name="Microphone mute"
                                  ToolTip="Mute the talk-over microphone"/>

                    <TextBlock Text="MASTER" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <Slider Width="130" VerticalAlignment="Center"
                            Minimum="0" Maximum="1.2"
                            SmallChange="0.01" LargeChange="0.1"
                            Value="{Binding MasterVolume, Mode=TwoWay}"
                            ToolTip="Master output: 100% = unity, up to 120%"/>
                    <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:0%}}"
                               FontFamily="Consolas" FontSize="10" Width="38"
                               Margin="7,0,4,0" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}"
                               ToolTip="Master output level"/>
                    <Button Content="&#x21BA;" Width="20" Height="18" Padding="0" FontSize="10"
                            Command="{Binding ResetMasterVolumeCommand}"
                            ToolTip="Reset master to 100%"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Unified transport =================
             Order in the deck block is now: deck cards, this transport,
             crossfader/mic/master, waveforms. These act on the active deck (the
             deck the lyrics clock follows). -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Transport buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- One press restarts, a second press inside 450 ms steps back
                         a track. Two behaviours on one button, as on a CD deck. -->
                    <Button Style="{StaticResource TransportButton}" Content="&#x23EE;"
                            Margin="0,0,4,0" Click="OnPreviousPress"
                            ToolTip="Restart this track. Press again for the previous track."/>
                    <Button Style="{StaticResource TransportButton}" Content="&#x23EA;"
                            ToolTip="Rewind 10s on the active deck" Command="{Binding RewindCommand}"/>
                    <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Width="64"
                            Margin="6,0" FontSize="20" Command="{Binding PlayPauseCommand}"/>
                    <Button Style="{StaticResource TransportButton}" Content="&#x23F9;"
                            ToolTip="Stop the active deck" Command="{Binding StopCommand}"/>
                    <Button Style="{StaticResource TransportButton}" Content="&#x23E9;" Margin="6,0,0,0"
                            ToolTip="Fast forward 10s on the active deck" Command="{Binding FastForwardCommand}"/>
                </StackPanel>

                <!-- Position readout -->
                <TextBlock Grid.Column="1" Text="{Binding PositionText}" FontFamily="Consolas"
                           FontSize="16" VerticalAlignment="Center" Margin="18,0,10,0"/>

                <!-- Active deck seek bar -->
                <Slider x:Name="SeekBar" Grid.Column="2" VerticalAlignment="Center"
                        Minimum="0" Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"/>

                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontFamily="Consolas"
                           FontSize="16" VerticalAlignment="Center" Margin="10,0,18,0"
                           Foreground="{StaticResource TextDimBrush}"/>

                <!-- Deck activation + download queue -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="A" FontSize="10" Padding="8,3" Margin="0,0,4,0"
                            Command="{Binding ActivateDeckACommand}"
                            ToolTip="Make deck A the active deck (seek bar + lyrics clock)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Padding" Value="8,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeckAActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="B" Margin="0,0,8,0"
                            Command="{Binding ActivateDeckBCommand}"
                            ToolTip="Make deck B the active deck (seek bar + lyrics clock)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Padding" Value="8,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeckBActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Download queue: compact entry point with an active-count badge -->
                    <Button Command="{Binding ShowDownloadsCommand}"
                            FontSize="10" Padding="8,3"
                            ToolTip="Show the activity console: downloads, karaoke jobs and the log">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2B07; Downloads" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource AccentBBrush}" CornerRadius="7"
                                    Padding="5,0" Margin="7,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Items still in the queue">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Downloads.ActiveCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Downloads.ActiveCount}" FontSize="9"
                                           FontFamily="Consolas" Foreground="{StaticResource WindowBrush}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <!-- Splitter: balances the deck block against the browser -->
        <GridSplitter Grid.Row="2" Style="{StaticResource RowSplitter}"/>

        <!-- ================= Browser + Lyrics ================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Track browser (tree view) + streaming sources -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <TabControl x:Name="BrowserTabs" Style="{StaticResource BrowserTabControl}">
                <TabItem Header="LIBRARY">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBlock Text="TRACK BROWSER" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        <Button Content="ARTIST" Margin="12,0,0,0"
                                FontSize="10" Padding="6,3"
                                ToolTip="Group tracks by tagged artist and album"
                                Command="{Binding ShowArtistAlbumLayoutCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArtistAlbumLayout}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="PATH" Margin="4,0,0,0"
                                FontSize="10" Padding="6,3"
                                ToolTip="Group tracks by their folder path"
                                Command="{Binding ShowPathLayoutCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPathLayout}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="Load &#x25B6;" Margin="8,0,0,0"
                                Command="{Binding LoadSelectedTreeTrackCommand}"/>
                        <Button x:Name="ExpandButton" DockPanel.Dock="Right"
                                Content="&#x2B07; Expand all" Margin="4,0,0,0"
                                FontSize="10" Padding="6,3" Click="OnExpandAllClick"/>
                        <Button DockPanel.Dock="Right" Content="+ Queue" Margin="4,0,0,0"
                                FontSize="10" Padding="6,3"
                                ToolTip="Add the selected track to the playback queue (Ctrl+Q)"
                                Command="{Binding AddToQueueCommand}"/>
                        <!-- Filter + sort strip, shared with the Spotify and YouTube
                             lists. Its filter box writes into SearchText, so the tree
                             keeps filtering exactly as before. -->
                        <ContentControl Margin="12,0,0,0" VerticalAlignment="Center"
                                        Focusable="False"
                                        Content="{Binding LibraryView}"
                                        ContentTemplate="{StaticResource FilterSortStrip}"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Playlist rail. Wraps the existing tree grid, so the
                             tab's own layout is untouched. -->
                        <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                                Padding="2,0,2,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="PLAYLISTS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextDimBrush}" Margin="4,4,0,4"/>

                                <!-- + New (inline name, same pattern as the YouTube manage strip) -->
                                <Button DockPanel.Dock="Top" Content="+ New" HorizontalAlignment="Left"
                                        FontSize="10" Padding="5,2" Margin="2,0,2,4"
                                        ToolTip="Create an app-owned playlist"
                                        Command="{Binding BeginCreatePlaylistCommand}"
                                        Visibility="{Binding IsNotCreatingPlaylist, Converter={StaticResource BoolToVisibility}}"/>

                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,4"
                                            Visibility="{Binding IsCreatingPlaylist, Converter={StaticResource BoolToVisibility}}">
                                    <TextBox Width="104" FontSize="11"
                                             Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding CommitCreatePlaylistCommand}"/>
                                            <KeyBinding Key="Escape" Command="{Binding CancelCreatePlaylistCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Content="&#x2713;" FontSize="10" Padding="4,1" Margin="3,0,0,0"
                                            ToolTip="Create" Command="{Binding CommitCreatePlaylistCommand}"/>
                                    <Button Content="&#x2715;" FontSize="10" Padding="4,1" Margin="2,0,0,0"
                                            ToolTip="Cancel" Command="{Binding CancelCreatePlaylistCommand}"/>
                                </StackPanel>

                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="10" Margin="4,0,6,4"
                                           Text="No playlists yet. Use + New to make one from library tracks, or right-click a track and choose Add to playlist."
                                           Foreground="{StaticResource TextDimBrush}"
                                           Visibility="{Binding HasNoInternalPlaylists, Converter={StaticResource BoolToVisibility}}"/>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding PlaylistRail}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <!-- Normal row -->
                                                    <Button HorizontalContentAlignment="Stretch" Padding="4,3"
                                                            Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.SelectPlaylistCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <!-- Tag carries the view model into the context menu;
                                                             the menu itself is in its own popup tree. -->
                                                        <Button.Tag>
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </Button.Tag>
                                                        <Button.ContextMenu>
                                                            <ContextMenu AutomationProperties.Name="Playlist actions">
                                                                <MenuItem Header="New playlist"
                                                                          Command="{Binding PlacementTarget.Tag.BeginCreatePlaylistCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                <MenuItem Header="Move up"
                                                                          Command="{Binding PlacementTarget.Tag.MovePlaylistUpCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem"
                                                                               BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                            <Style.Triggers>
                                                                                <!-- Imported rows are read-only in this rail, like Rename/Delete -->
                                                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.Playlist.IsReadOnly,
                                                                                                       RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                             Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                                <MenuItem Header="Move down"
                                                                          Command="{Binding PlacementTarget.Tag.MovePlaylistDownCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem"
                                                                               BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.Playlist.IsReadOnly,
                                                                                                       RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                             Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Rename playlist…"
                                                                          Command="{Binding PlacementTarget.Tag.BeginRenamePlaylistCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem"
                                                                               BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                            <Style.Triggers>
                                                                                <!-- Imported playlists cannot be renamed or deleted -->
                                                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.Playlist.IsReadOnly,
                                                                                                       RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                             Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                                <MenuItem Header="Delete playlist…"
                                                                          Command="{Binding PlacementTarget.Tag.BeginDeletePlaylistCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Style>
                                                                        <Style TargetType="MenuItem"
                                                                               BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.Playlist.IsReadOnly,
                                                                                                       RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                             Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </MenuItem.Style>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="Padding" Value="4,3"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextDimBrush}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        Visibility="{Binding IsInternal, Converter={StaticResource BoolToVisibility}}">
                                                                <Button Content="&#x270E;" FontSize="9" Padding="3,0" Margin="4,0,0,0"
                                                                        ToolTip="Rename playlist"
                                                                        Command="{Binding DataContext.BeginRenamePlaylistCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="&#x2715;" FontSize="9" Padding="3,0" Margin="1,0,0,0"
                                                                        ToolTip="Delete playlist"
                                                                        Command="{Binding DataContext.BeginDeletePlaylistCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Inline rename -->
                                                    <StackPanel Orientation="Horizontal" Margin="2,0,2,0"
                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBox Width="104" FontSize="11"
                                                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter"
                                                                            Command="{Binding DataContext.CommitRenamePlaylistCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                <KeyBinding Key="Escape"
                                                                            Command="{Binding DataContext.CancelRenamePlaylistCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <Button Content="&#x2713;" FontSize="10" Padding="4,1" Margin="3,0,0,0"
                                                                ToolTip="Rename"
                                                                Command="{Binding DataContext.CommitRenamePlaylistCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="&#x2715;" FontSize="10" Padding="4,1" Margin="2,0,0,0"
                                                                ToolTip="Cancel"
                                                                Command="{Binding DataContext.CancelRenamePlaylistCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>

                                                    <!-- Delete confirmation (internal playlists only) -->
                                                    <Border Margin="2,0,2,3" Padding="4,2"
                                                            Background="{StaticResource PanelBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Playlist.Name, StringFormat={}Delete &#x201C;{0}&#x201D;?}"
                                                                       FontSize="10" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="120"
                                                                       ToolTip="{Binding Playlist.Name}"/>
                                                            <Button Content="Yes" FontSize="10" Padding="5,1" Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.CommitDeletePlaylistCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="No" FontSize="10" Padding="5,1" Margin="3,0,0,0"
                                                                    Command="{Binding DataContext.CancelDeletePlaylistCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers come from Views/Shared/TrackRows.xaml, so
                             they line up with the rows on all three lists. -->
                        <ContentControl Grid.Row="0" Content="{StaticResource TrackColumnHeaders}"
                                        Focusable="False" IsTabStop="False"/>

                        <!-- Tree; the busy state below covers it while a playlist's
                             membership resolves off the UI thread, so a half-built
                             playlist is never shown. -->
                        <Grid Grid.Row="1">
                            <TreeView x:Name="TrackTree"
                                      ItemsSource="{Binding BrowserRoots}"
                                      Background="{StaticResource PanelBrush}"
                                      BorderThickness="0"
                                      MouseDoubleClick="OnTrackDoubleClick"
                                      PreviewMouseRightButtonDown="OnTrackRightClick"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.CacheLength="1"
                                      VirtualizingPanel.CacheLengthUnit="Page"
                                      ItemTemplate="{StaticResource LibraryNodeRow}"
                                      ContextMenu="{StaticResource TrackMenu}"
                                      Tag="{Binding TrackMenu}"
                                      ScrollViewer.CanContentScroll="True">
                                <!-- Virtualisation is the difference between "5 000 rows
                                     open in 10 s" and a scrolled window: without it every
                                     TreeViewItem of every expanded folder is built, even
                                     the ones never on screen. Recycling keeps the row
                                     template instances, pixel scrolling keeps the thumb
                                     honest while rows have a fixed height. -->
                                <!-- The row itself now comes from Views/Shared/TrackRows.xaml
                                     (LibraryNodeRow): one design shared with the
                                     Spotify and YouTube lists. -->

                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <!-- Bound two-way so a rebuild can restore the row state. -->
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="Bd" Grid.Row="0"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Expander toggle (visible only for folders) -->
                                                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                              ClickMode="Press"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                              Width="18" Height="18"
                                                                              Margin="4,0,2,0">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Width="18" Height="18"
                                                                                    Background="Transparent">
                                                                                <Path x:Name="Arrow"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Data="M 0 0 L 5 4 L 0 8 Z"
                                                                                      Fill="{StaticResource TextDimBrush}"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Arrow"
                                                                                            Property="Data"
                                                                                            Value="M 0 0 L 8 0 L 4 5 Z"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>
                                                                <!-- Content (row grid) -->
                                                                <ContentPresenter Grid.Column="1" x:Name="PART_Header"
                                                                                  ContentSource="Header"
                                                                                  HorizontalAlignment="Stretch"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter Grid.Row="1" x:Name="ItemsHost"
                                                                        Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="True">
                                                            <Setter TargetName="ItemsHost"
                                                                    Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="HasItems" Value="False">
                                                            <Setter TargetName="Expander"
                                                                    Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd"
                                                                    Property="Background"
                                                                    Value="{StaticResource SelectionBrush}"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsSelected" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd"
                                                                    Property="Background"
                                                                    Value="{StaticResource HoverBrush}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>

                            <!-- Busy state: a playlist resolves off the UI thread and is
                                 applied as one batch, so the tree is only ever empty or
                                 complete - never half built. -->
                            <Border Background="{StaticResource PanelBrush}" Opacity="0.85"
                                    Visibility="{Binding IsPlaylistLoading, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Loading playlist&#x2026;"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            </Border>
                        </Grid>
                        </Grid>
                    </Grid>
                </DockPanel>
                </TabItem>

                <TabItem Header="SPOTIFY">
                    <views:SpotifyView DataContext="{Binding Spotify}"/>
                </TabItem>

                <TabItem Header="YOUTUBE">
                    <views:YouTubeView DataContext="{Binding YouTube}"/>
                </TabItem>

                <TabItem Header="{Binding QueueHeader}">
                    <DockPanel>
                        <!-- Queue toolbar: transport for the queue itself -->
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                            <TextBlock Text="PLAYBACK QUEUE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="&#x23EE; Prev" FontSize="10" Padding="8,3"
                                        ToolTip="Play the previous unplayed queue track (Ctrl+Shift+Left)"
                                        Command="{Binding PlayPreviousCommand}"/>
                                <Button Content="Next &#x23ED;" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                                        ToolTip="Play the next queue track (Ctrl+Shift+Right)"
                                        Command="{Binding PlayNextCommand}"/>
                                <Button Command="{Binding ToggleRepeatQueueCommand}" Margin="8,0,0,0"
                                        ToolTip="Start the queue over when it reaches the end">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RepeatQueue}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#x21BB; Repeat"/>
                                </Button>
                                <Button Content="Clear played" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                                        Command="{Binding ClearPlayedCommand}"/>
                                <Button Content="Clear" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                                        Command="{Binding ClearQueueCommand}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Status line doubles as the empty-state hint -->
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding QueueStatusText}"
                                   Margin="6,6,6,0" FontSize="10.5"
                                   Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column headers -->
                            <Border Grid.Row="0" Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Padding="6,5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Deck" Padding="0,5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="2" Text="Title" Padding="6,5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="3" Text="Artist" Padding="6,5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="4" Text="Time" Padding="6,5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="5" Text="State" Padding="6,5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Rows: played stays in the list (greyed), current gets the accent bar -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding Queue}"
                                      SelectedItem="{Binding SelectedQueueItem}"
                                      ItemContainerStyle="{StaticResource QueueRow}"
                                      Background="{StaticResource PanelBrush}"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlaybackQueueItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding IndexText}"
                                                       Padding="6,0" FontFamily="Consolas" FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDimBrush}"/>

                                            <!-- Deck badge: click to flip the row between A and B -->
                                            <Button Grid.Column="1" Content="{Binding DeckText}"
                                                    Width="18" Height="16" Padding="0" Margin="1,0,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    FontFamily="Consolas" FontSize="9"
                                                    Foreground="{StaticResource TextDimBrush}"
                                                    ToolTip="{Binding DeckHint}"
                                                    Command="{Binding DataContext.FlipQueueDeckCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                       Padding="6,0" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"/>

                                            <TextBlock Grid.Column="3" Text="{Binding Artist}"
                                                       Padding="6,0" FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Artist}"/>

                                            <TextBlock Grid.Column="4" Text="{Binding DurationText}"
                                                       Padding="6,0" FontFamily="Consolas" FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDimBrush}"/>

                                            <TextBlock Grid.Column="5" Text="{Binding Display}"
                                                       Padding="6,0" FontSize="10"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="&#x25B6;" Width="22" Height="20"
                                                        FontSize="9" Padding="0"
                                                        ToolTip="Play this track now"
                                                        Command="{Binding DataContext.PlayNowFromQueueCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="&#x2715;" Width="22" Height="20"
                                                        FontSize="9" Padding="0" Margin="2,0,0,0"
                                                        ToolTip="Remove from the queue"
                                                        Command="{Binding DataContext.RemoveFromQueueCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty hint, layered over the (empty) list -->
                            <TextBlock Grid.Row="1" Text="{Binding QueueStatusText}"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                                       IsHitTestVisible="False"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </DockPanel>
                </TabItem>
                </TabControl>
            </Border>

            <!-- Lyrics panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- Lyrics header, row 1: title, provider picker, status -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="LYRICS" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}"/>

                        <ComboBox Grid.Column="1" Width="104" Height="24" MinHeight="24" Padding="6,3" Margin="10,0,0,0" FontSize="10"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding LyricsSourceOptions}"
                                  SelectedItem="{Binding SelectedLyricsSource}"
                                  ToolTip="Lyric provider for this track (Auto = normal priority chain)"/>

                        <Button x:Name="LyricsSourceMoreButton" Grid.Column="2" Content="&#x22EF;"
                                Width="20" Height="20" Margin="4,0,0,0" Padding="0" FontSize="12"
                                VerticalAlignment="Center"
                                ToolTip="Try other lyric sources&#10;for this track"
                                Command="{Binding TryOtherSourcesCommand}"/>

                        <TextBlock Grid.Column="3" Text="{Binding LyricsStatus}" FontSize="11"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Every provider that returned lyrics for this track -->
                        <Popup Grid.Column="1" Grid.ColumnSpan="2"
                               IsOpen="{Binding IsLyricsSourcePickerOpen, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               PlacementTarget="{Binding ElementName=LyricsSourceMoreButton}"
                               Placement="Bottom">
                            <Border Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,4,8,0"
                                    MinWidth="230" MaxWidth="320">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="5,0"
                                                FontSize="9" Height="18"
                                                Command="{Binding CloseLyricsSourcePickerCommand}"/>
                                        <TextBlock Text="LYRIC SOURCES" FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding LyricsSourceHint}" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <ItemsControl ItemsSource="{Binding LyricsCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,0,3" Padding="8,4"
                                                        Command="{Binding DataContext.ApplyLyricsCandidateCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SourceName}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                                   Foreground="{StaticResource TextDimBrush}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Lyrics header, row 2: offset (positive = lyrics later) -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8"
                          ToolTip="Positive values show lyrics later than the audio.&#10;Scope: the loaded track (TRACK), or the global default when nothing is loaded (GLOBAL).">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="60"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LyricsOffsetScope}" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource AccentABrush}"/>
                            <TextBlock Text=" later &#x2192;" FontSize="9"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>

                        <RepeatButton Grid.Column="1" Style="{StaticResource NudgeButton}" Content="&#x2212;100"
                                      Width="30" Height="20" Margin="6,0,0,0" FontSize="9"
                                      Delay="400" Interval="150"
                                      Command="{Binding NudgeLyricsCommand}" CommandParameter="-100"
                                      ToolTip="-100 ms"/>
                        <RepeatButton Grid.Column="2" Style="{StaticResource NudgeButton}" Content="&#x2212;10"
                                      Width="24" Height="20" Margin="3,0,0,0" FontSize="9"
                                      Delay="400" Interval="150"
                                      Command="{Binding NudgeLyricsCommand}" CommandParameter="-10"
                                      ToolTip="-10 ms (fine tune)"/>

                        <Slider Grid.Column="3" Height="18" Margin="6,0" VerticalAlignment="Center"
                                Minimum="-2000" Maximum="2000" SmallChange="1" LargeChange="100"
                                IsSnapToTickEnabled="False" Value="{Binding LyricsOffsetMs}"
                                ToolTip="-2000 to +2000 ms; positive = lyrics later"/>

                        <RepeatButton Grid.Column="4" Style="{StaticResource NudgeButton}" Content="+10"
                                      Width="24" Height="20" FontSize="9" Delay="400" Interval="150"
                                      Command="{Binding NudgeLyricsCommand}" CommandParameter="10"
                                      ToolTip="+10 ms (fine tune)"/>
                        <RepeatButton Grid.Column="5" Style="{StaticResource NudgeButton}" Content="+100"
                                      Width="30" Height="20" Margin="3,0,0,0" FontSize="9"
                                      Delay="400" Interval="150"
                                      Command="{Binding NudgeLyricsCommand}" CommandParameter="100"
                                      ToolTip="+100 ms"/>

                        <TextBlock Grid.Column="6" Text="{Binding LyricsOffsetText}" Width="52"
                                   Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextBrush}"/>

                        <Button Grid.Column="7" Content="Reset" Height="20" Margin="6,0,0,0"
                                FontSize="9" Padding="6,1"
                                Command="{Binding ResetLyricsCommand}"
                                ToolTip="Reset the current scope: the section, or this track's own offset (which then follows the global one again)"/>

                        <Button Grid.Column="8" Content="{Binding LyricsFollowLabel}" Height="20"
                                Margin="8,0,0,0" FontSize="9" Padding="6,1" MinWidth="42"
                                Command="{Binding ToggleLyricsFollowCommand}"
                                ToolTip="Lyric follow mode: LINE highlights one line at a time, WORD follows each word with the bouncing ball."/>
                    </Grid>
                    <Grid>
                        <ListBox x:Name="LyricsList" ItemsSource="{Binding LyricLines}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 Focusable="False"
                                 SelectionMode="Extended">
                            <!-- Timing menu. The ContextMenu is its own visual
                                 tree, so it reaches the view model through the
                                 ListBox it is placed on. -->
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                    RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Set timing for selected lines"
                                              Click="OnSetLyricTimingForSelection"
                                              ToolTip="Give the selected lines their own offset; the next nudge then moves just this part"/>
                                    <MenuItem Header="Remove timing for this section"
                                              Command="{Binding RemoveLyricTimingSectionCommand}"
                                              Visibility="{Binding HasSectionAtPlayhead,
                                                  Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="Drop the saved section the playhead is in; the track offset applies again"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <!-- Selectable: the timing menu acts on the selected
                                         lines, so the rows take focus and show a fill. -->
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SelectionBg" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SelectionBg" Property="Background"
                                                                Value="{StaticResource SelectionBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,5">
                                        <!-- Line-level only document: the original single
                                             selectable-free text block. -->
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   TextAlignment="Center" FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWords}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                            <Setter Property="FontSize" Value="20"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Word-level document: one TextBlock per word so the
                                             active word can be highlighted on its own. The
                                             trailing margin is the inter-word space (kept out of
                                             the measured box, so the bouncing ball sits on the
                                             glyphs). -->
                                        <ItemsControl ItemsSource="{Binding Words}"
                                                      HorizontalAlignment="Center">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWords}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Margin="0,0,5,0"
                                                               FontSize="16">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsCurrent,
                                                                                  RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                        <Setter Property="FontSize" Value="20"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Bouncing ball, layered over the list so it can move freely.
                             Hit-testing is off: clicks and wheel still reach the list. -->
                        <Canvas x:Name="LyricsBallCanvas" IsHitTestVisible="False"
                                ClipToBounds="True" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Ellipse Width="{x:Static vm:MainViewModel.BallSize}"
                                     Height="{x:Static vm:MainViewModel.BallSize}"
                                     Fill="{StaticResource AccentABrush}"
                                     Canvas.Left="{Binding BallX}" Canvas.Top="{Binding BallY}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BallVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Status console =================
             One docked surface for every long-running job. Jobs come from
             ActivityFeed.Shared (downloads, karaoke separation, playlist loads,
             scans); the Downloads tab stays on DownloadsViewModel so filters,
             pause/resume, cancel-all and retry keep working. The log is a third
             tab, not a competing pane. Collapsed it is a single 30 px strip that
             still states what is running, so nothing hides behind an icon. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0,6,0,0"
                AutomationProperties.Name="Activity console">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,3,8,3" LastChildFill="False">
                    <ToggleButton x:Name="ConsoleToggle" DockPanel.Dock="Left"
                                  Style="{StaticResource ConsoleHeaderToggle}"
                                  AutomationProperties.Name="Activity console, expand or collapse"
                                  ToolTip="Downloads, karaoke jobs and the recent log">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25B8;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=ConsoleToggle}"
                                                         Value="True">
                                                <Setter Property="Text" Value="&#x25BE;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="ACTIVITY" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Busy marker: a mark and a word, never colour alone. -->
                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="10,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy, Source={x:Static activity:ActivityFeed.Shared}}"
                                                 Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentABrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{StaticResource TextDimBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="nothing running"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy, Source={x:Static activity:ActivityFeed.Shared}}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="{Binding ActiveCount, Source={x:Static activity:ActivityFeed.Shared}, StringFormat={}{0} running}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button DockPanel.Dock="Right" Content="Clear finished"
                            Style="{StaticResource ConsoleAction}"
                            Command="{Binding ClearFinishedActivityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Remove finished jobs from the list. The log keeps its lines."/>
                </DockPanel>

                <TabControl x:Name="ConsoleTabs" Style="{StaticResource ConsoleTabs}" Height="214"
                            Visibility="{Binding IsChecked, ElementName=ConsoleToggle, Converter={StaticResource BoolToVisibility}}">

                    <!-- Jobs: every ActivityFeed row, one list -->
                    <TabItem Header="JOBS" Style="{StaticResource ConsoleTabItem}">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Rows, Source={x:Static activity:ActivityFeed.Shared}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="jobRow" Height="28" Margin="0,0,0,2" Padding="6,0"
                                                    CornerRadius="3" BorderThickness="1"
                                                    ToolTip="{Binding Detail}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                                <Setter Property="Background" Value="#241A1E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="3"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="74"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="22"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- What the row is -->
                                                        <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="JOB"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Download">
                                                                            <Setter Property="Text" Value="DOWNLOAD"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Karaoke">
                                                                            <Setter Property="Text" Value="KARAOKE"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="PlaylistLoad">
                                                                            <Setter Property="Text" Value="PLAYLIST"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Scan">
                                                                            <Setter Property="Text" Value="SCAN"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="1" FontSize="11.5"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,8,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Title}"/>
                                                                    <Setter Property="ToolTip" Value="{Binding Title}"/>
                                                                    <Style.Triggers>
                                                                        <!-- The warning mark, not just the red border, says this failed. -->
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Text" Value="{Binding Title, StringFormat={}⚠ {0}}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Stage, or the error itself on a failed row -->
                                                        <TextBlock Grid.Column="2" FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,6,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding StageText}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Text" Value="{Binding Detail}"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Percent, or an em dash when the producer has none -->
                                                        <TextBlock Grid.Column="3" FontFamily="Consolas" FontSize="10"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding PercentText}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                                                                            <Setter Property="Text" Value="&#x2014;"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="4" FontFamily="Consolas" FontSize="10"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource TextDimBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource ActivityElapsed}">
                                                                    <Binding Path="Started"/>
                                                                    <Binding Path="Finished"/>
                                                                    <Binding Path="Percent"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <!-- Cancel exists only where the backend can stop the job -->
                                                        <Button Grid.Column="5" Content="&#x2715;"
                                                                ToolTip="Cancel this job"
                                                                AutomationProperties.Name="Cancel this job"
                                                                Command="{Binding CancelActivityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ConsoleRowAction}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding CanCancel}" Value="True"/>
                                                                                <Condition Binding="{Binding IsFinished}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Progress: drawn only from a real percent -->
                                                    <ProgressBar Grid.Row="1" Minimum="0" Maximum="100"
                                                                 Value="{Binding Percent}" Margin="80,0,8,2">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource SlimBar}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Percent}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty state: says what belongs here -->
                            <TextBlock Text="Downloads and karaoke jobs appear here while they run."
                                       FontSize="11" Margin="4,8,0,0" VerticalAlignment="Top"
                                       Foreground="{StaticResource TextDimBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rows.Count, Source={x:Static activity:ActivityFeed.Shared}}"
                                                         Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>

                    <!-- Downloads: the queue, unchanged in behaviour -->
                    <TabItem Style="{StaticResource ConsoleTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DOWNLOADS" FontSize="10" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <Border Background="{StaticResource AccentBBrush}" CornerRadius="6"
                                        Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Downloads.ActiveCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Downloads.ActiveCount}" FontSize="9"
                                               FontFamily="Consolas" Foreground="{StaticResource WindowBrush}"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Downloads.StatusLine}"
                                               FontSize="10.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding Downloads.PauseLabel}"
                                                Command="{Binding Downloads.TogglePauseCommand}"
                                                Style="{StaticResource ConsoleAction}"
                                                ToolTip="Pause or resume the download workers. Queued items stay queued."/>
                                        <Button Content="Cancel all"
                                                Command="{Binding Downloads.CancelAllCommand}"
                                                Style="{StaticResource ConsoleAction}"
                                                ToolTip="Cancel everything queued or running"/>
                                        <Button Content="{Binding Downloads.RetryFailedLabel}"
                                                Command="{Binding Downloads.RetryFailedCommand}"
                                                Style="{StaticResource ConsoleAction}"
                                                ToolTip="Queue every failed download again"/>
                                        <Button Content="Clear done"
                                                Command="{Binding Downloads.ClearCompletedCommand}"
                                                Style="{StaticResource ConsoleAction}"
                                                ToolTip="Remove finished rows from the list"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Overall progress, only while the queue holds anything -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Downloads.TotalCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="4"
                                                 Style="{StaticResource SlimBar}"
                                                 Value="{Binding Downloads.OverallProgress}"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="10"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Text="{Binding Downloads.OverallProgress, StringFormat={}{0:0}%}"/>
                                </Grid>

                                <DockPanel Margin="0,0,0,3">
                                    <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Downloads.Filters}"
                                             SelectedItem="{Binding Downloads.SelectedFilter}"
                                             ItemContainerStyle="{StaticResource FilterPill}"
                                             Background="Transparent" BorderThickness="0" Focusable="False"
                                             AutomationProperties.Name="Download filter">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <TextBlock Text="{Binding Downloads.EmptyHint}" FontSize="10"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextDimBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Downloads.View.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Downloads.View}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="28" Margin="0,0,0,2" Padding="6,0"
                                                    CornerRadius="3" BorderThickness="1"
                                                    ToolTip="{Binding DetailText}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                                <Setter Property="Background" Value="#241A1E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="240"/>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding StateGlyph}"
                                                               FontSize="10" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextDimBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               FontSize="11.5" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DetailText}"
                                                               FontSize="10" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding ProgressText}"
                                                               FontFamily="Consolas" FontSize="10"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource TextDimBrush}"/>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <Button Content="&#x21BB;" ToolTip="Retry this download"
                                                                AutomationProperties.Name="Retry this download"
                                                                Command="{Binding DataContext.Downloads.RetryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ConsoleRowAction}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="&#x2715;" ToolTip="Cancel this download"
                                                                AutomationProperties.Name="Cancel this download"
                                                                Command="{Binding DataContext.Downloads.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ConsoleRowAction}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding State}" Value="Queued"/>
                                                                                <Condition Binding="{Binding IsFinished}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="&#x2933;" ToolTip="Open the finished file"
                                                                AutomationProperties.Name="Open the finished file"
                                                                Command="{Binding DataContext.Downloads.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ConsoleRowAction}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="&#x1F5D1;"
                                                                ToolTip="Delete the downloaded file. It goes to the Recycle Bin and the library stops listing it."
                                                                AutomationProperties.Name="Delete the downloaded file"
                                                                Command="{Binding DataContext.Downloads.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ConsoleRowAction}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="&#x2715;" ToolTip="Remove this row. Any file on disk is left alone."
                                                                AutomationProperties.Name="Remove this row from the list"
                                                                Command="{Binding DataContext.Downloads.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ConsoleRowAction}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Tools: same commands the old window carried, one quiet line -->
                                <Border Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="TOOLS" FontSize="9"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Downloads.ToolVersions}"
                                                   FontSize="9.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Downloads.ToolVersions}"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Downloads.ToolsStatus}"
                                                   FontSize="9.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentABrush}"
                                                   Visibility="{Binding Downloads.IsInstallingTools, Converter={StaticResource BoolToVisibility}}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Install tools"
                                                    Command="{Binding Downloads.InstallToolsCommand}"
                                                    Style="{StaticResource ConsoleAction}"/>
                                            <Button Content="Update yt-dlp"
                                                    Command="{Binding Downloads.UpdateYtDlpCommand}"
                                                    Style="{StaticResource ConsoleAction}"/>
                                            <Button Content="Update ffmpeg"
                                                    Command="{Binding Downloads.UpdateFfmpegCommand}"
                                                    Style="{StaticResource ConsoleAction}"/>
                                            <Button Content="{Binding Downloads.CacheStats}"
                                                    Command="{Binding Downloads.ClearCacheCommand}"
                                                    Style="{StaticResource ConsoleAction}"
                                                    ToolTip="Clear the stream cache"/>
                                            <Button Content="Music folder"
                                                    Command="{Binding Downloads.OpenMusicFolderCommand}"
                                                    Style="{StaticResource ConsoleAction}"/>
                                            <Button Content="Log folder"
                                                    Command="{Binding Downloads.OpenLogFolderCommand}"
                                                    Style="{StaticResource ConsoleAction}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Log: the app log tail, kept out of the jobs list's way -->
                    <TabItem Header="LOG" Style="{StaticResource ConsoleTabItem}">
                        <ListBox Style="{StaticResource ConsoleLogList}"
                                 ItemsSource="{Binding RecentLog, Source={x:Static activity:ActivityFeed.Shared}}"
                                 AutomationProperties.Name="Recent log lines">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- ================= Soundboard =================
             Collapsed by default; the header alone is ~34 px, which is what keeps
             the window scroll-free at 1400x900. Everything inside binds to the
             Board VM, so a missing board simply leaves an empty (collapsed) panel. -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="0" Margin="0,6,0,0"
                DataContext="{Binding Soundboard}">
            <Expander Style="{StaticResource SoundboardExpander}" IsExpanded="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Add row: local file on the left, YouTube link on the right.
                         Both go through the same ingest path, so a URL behaves
                         exactly like a file once it is on disk. -->
                    <DockPanel Grid.Row="0" Margin="2,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Left" Content="+ AUDIO FILE" FontSize="9"
                                Padding="8,4" Margin="0,0,8,0"
                                Command="{Binding AddFromFileCommand}"
                                ToolTip="Copy an audio file into the soundboard folder"/>
                        <Button DockPanel.Dock="Right" Content="ADD FROM URL" FontSize="9"
                                Padding="8,4" Margin="8,0,0,0"
                                Command="{Binding AddFromUrlCommand}"
                                ToolTip="Download a YouTube (or direct audio) link as a pad"/>
                        <TextBox VerticalContentAlignment="Center" FontSize="10" Padding="6,3"
                                 Text="{Binding NewSoundUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Paste a YouTube link">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddFromUrlCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <!-- Placeholder-ish hint; WPF has no placeholder, so
                                         a faint prefix in the empty case is enough. -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewSoundUrl}" Value="">
                                            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DockPanel>

                    <!-- Status line: add results, download progress and hotkey
                         conflicts all land here instead of in a dialog. -->
                    <TextBlock Grid.Row="1" FontSize="10" Margin="2,0,0,6"
                               Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextDimBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="2"
                               Text="No sounds yet — add an audio file or paste a YouTube link."
                               FontSize="10" Margin="2,2,0,8"
                               Foreground="{StaticResource TextDimBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pads.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Pads}"
                                  ItemTemplate="{StaticResource SoundboardPadTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,2,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- No pads: the tiles are already collapsed, so
                                         the board level would float on its own. -->
                                    <DataTrigger Binding="{Binding Pads.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="BOARD LEVEL" FontSize="9" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Foreground="{StaticResource TextDimBrush}"/>
                        <Slider Width="130" VerticalAlignment="Center"
                                Minimum="0" Maximum="1.2" SmallChange="0.01"
                                Value="{Binding Volume, Mode=TwoWay}"
                                ToolTip="Level of the whole soundboard, under the master fader"/>
                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0%}}"
                                   FontFamily="Consolas" FontSize="10" Width="40"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!-- ================= Footer ================= -->
        <DockPanel Grid.Row="6" Margin="0,8,0,0">
            <Button Content="&#x1F4C1; Folders" Click="OnSettingsButtonClick"
                    ToolTip="Configure the Music and Karaoke folders"/>
            <TextBlock Margin="10,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis">
                <Run Text="&#x266B;"/><Run Text="{Binding MusicDirectory}"/>
                <Run Text="  &#x1F3A4;"/><Run Text="{Binding KaraokeDirectory}"/>
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="&#x21BB; Devices" Margin="8,0,0,0"
                    ToolTip="Re-enumerate audio outputs" Command="{Binding ReloadDevicesCommand}"/>
            <Button DockPanel.Dock="Right" Content="&#x21BB; Rescan" Command="{Binding RescanCommand}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Margin="0,0,16,0"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
