<!-- MinWidth is the crossfader strip's own minimum plus the rail: 384 px fader +
     575 px karaoke/mic/master group + 64 px of window and card chrome + 56 px of
     navigation rail + slack. Below it the strip's right-hand group is clipped out
     of the card. The library pane and the dock are not part of this floor: the
     pane opens into the centre column only when the window can pay for it, and a
     dock panel trades width against the same centre floor at run time.

     MinHeight is the content's own minimum, measured rather than guessed: the deck
     block, the waveform floor and the dock's header fit inside it with the
     soundboard folded, and a karaoke track's KARAOKE strip adds ~30 px. 880 covers
     both with slack. It is also the operator's real ceiling - their displays give
     1036 px of working height at worst and 1396 on the primary. The root
     ScrollViewer below is the backstop for the states that need more than the
     minimum, such as an expanded mixer dock. -->
<Window x:Class="JockeyBox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JockeyBox.ViewModels"
        xmlns:lib="clr-namespace:JockeyBox.Library"
        xmlns:views="clr-namespace:JockeyBox.Views"
        xmlns:shell="clr-namespace:JockeyBox.Views.Shell"
        xmlns:activity="clr-namespace:JockeyBox.Activity"
        Title="JockeyBox" Height="900" Width="1400" MinHeight="880" MinWidth="1040"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding AddToQueueCommand}"/>
        <KeyBinding Key="Right" Modifiers="Control+Shift" Command="{Binding PlayNextCommand}"/>
        <KeyBinding Key="Left" Modifiers="Control+Shift" Command="{Binding PlayPreviousCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
        <!-- Shared design for track rows, the right-click menu and the
             filter/sort strip. Referenced by SpotifyView and YouTubeView too,
             so the three lists cannot drift apart again. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/JockeyBox;component/Views/Shared/TrackRows.xaml"/>
            <ResourceDictionary Source="/JockeyBox;component/Views/Shared/TrackMenu.xaml"/>
            <ResourceDictionary Source="/JockeyBox;component/Views/Shared/StatusConsole.xaml"/>
            <ResourceDictionary Source="/JockeyBox;component/Views/Shared/LibraryTabs.xaml"/>
        </ResourceDictionary.MergedDictionaries>



        <!-- Per-deck transport buttons: smaller and dimmer than the main row,
             which stays the primary surface for the active deck. -->
        <Style x:Key="DeckSecondaryButton" TargetType="Button"
               BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======== Deck card (shared by both decks; accent injected per-deck) ========
             A deck is a self-contained player: its own playhead, seek, volume,
             output device and waveform, plus the karaoke sub-stem bar when the
             loaded track has a karaoke partner. -->
        <!-- The one pad geometry, shared by a deck's cue bank and the karaoke pair's
             bank in the transport row. It lives at window scope because the pair bank
             is not inside the deck card: both banks must draw the same pad, and two
             copies of a 60-line template is how the two would drift apart.
             Nine pads, one row: each takes an equal share of what CLEAR leaves. The
             floor keeps a pad tappable and only engages on a window narrower than the
             card is ever laid out; at 1040 a share is ~37 px. -->

        <DataTemplate x:Key="DeckCardTemplate" DataType="{x:Type vm:DeckViewModel}">
            <!-- Bottom padding matched to the top: 20 px of it hung below the cue
                 bank as an empty band on both cards, which is the slack the review
                 measured at the card's foot. The cue bank is the last row, so 8 px
                 is the breathing room it needs and the rest is the lyrics box's. -->
            <Border Style="{StaticResource Card}" Padding="12,6,12,8">
                <Grid>
                    <!-- One label column, one control column. Every slider (VOL,
                         TEMPO, the scrub, karaoke GAIN) starts on the same x and
                         runs to the card's right edge, so the panel reads as a
                         grid instead of four rows with four different edges. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="Auto"/>   <!-- track -->
                        <RowDefinition Height="Auto"/>   <!-- output device -->
                        <RowDefinition Height="Auto"/>   <!-- volume -->
                        <RowDefinition Height="Auto"/>   <!-- tempo / BPM -->
                        <RowDefinition Height="Auto"/>   <!-- transport buttons -->
                        <RowDefinition Height="Auto"/>   <!-- scrub: own line -->
                        <RowDefinition Height="Auto"/>   <!-- karaoke sub-stem -->
                        <RowDefinition Height="Auto"/>   <!-- cue bank -->
                    </Grid.RowDefinitions>

                    <!-- Header: deck name, active marker, local time readout.
                         The name is the panel's identity for anyone who cannot
                         tell pink from cyan, so it is always there, in the deck's
                         own accent, at 11 px uppercase. -->
                    <DockPanel Grid.Row="0" Grid.ColumnSpan="3">
                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource DeckAccent}" VerticalAlignment="Center"/>
                        <!-- Version submenu: built from what is on disk when the track
                             loads. Switching crossfades over resident readers, so it
                             is seamless; a track with one version shows a disabled
                             menu whose tooltip says why instead of an empty popup. -->
                        <Menu DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                              Background="Transparent" IsMainMenu="False">
                            <MenuItem Header="{Binding VersionLabel}" FontSize="9" FontWeight="Bold"
                                      Padding="7,3" IsEnabled="{Binding CanSwitchVersion}"
                                      ToolTip="{Binding VersionHint}"
                                      ItemsSource="{Binding Versions}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding MenuText}"/>
                                        <Setter Property="ToolTip" Value="{Binding Reason}"/>
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                        <Setter Property="Command" Value="{Binding SelectCommand}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </Menu>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                Command="{Binding ActivateCommand}"
                                ToolTip="Route the shared seek bar and the lyrics clock to this deck">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="SET ACTIVE"/>
                                    <Setter Property="FontSize" Value="9"/>
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Content" Value="ACTIVE"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DeckAccent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DeckAccent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeReadout}"
                                   HorizontalAlignment="Right" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="8,0"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </DockPanel>

                    <!-- Track info -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,6">
                        <TextBlock Text="{Binding TrackTitle}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TrackDetail}" Foreground="{StaticResource TextDimBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Output device -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="OUTPUT" VerticalAlignment="Center"
                               FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                    <ComboBox Grid.Row="2" Grid.Column="2" Margin="0,0,0,5"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"/>

                    <!-- Volume, with this deck's cue pair on the same line. The
                         button gates the deck into the monitor bus and the short
                         fader beside it is that deck's cue level - audible ahead
                         of the program fader while MON is on, the way a channel
                         CUE on a DDJ-FLX4 hears a trimmed-down channel. Both sit
                         on the VOL row rather than a new one: the card's height is
                         what keeps the browser and lyrics box fed, so the pair
                         shares the row and the deck fader gives up the width. -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="VOL" VerticalAlignment="Center"
                               FontSize="10" Foreground="{StaticResource TextDimBrush}"/>

                    <Grid Grid.Row="3" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                    <!-- TickFrequency stays: the shared slider style draws its
                         ladder from it, and the recentre tick at the middle. Snapping
                         is the style's business now - IsSnapToTickEnabled="True" here
                         said one thing while the template forced the other, so the
                         attribute was a claim the control did not honour. -->
                    <Slider Grid.Row="3" Grid.Column="0" Minimum="0" Maximum="1.2"
                            TickFrequency="0.1"
                            Value="{Binding Volume}"/>

                        <!-- One template, both decks: neither the card nor its deck
                             object knows whether it is A or B, so the pair binds to
                             deck A's gate and level and a DeckPrefix trigger swaps
                             in deck B's. DeckPrefix is fixed for the life of the
                             card, so this reads the same as two copies would. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="CueSwitch" Width="44" Content="CUE"
                                          AutomationProperties.Name="Cue this deck to the monitor output">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MicToggle}">
                                        <Setter Property="ToolTip" Value="Deck A on the monitor output, ahead of its fader"/>
                                        <Setter Property="IsChecked" Value="{Binding DataContext.DeckACueEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeckPrefix}" Value="Deck B">
                                                <Setter Property="ToolTip" Value="Deck B on the monitor output, ahead of its fader"/>
                                                <Setter Property="IsChecked" Value="{Binding DataContext.DeckBCueEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Slider Width="88" Margin="6,0,0,0" Minimum="0" Maximum="1.2"
                                    TickFrequency="0.1"
                                    AutomationProperties.Name="Cue level for this deck">
                                <Slider.Style>
                                    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                        <Setter Property="ToolTip" Value="Deck A cue level"/>
                                        <Setter Property="Value" Value="{Binding DataContext.MonitorAGain, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeckPrefix}" Value="Deck B">
                                                <Setter Property="ToolTip" Value="Deck B cue level"/>
                                                <Setter Property="Value" Value="{Binding DataContext.MonitorBGain, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                            </DataTrigger>
                                            <!-- Cue off: the level is still settable - a
                                                 hand presets it before pressing CUE, as
                                                 on a channel trim - but it steps back so
                                                 two live-looking faders never suggest the
                                                 deck is being monitored when it is not. -->
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=CueSwitch}" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Slider.Style>
                            </Slider>
                        </StackPanel>
                    </Grid>

                    <!-- Tempo / BPM (plan item 5): a slim, centre-detented pitch fader
                         with its auto-centre button and the live readout. The fader is
                         fixed at +/-16 visually; the view model clamps to the configured
                         range. The fader is the first thing in the control column so its
                         left edge matches VOL above it. -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="TEMPO" FontSize="10"
                               Margin="0,5,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}"/>

                    <Grid Grid.Row="4" Grid.Column="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                            <!-- Centre detent: 0% is the middle of the fader. Drawn
                                 behind the thumb so a centred fader still reads as a
                                 thumb sitting on a mark, not a line through it. -->
                            <Border Width="1" Height="9" HorizontalAlignment="Center"
                                    Background="{StaticResource TextDimBrush}"
                                    IsHitTestVisible="False"/>
                            <Slider Minimum="-16" Maximum="16"
                                    SmallChange="0.1" LargeChange="1"
                                    Value="{Binding TempoPercent, Mode=TwoWay}"
                                    ToolTip="Tempo: -16% (slower) to +16% (faster), centre = original"/>
                        </Grid>

                        <TextBlock Grid.Column="1" Text="{Binding BpmText}" FontFamily="Consolas"
                                   FontSize="17" FontWeight="Bold" MinWidth="72"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   ToolTip="BPM the deck is producing right now"/>

                        <TextBlock Grid.Column="2" Text="{Binding TempoRatio, StringFormat={}{0:F3}}"
                                   FontFamily="Consolas" FontSize="11" Width="44"
                                   Margin="8,0,0,0" TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   ToolTip="Playback ratio (1.000 = original tempo)">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTempoModified}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                            <RepeatButton Style="{StaticResource StepperNudge}"
                                          Delay="400" Interval="120"
                                          Content="&#x2212;"
                                          Command="{Binding NudgeTempoCommand}" CommandParameter="-0.5"
                                          ToolTip="Slow down by 0.5%"/>
                            <Button Width="22" Height="18" Margin="3,0" Padding="0"
                                    FontSize="9" FontWeight="Bold" Content="0"
                                    Command="{Binding CenterTempoCommand}"
                                    IsEnabled="{Binding IsTempoModified}"
                                    ToolTip="Auto-centre: back to the track's original tempo">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTempoModified}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DeckAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource DeckAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <RepeatButton Style="{StaticResource StepperNudge}"
                                          Delay="400" Interval="120"
                                          Content="+"
                                          Command="{Binding NudgeTempoCommand}" CommandParameter="0.5"
                                          ToolTip="Speed up by 0.5%"/>
                        </StackPanel>
                    </Grid>

                    <!-- Transport: this deck's own controls, secondary to the main
                         row. Any click inside the card activates the deck
                         (OnDeckInteract in the code-behind), so these buttons
                         never move a deck the user is not looking at. -->
                    <!-- Transport line: this deck's buttons on the left, the karaoke
                         delay trim on the right. The trim used to sit in the karaoke
                         strip below, on a line of its own beside a gain slider that is
                         gone; the operator moved it up here, so it shares this line's
                         height instead of costing the card a row. -->
                    <Grid Grid.Row="5" Grid.ColumnSpan="3" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23EE;"
                                ToolTip="Previous track on this deck"
                                Command="{Binding DataContext.PreviousTrackForDeckCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23EA;"
                                ToolTip="Back 10 seconds on this deck"
                                Command="{Binding SkipBackCommand}"/>
                        <Button Style="{StaticResource DeckSecondaryButton}" Content="{Binding PlayGlyph}"
                                ToolTip="Play or pause this deck"
                                Command="{Binding PlayPauseCommand}"/>
                        <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23E9;"
                                ToolTip="Forward 10 seconds on this deck"
                                Command="{Binding SkipForwardCommand}"/>
                        <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23F9;"
                                ToolTip="Stop this deck"
                                Command="{Binding StopCommand}"/>
                        <Button Style="{StaticResource DeckSecondaryButton}" Content="&#x23ED;"
                                ToolTip="Next track on this deck"
                                Command="{Binding DataContext.NextTrackForDeckCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        </StackPanel>

                        <!-- One millisecond field on this line, and it is this
                             deck's OUTPUT: DELAY MS holds this deck's audio back
                             (audible, always shown - not a karaoke feature). The
                             stem trim lives in the KARAOKE strip below, where a
                             deck that has no stem shows nothing for it.

                             No WrapPanel: a second group on this line wrapped onto
                             its own 18 px line at 1040 and made one deck's card
                             taller than the other's, which is the invariant the
                             pair of cards is supposed to hold. With one group
                             there is nothing left to wrap. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="DELAY MS" FontSize="9" Margin="12,0,6,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center"/>
                            <RepeatButton Style="{StaticResource StepperNudge}"
                                          Delay="400" Interval="150"
                                          Content="&#x2212;"
                                          Command="{Binding NudgeOutputDelayCommand}" CommandParameter="-5"
                                          ToolTip="Delay this deck 5 ms less"/>
                            <TextBox Width="56" Margin="3,0"
                                     TextAlignment="Center" FontSize="10"
                                     MinHeight="18" Padding="4,0"
                                     VerticalAlignment="Center"
                                     Text="{Binding OutputDelayMs, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                     ToolTip="Output delay: this deck's audio reaches the output this many milliseconds late"/>
                            <RepeatButton Style="{StaticResource StepperNudge}"
                                          Delay="400" Interval="150"
                                          Content="+"
                                          Command="{Binding NudgeOutputDelayCommand}" CommandParameter="5"
                                          ToolTip="Delay this deck 5 ms more"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scrub sits on its own line so it starts at the control
                         column, not under the last transport button. -->
                    <Slider Grid.Row="6" Grid.Column="2" Margin="0,3,0,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            PreviewMouseLeftButtonDown="OnDeckSeekStart"
                            PreviewMouseLeftButtonUp="OnDeckSeekEnd"
                            LostMouseCapture="OnDeckSeekLostCapture"
                            ToolTip="Seek this deck"/>

                    <!-- The KARAOKE strip holds both halves of "this deck's stem":
                         STEM MS trims the karaoke stem inside this deck, and the
                         sentence says why there is no stem to trim. A stem trim
                         means nothing on a deck without a stem, so it belongs here
                         and not on the transport line, which is about this deck's
                         audio reaching the output and now carries exactly one field
                         (DELAY MS) at every width.

                         MinHeight is 18, the height of the stepper beside the field,
                         so the strip is the same line whether the trim is showing or
                         only the sentence is: two cards cannot end on different
                         lines even when only one of them holds a stem. The row is
                         laid out on both decks, always, so a deck with no stem says
                         why the section is empty rather than reserving silence. -->
                    <Border Grid.Row="7" Grid.ColumnSpan="3" Margin="0,5,0,0" Padding="0,4,0,0"
                            BorderBrush="{DynamicResource DeckAccent}" BorderThickness="0,1,0,0">
                        <Grid MinHeight="18">
                            <TextBlock FontSize="9" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDimBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasKaraoke}" Value="False">
                                                <Setter Property="Text" Value="no karaoke stem in this file"/>
                                            </DataTrigger>
                                            <!-- An unloaded deck is empty, not stemless. -->
                                            <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding HasKaraoke, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="STEM MS" FontSize="9" Margin="0,0,6,0"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"/>
                                <RepeatButton Style="{StaticResource StepperNudge}"
                                              Delay="400" Interval="150"
                                              Content="&#x2212;"
                                              Command="{Binding NudgeDelayCommand}" CommandParameter="-5"
                                              ToolTip="Trim the karaoke stem 5 ms earlier"/>
                                <TextBox Width="56" Margin="3,0"
                                         TextAlignment="Center" FontSize="10"
                                         MinHeight="18" Padding="4,0"
                                         VerticalAlignment="Center"
                                         Text="{Binding DelayMs, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                         ToolTip="Karaoke stem: trims the stem inside this deck. Not an output delay."/>
                                <RepeatButton Style="{StaticResource StepperNudge}"
                                              Delay="400" Interval="150"
                                              Content="+"
                                              Command="{Binding NudgeDelayCommand}" CommandParameter="5"
                                              ToolTip="Trim the karaoke stem 5 ms later"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cue bank: eight saved pads plus the quick cue in one
                         bordered strip, so the nine read as a bank and not as
                         loose buttons. Occupied and empty differ by shape and
                         text (solid outline + position vs dashed outline + dash),
                         never by tint alone. 44 px tall (a gig is a touch target)
                         and a share of the row's width: a fixed 44 px pad wrapped
                         the ninth pad onto a second row on a 1040 card while a
                         third of the row sat empty, and the two decks then showed
                         two different banks of the same nine cues. -->
                    <Grid Grid.Row="8" Grid.ColumnSpan="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top-aligned on the pad bank's first row. 22 px is CLEAR's
                             height now, so the label centres against the button it
                             names rather than against the 15 px pads. -->
                        <Grid Grid.Column="0" Height="22" VerticalAlignment="Top" Margin="0,4,0,0">
                            <TextBlock Text="CUES" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="3">
                            <DockPanel>
                                <!-- Clear mode says so on the control itself: CLEAR
                                     arms it, the label becomes DONE, and the border
                                     and weight change with it, so the armed state
                                     never rests on colour alone. -->
                                <Button DockPanel.Dock="Right" MinWidth="54" Height="22"
                                        Margin="4,0,0,0" Padding="7,0" FontSize="10" FontWeight="Bold"
                                        VerticalAlignment="Top"
                                        Command="{Binding Cues.ToggleClearModeCommand}"
                                        Content="{Binding Cues.ClearModeText}"
                                        ToolTip="Clear mode: while on, pressing a pad removes its cue">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Cues.IsClearing}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ItemsControl ItemsSource="{Binding Cues.Pads}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CuePad}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Cues.PressCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    ToolTip="{Binding ToolTip}"
                                                    AutomationProperties.Name="{Binding PadText}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>


        <!-- ======== Vertical splitter: browser | mixer dock, same bottom band ========
             8px hit area, one hairline, and a real grab handle: a 6x44 px pill with
             three dots at mid-height. The 2x34 px nib this replaced read as a seam in
             the card, not as something to drag. Hover turns the dots and the pill's
             edge accent, so the affordance answers the pointer. -->
        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Width="1" HorizontalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                            <Border x:Name="grip" Width="6" Height="44" CornerRadius="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse x:Name="dot1" Width="2" Height="2" Margin="0,0,0,2"
                                             Fill="{StaticResource TextDimBrush}"/>
                                    <Ellipse x:Name="dot2" Width="2" Height="2" Margin="0,0,0,2"
                                             Fill="{StaticResource TextDimBrush}"/>
                                    <Ellipse x:Name="dot3" Width="2" Height="2"
                                             Fill="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background"
                                        Value="{StaticResource TextDimBrush}"/>
                                <Setter TargetName="grip" Property="BorderBrush"
                                        Value="{StaticResource TextDimBrush}"/>
                                <Setter TargetName="dot1" Property="Fill"
                                        Value="{StaticResource PanelBrush}"/>
                                <Setter TargetName="dot2" Property="Fill"
                                        Value="{StaticResource PanelBrush}"/>
                                <Setter TargetName="dot3" Property="Fill"
                                        Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseCaptured" Value="True">
                                <Setter TargetName="grip" Property="Background"
                                        Value="{StaticResource AccentABrush}"/>
                                <Setter TargetName="grip" Property="BorderBrush"
                                        Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== Horizontal splitter between the deck block and the browser ========
             8px hit area, one hairline, a short centred grip. Same family as the
             vertical splitters inside the source tab panes. -->
        <Style x:Key="RowSplitter" TargetType="GridSplitter">
            <Setter Property="Height" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Height="1" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                            <Border x:Name="grip" Width="34" Height="2" CornerRadius="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#3A4150"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background"
                                        Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== Soundboard expander ========
             Header is a toggle on the left and its actions on the right, so
             STOP ALL never doubles as "collapse". -->
        <Style x:Key="SoundboardExpander" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0" Focusable="False" Cursor="Hand"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="hd" Background="Transparent"
                                                    CornerRadius="8" Padding="12,7">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hd" Property="Background"
                                                            Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Chevron follows the expander's own state, so
                                             it needs no template trigger and no name
                                             crossing into the ToggleButton's content. -->
                                        <TextBlock FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#x25B8;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsExpanded,
                                                                         RelativeSource={RelativeSource AncestorType=Expander}}">
                                                            <Setter Property="Text" Value="&#x25BE;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="SOUNDBOARD" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="10"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                </ToggleButton>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Button Content="+ ADD SLOT" FontSize="9" Padding="8,4"
                                            Margin="0,0,6,0"
                                            Command="{Binding AddSlotCommand}"
                                            ToolTip="Add an empty pad"/>
                                    <Button Content="STOP ALL" FontSize="9" Padding="8,4"
                                            Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding StopAllCommand}"
                                            ToolTip="Silence every pad"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="body" Grid.Row="1" Padding="12,0,12,10"
                                    Visibility="Collapsed">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Root scroll. The shell is a fixed-height design: the header, deck block,
         activity console, soundboard and Folders bar are Auto rows while only the
         waveform and browser are elastic, so any state that wants more room than
         the frame has nowhere to take it from and simply clips. The worst case is
         the activity console expanded with a job selected - ~1160 px of content at
         900 tall - which no MinHeight can honestly cover on a 1036 px display.

         MinHeight bound to the viewport is what keeps the elastic rows elastic:
         with content that fits, the grid is exactly the viewport, so the star rows
         and the deck/browser GridSplitter behave as they always did and no bar
         appears. When content does not fit, the grid keeps its natural height, the
         ScrollViewer grows a scrollbar, and every strip stays reachable instead of
         being cut. Horizontal is off: the layout already has MinWidth 1040 and a
         sideways scrollbar would hide the crossfader strip. -->
    <ScrollViewer x:Name="ShellScroll" Padding="12" Focusable="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="ShellGrid"
          MinHeight="{Binding ViewportHeight, ElementName=ShellScroll}">
        <Grid.Resources>

            <!-- Master gate and the per-group switch: same pill as MON/MUTE, with the word
                 changing rather than colour alone saying on or off. -->

            <Style x:Key="RackBandToggle" TargetType="ToggleButton" BasedOn="{StaticResource MicToggle}">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Content" Value="EDIT"/>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Content" Value="HIDE"/>
                    </Trigger>
                </Style.Triggers>
            </Style>




        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header: title, loaded track, monitor gate -->
            <RowDefinition Height="*"/>      <!-- body: rail | library | centre | flyout -->
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <!-- LastChildFill is off so the title cannot take the room the two
             right-docked groups need: docked children are measured in the order they
             are declared, so Settings and the monitor cluster claim the right edge
             first and the title gets what is left of it and ellipsises. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="&#x2699; Settings" HorizontalAlignment="Right"
                    Click="OnSettingsClick"/>

            <!-- Diagnostics: the only place the running build's identity, strip chains and
                 bus peaks can be read without a log file. Placed beside Settings because
                 that is where an operator looks for "the app's own state". -->
            <Button DockPanel.Dock="Right" Content="Diagnostics" Margin="0,0,8,0"
                    HorizontalAlignment="Right" Click="OnDiagnosticsClick"
                    ToolTip="Build identity, engine facts, strip chains and live bus peaks. Read-only."/>

            <!-- Monitor cluster: the MON switch, the output it plays on, and
                 MVSYNC. It lives on this line because it has nowhere else to go
                 that costs nothing: the deck block, the browser row and the
                 folders strip already fill the viewport at 1518x900 to the pixel,
                 so a second line under MON would have to be taken out of the
                 lyrics box. One line, window-wide state that is always visible.

                 MON is the master gate; each deck's own cue button and cue level
                 are on that deck's card, beside its fader, so "cue deck A" sits
                 on deck A. The dropdown is the monitor endpoint itself - the same
                 saved field the Settings dialog writes, offered here so the
                 operator does not have to open Settings to move the monitor. It
                 takes the width the two deck sliders used to, so this row is
                 narrower than it was, not wider.

                 Every width is fixed here, so the row cannot resize or shift when
                 MON toggles. MVSYNC still links the two cue levels on the cards;
                 it is session state, not a saved setting. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="16,0,10,0">
                <ToggleButton Style="{StaticResource MicToggle}" Width="42" Margin="0,0,10,0"
                              Content="MON" IsChecked="{Binding MonitorEnabled}"
                              ToolTip="Play the cued decks on the monitor output"/>
                <ToggleButton Style="{StaticResource MicToggle}" Width="58" Margin="12,0,0,0"
                              Content="MVSYNC" IsChecked="{Binding MonitorSyncEnabled}"
                              ToolTip="Move both decks' cue levels together"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Left" Text="JOCKEY" FontSize="20" FontWeight="Black"/>
            <TextBlock DockPanel.Dock="Left" Text="BOX" FontSize="20" FontWeight="Black"
                       Foreground="{StaticResource AccentABrush}"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding LoadedTrackTitle}" Margin="24,0,0,0" FontSize="14"
                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <!-- ================= Body =================
             Four regions, each with one job: the rail opens panes, the library pane
             is the only place the catalogue lives, the centre runs the show, and the
             dock column holds every configuration pane, one at a time. Nothing here
             opens a modal dialog: a dock panel can be closed mid-track and the
             transport underneath keeps working. -->
        <Grid Grid.Row="1" x:Name="ShellBody">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Navigation rail =================
                 One toggle per pane, plus the two places that used to sit in the header
                 (Settings, Diagnostics). The rail is 44 px wide because that is the
                 narrowest a 9 px label reads at without hyphenating; every button carries
                 its full name in AutomationProperties so a screen reader does not have to
                 guess at the abbreviation. -->
            <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                    Padding="6,8,6,4">
                <Border.Resources>
                    <!-- Rail toggle: the same pill as MON/MUTE, sized for a 44 px column. -->
                    <Style x:Key="RailButton" TargetType="ToggleButton" BasedOn="{StaticResource MicToggle}">
                        <Setter Property="Width" Value="44"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="9"/>
                    </Style>
                    <Style x:Key="RailCommand" TargetType="Button"
                           BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                        <Setter Property="Width" Value="44"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="9"/>
                    </Style>
                </Border.Resources>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="RailSettings" Style="{StaticResource RailCommand}"
                                Content="&#x2699;" FontSize="15"
                                Click="OnSettingsClick"
                                AutomationProperties.Name="Settings"
                                ToolTip="Settings: library, audio devices, virtual devices, performance, advanced"/>
                        <Button x:Name="RailDiagnostics" Style="{StaticResource RailCommand}"
                                Content="DIAG" Margin="0"
                                Click="OnDiagnosticsClick"
                                AutomationProperties.Name="Diagnostics"
                                ToolTip="Build identity, engine facts, strip chains and live bus peaks. Read-only."/>
                    </StackPanel>
                    <StackPanel x:Name="RailStack">
                        <ToggleButton x:Name="LibraryToggle" Style="{StaticResource RailButton}"
                                      Content="LIB" Click="OnLibraryToggleClick"
                                      AutomationProperties.Name="Library pane: artists, albums, crates and the queue"
                                      ToolTip="Open the library pane: artists, albums, crates and the queue"/>
                        <!-- Lyrics used to be a tab in the centre strip. It is a rail
                             panel now: the dock holds it, its caption carries the
                             pop-out, and its window geometry is the operator's own. -->
                        <ToggleButton x:Name="LyricsToggle" Style="{StaticResource RailButton}"
                                      Content="LYRIC" Click="OnLyricsToggleClick"
                                      AutomationProperties.Name="Lyrics panel"
                                      ToolTip="Open the lyrics pane: the current track's lines"/>
                        <ToggleButton x:Name="DockToggle" Style="{StaticResource RailButton}"
                                      Content="MIX" Click="OnDockToggleClick"
                                      AutomationProperties.Name="Mixer dock: strips, soundboard, cue bank, jobs"
                                      ToolTip="Open the mixer dock: strips and EQ, soundboard, cue bank, jobs"/>
                        <TextBlock Text="PANEL" FontSize="8" Margin="2,6,0,4"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <ToggleButton x:Name="RailRoutingToggle" Style="{StaticResource RailButton}"
                                      Content="ROUTE" Click="OnRouteToggleClick"
                                      AutomationProperties.Name="Routing panel"
                                      ToolTip="Routing: which device each deck, the soundboard and the monitor play on"/>
                        <ToggleButton x:Name="RailSourcesToggle" Style="{StaticResource RailButton}"
                                      Content="SRC" Click="OnSourcesToggleClick"
                                      AutomationProperties.Name="Source configuration panel"
                                      ToolTip="Source configuration: the microphone strip, its delay and its gate"/>
                        <ToggleButton x:Name="RailVirtualToggle" Style="{StaticResource RailButton}"
                                      Content="VIRT" Click="OnVirtualToggleClick"
                                      AutomationProperties.Name="Virtual device panel"
                                      ToolTip="Virtual devices: which buses are published to the ASIO ring"/>
                        <ToggleButton x:Name="RailDevicesToggle" Style="{StaticResource RailButton}"
                                      Content="DEV" Margin="0" Click="OnDevicesToggleClick"
                                      AutomationProperties.Name="Device pickers panel"
                                      ToolTip="Device pickers: monitor output and the physical endpoints"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= Dock column =================
                 One registered panel, on the rail's say-so. The host owns the width,
                 the splitter and the panel's lifetime; the window owns the windows it
                 pops out into (see OnPanelPoppedOut). -->
            <shell:DockPanelHost x:Name="PanelHost" Grid.Column="1" Margin="0"/>

            <!-- ================= Centre =================
                 Rows are the two things that never leave the surface (decks and their
                 transport, folders), then the document switcher, then the dock. -->
            <Grid Grid.Column="2" x:Name="CentreHost" Margin="6,0,6,0">
                <!-- The bottom band is ONE row shared by the documents panel and the
                     mixer dock, side by side. Stacked, the dock's 190 px came out of the
                     same band the documents had and left them a 151 px strip at 1400x900:
                     short enough that neither the queue nor a browser pane could show a
                     readable number of rows. Two columns in one band gives each panel the
                     band's full height, and the splitter lets the operator trade width. -->
                <!-- The bottom band belongs to the documents panel now: the mixer moved
                     to the dock column, so there is no width to trade and no splitter
                     between them. The CenterHost grid keeps its shape because every row
                     above still spans it; phase 5 removes the leftover 480 px card. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>                 <!-- decks, transport, crossfader -->
                    <RowDefinition x:Name="WaveformRow" Height="*" MinHeight="84"/>     <!-- waveforms -->
                    <RowDefinition Height="6"/>                                        <!-- splitter -->
                    <RowDefinition x:Name="DocumentsRow" Height="*" MinHeight="132"/>   <!-- documents -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>                  <!-- documents -->
                </Grid.ColumnDefinitions>

        <!-- ================= Deck block: decks / waveforms / crossfader / transport =================
             The deck cards hold controls only: the two waveforms live in one shared
             full-width strip directly below them (A over B), so the peaks read at
             the full width of the window and the two decks line up beat for beat.
             Every row here is Auto: the cards keep their natural height and the
             splitter below balances the whole block against the browser. -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- deck cards -->
                <RowDefinition Height="Auto"/>   <!-- transport -->
                <RowDefinition Height="Auto"/>   <!-- crossfader -->
            </Grid.RowDefinitions>

        <!-- ================= Decks ================= -->
        <!-- Three columns: a card, the mix EQ, a card. The middle column was a 12 px
             gutter until the EQ needed a home; it is 108 now - a 96 px panel plus the
             12 the gutter already gave, split 6/6 as the panel's margins - so the two
             cards lose 48 each and keep an even share. Measured, not guessed: at
             1518x900 the cards are 741 wide and the gutter 12; at 1040x880 the cards
             are 500 and the gutter still 12. A 12 px column cannot hold three faders
             at any orientation, which is why the column grew rather than the sliders
             shrinking to fit it. The faders stay horizontal because the shared slider
             style's tick bar (clickable marks, the recentre detent) is drawn along the
             groove; a vertical fader would need a second implementation of it. -->
        <Grid Grid.Row="0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding DeckA}"
                            PreviewMouseLeftButtonDown="OnDeckInteract"
                            ContentTemplate="{StaticResource DeckCardTemplate}">
                <ContentControl.Resources>
                    <SolidColorBrush x:Key="DeckAccent" Color="#00C8FF"/>
                    <!-- the cue button lights in this deck's own colour -->
                    <SolidColorBrush x:Key="DeckCueBrush" Color="#00C8FF"/>
                </ContentControl.Resources>
            </ContentControl>

            <ContentControl Grid.Column="2" Content="{Binding DeckB}"
                            PreviewMouseLeftButtonDown="OnDeckInteract"
                            ContentTemplate="{StaticResource DeckCardTemplate}">
                <ContentControl.Resources>
                    <SolidColorBrush x:Key="DeckAccent" Color="#FF3DAD"/>
                    <!-- the cue button lights in this deck's own colour -->
                    <SolidColorBrush x:Key="DeckCueBrush" Color="#FF3DAD"/>
                </ContentControl.Resources>
            </ContentControl>

            <!-- ================= Mix EQ =================
                 LOW / MID / HIGH in the column between the cards. The range is the
                 mixer's, not the engine's: a full cut or a full boost either way,
                 so -50…+50 with 0 dB as a true bypass and the middle of the track. Each band is a label and its readout on one line, the
                 shared fader under it, and the marks the fader can be clicked to.
                 Centred in the column so it sits between the cards' header and the
                 crossfader strip instead of crowding either. -->
        </Grid>


        <!-- ================= Crossfader =================
             One fader, equal-power curve: centre plays both decks at -3 dB, the
             ends isolate A and B. Per-deck volume still multiplies in.
             The snap buttons write the same bound property a drag does, so the
             fader moves (and a running crossfade ramp is cancelled) exactly as if
             a hand had grabbed it. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,2" Margin="0,6,0,0">
            <Border.Resources>
                <Style x:Key="CrossfaderSnapButton" TargetType="Button"
                       BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FontSize" Value="9"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>

            </Border.Resources>
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- The right-hand group (karaoke pill, mic, master) is about
                         575 px wide. Equal * side columns capped it at ~526 at a
                         1500 window and ~476 at 1400, and a right-aligned child
                         wider than its column is arranged past it, not clipped:
                         at 1500 the pill drew over the B snap button and read
                         "ARAOKE", at 1400 it fell out of the slot entirely.
                         Star plus a 665 floor pins the column to the group's
                         real width, so it can never overflow, and still lets it
                         grow with the card. The floor grew from 575 when the
                         "MIC 1" label became the microphone dropdown: 128 px of
                         combo where 40 px of text used to sit. Centring needs
                         2*665 + 384 = 1714 px of card (a ~1780 window); from
                         there up both stars stay equal and the fader is exactly
                         centred again, instead of drifting right the way an Auto
                         column did. Below it the min wins over the star split and
                         the left column gives up the difference: 49 px left of
                         card centre at 1580 becomes ~139 px at 1518, which is
                         still inside the column the crossfader sits in. -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <!-- Transition status: live state, not a control. Collapsed
                     whenever no transition is running. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsTransitioning, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                             Fill="{StaticResource AccentABrush}"/>
                    <TextBlock Text="{Binding TransitionText}" FontSize="10"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="230"
                               ToolTip="{Binding TransitionText}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentABrush}" Margin="0,0,10,0"/>
                        <Slider x:Name="CrossfaderSlider" Width="340" VerticalAlignment="Center"
                                Minimum="0" Maximum="1"
                                SmallChange="0.01" LargeChange="0.1"
                                Value="{Binding Crossfader, Mode=TwoWay}"
                                ToolTip="Crossfader: left = deck A, centre = both, right = deck B"/>
                        <TextBlock Text="B" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBBrush}" Margin="10,0,0,0"/>
                    </DockPanel>

                    <!-- Snaps on the fader's own 340 px track: A under its left end,
                         Centre under the middle, B under its right end. Keeping the
                         strip the slider's width is what stops the buttons from
                         widening the card and reflowing the fader. -->
                    <Grid Width="340" Margin="0,2,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Left"
                                Style="{StaticResource CrossfaderSnapButton}"
                                Content="A" Foreground="{StaticResource AccentABrush}"
                                Command="{Binding SnapCrossfaderACommand}"
                                AutomationProperties.Name="Crossfader A"
                                ToolTip="Deck A"/>
                        <Button Grid.Column="1" HorizontalAlignment="Center"
                                Style="{StaticResource CrossfaderSnapButton}"
                                Content="C"
                                Command="{Binding SnapCrossfaderCentreCommand}"
                                AutomationProperties.Name="Crossfader Centre"
                                ToolTip="Centre"/>
                        <Button Grid.Column="2" HorizontalAlignment="Right"
                                Style="{StaticResource CrossfaderSnapButton}"
                                Content="B" Foreground="{StaticResource AccentBBrush}"
                                Command="{Binding SnapCrossfaderBCommand}"
                                AutomationProperties.Name="Crossfader B"
                                ToolTip="Deck B"/>
                    </Grid>
                </StackPanel>

                <!-- Master level: deliberately smaller than the fader it sits
                     beside, because the crossfader is still the primary control. -->
                <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- Talk-over mic: app-domain gain (the Windows recording
                         level is never touched), a voice-only monitor send that
                         is off by default (open speakers + live mic = feedback)
                         and a mute that closes the voice without closing the
                         device. Fits on the master row, so the 1400x900 stack
                         does not grow a row. -->
                    <!-- The microphone picker, its gain and its peak meter used to
                         sit here and are now the strip rack in the SRC panel:
                         two pickers over one setting is how the two disagree, and
                         the strip is source configuration, not something pressed
                         mid-mix. MON and MUTE stay: they are the monitor gate. -->
                    <ToggleButton Style="{StaticResource MicToggle}" Width="34" Content="MON"
                                  Margin="0,0,4,0"
                                  IsChecked="{Binding MicMonitorEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Microphone monitor"
                                  ToolTip="Also send the voice to the monitor output. Headphones only: an open speaker plus a live mic feeds back."/>
                    <ToggleButton Style="{StaticResource MicToggle}" Width="38" Content="MUTE"
                                  Margin="0,0,12,0"
                                  IsChecked="{Binding MicMuted, Mode=TwoWay}"
                                  AutomationProperties.Name="Microphone mute"
                                  ToolTip="Mute the talk-over microphone"/>

                    <TextBlock Text="MASTER" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <Slider Width="130" VerticalAlignment="Center"
                            Minimum="0" Maximum="1.2"
                            SmallChange="0.01" LargeChange="0.1"
                            Value="{Binding MasterVolume, Mode=TwoWay}"
                            ToolTip="Master output: 100% = unity, up to 120%"/>
                    <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:0%}}"
                               FontFamily="Consolas" FontSize="10" Width="38"
                               Margin="7,0,4,0" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}"
                               ToolTip="Master output level"/>
                    <Button Content="&#x21BA;" Width="20" Height="18" Padding="0" FontSize="10"
                            Command="{Binding ResetMasterVolumeCommand}"
                            ToolTip="Reset master to 100%"/>
                    <!-- Panic lives on the surface, not in the dock: it is pressed in the
                         second something goes wrong, and a tab away is a second too far. -->
                    <Button Content="STOP ALL" Height="18" Padding="8,0" FontSize="9"
                            Margin="12,0,0,0"
                            Foreground="{StaticResource DangerBrush}"
                            Command="{Binding Soundboard.StopAllCommand}"
                            AutomationProperties.Name="Panic: silence every soundboard pad"
                            ToolTip="Panic. Silences every soundboard pad. The decks keep playing."/>
                </WrapPanel>
            </Grid>

            <!-- ================= Channel strips =================
                 The microphone's own surface, grown from the row above rather than opened as a
                 second window: the row picks the device and owns its gain, monitor send and
                 mute; the rack edits the strip that device runs through, pre-send. Strip
                 buttons stay visible the way a Wave Link channel column does; the controls band
                 belongs to the selected strip and collapses to a single row.

                 Every value is the engine's applied parameter, re-read at 2 Hz from
                 MicMixer.SnapshotStrips. Every write posts one render-queue action - the path
                 the HTTP API takes - so nothing here touches a filter from the UI thread.
                 Numbers sit in fixed-width right-aligned columns so a change never reflows the
                 row. Double-click a value or its fader to return it to neutral. -->
        </StackPanel>
        </Border>

        <!-- ================= Unified transport =================
             Order in the deck block is now: deck cards, this transport,
             crossfader/mic/master, waveforms. These act on the active deck (the
             deck the lyrics clock follows). -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Transport buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- One press restarts, a second press inside 450 ms steps back
                         a track. Two behaviours on one button, as on a CD deck. -->
                    <Button Style="{StaticResource TransportButton}" Content="&#x23EE;"
                            Margin="0,0,4,0" Click="OnPreviousPress"
                            ToolTip="Restart this track. Press again for the previous track."/>
                    <Button Style="{StaticResource TransportButton}" Content="&#x23EA;"
                            ToolTip="Rewind 10s on the active deck" Command="{Binding RewindCommand}"/>
                    <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Width="64"
                            Margin="6,0" FontSize="20" Command="{Binding PlayPauseCommand}"/>
                    <Button Style="{StaticResource TransportButton}" Content="&#x23F9;"
                            ToolTip="Stop the active deck" Command="{Binding StopCommand}"/>
                    <Button Style="{StaticResource TransportButton}" Content="&#x23E9;" Margin="6,0,0,0"
                            ToolTip="Fast forward 10s on the active deck" Command="{Binding FastForwardCommand}"/>
                </StackPanel>

                <!-- Position readout -->
                <TextBlock Grid.Column="1" Text="{Binding PositionText}" FontFamily="Consolas"
                           FontSize="16" VerticalAlignment="Center" Margin="18,0,10,0"/>

                <!-- Active deck seek bar -->
                <Slider x:Name="SeekBar" Grid.Column="2" VerticalAlignment="Center"
                        Minimum="0" Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"/>

                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontFamily="Consolas"
                           FontSize="16" VerticalAlignment="Center" Margin="10,0,18,0"
                           Foreground="{StaticResource TextDimBrush}"/>

                <!-- Pair cues, deck activation, link and sync switches -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Link and sync switches. Each carries a state glyph column
                         of fixed width, so engaged and disengaged differ by text
                         and weight as well as by tint, and nothing shifts sideways
                         when one is pressed. -->
                    <StackPanel.Resources>
                        <Style x:Key="SyncSwitch" TargetType="ToggleButton">
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="FontSize" Value="9"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="{TemplateBinding Padding}">
                                                <TextBlock x:Name="state" Text="" Width="12"
                                                           FontFamily="Consolas" FontSize="10"
                                                           VerticalAlignment="Center"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="state" Property="Text" Value="&#x2713;"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <!-- ================= Pair cue bank =================
                         The karaoke pair's own bank: one position, both decks, and it
                         lives in this row because a row of pads costs zero vertical
                         height here - the row is already 40 px tall for the transport
                         buttons, so the pads are 34 px inside a 36 px cluster. A new row
                         would have cost 40. It is a secondary bank and reads as one: the
                         same CuePad, the same dashed frame, a 34 px box against the 40 px
                         transport buttons, and it only exists while a pair is loaded,
                         because with one deck loaded the pads would be half a bank and
                         the deck's own bank already covers that.
                         Bindings mirror the deck bank (Pads / Press / ToggleClearMode)
                         so pressing, clear mode and the tooltips behave identically. -->

                    <Button Content="A" FontSize="10" Padding="8,3" Margin="0,0,4,0"
                            Command="{Binding SelectDeckACommand}"
                            ToolTip="Make deck A the active deck (seek bar + lyrics clock). Drops the A-B link.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Padding" Value="8,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAOnlySelected}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="B" Margin="0,0,4,0"
                            Command="{Binding SelectDeckBCommand}"
                            ToolTip="Make deck B the active deck (seek bar + lyrics clock). Drops the A-B link.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Padding" Value="8,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBOnlySelected}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- A-B link: transport commands address both decks. Wider and
                         bolder than the sync switches so the row reads as the link
                         plus three things that depend on it. -->
                    <ToggleButton Margin="4,0,0,0" MinWidth="52" Height="26"
                                  FontSize="10" Padding="8,2"
                                  IsChecked="{Binding IsABMode, Mode=TwoWay}"
                                  ToolTip="A-B link: play, seek, stop and volume act on both decks at once.&#10;While it is on, the small letter names the deck the seek bar and lyrics follow.">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource SyncSwitch}">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Padding" Value="8,2"/>
                                <Setter Property="Margin" Value="4,0,0,0"/>
                                <Setter Property="MinWidth" Value="52"/>
                            </Style>
                        </ToggleButton.Style>
                        <!-- With the link on, A and B both go dim, so the deck the
                             seek bar, position readout and lyric clock still follow
                             is named here instead: one small letter, dim, only while
                             the link is on. No extra control, no extra width. -->
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="A-B" FontWeight="Bold"/>
                                <TextBlock FontSize="8" Margin="3,1,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x203A;B"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsABMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeckAActive}" Value="True">
                                                    <Setter Property="Text" Value="&#x203A;A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <!-- Three switches that only mean anything with the link on, so
                         they are disabled otherwise instead of quietly doing nothing. -->
                    <Border Margin="6,0,8,0" Padding="6,0" CornerRadius="3"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SYNC" FontSize="8" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <ToggleButton Style="{StaticResource SyncSwitch}" Margin="0,0,4,0"
                                          Content="DECK" IsEnabled="{Binding IsSyncAvailable}"
                                          IsChecked="{Binding IsDeckSync, Mode=TwoWay}"
                                          ToolTip="Master/slave playhead: the active deck drives the other"/>
                            <ToggleButton Style="{StaticResource SyncSwitch}" Margin="0,0,4,0"
                                          Content="VOL" IsEnabled="{Binding IsSyncAvailable}"
                                          IsChecked="{Binding IsVolumeSync, Mode=TwoWay}"
                                          ToolTip="One fader move, both decks (needs the A-B link)"/>
                            <ToggleButton Style="{StaticResource SyncSwitch}"
                                          Content="TEMPO" IsEnabled="{Binding IsSyncAvailable}"
                                          IsChecked="{Binding IsTempoSync, Mode=TwoWay}"
                                          ToolTip="One tempo move, both decks (needs the A-B link)"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <!-- ================= Stacked waveforms =================
             One shared strip: deck A's waveform on top, deck B's directly under it,
             each full width with its own playhead and its karaoke sub-stem tucked
             beneath it. The canvases are the same control the deck cards used to
             hold - same Tag ("primary"/"karaoke"), same Loaded/SizeChanged handlers -
             so MainWindow.xaml.cs draws them exactly as before; only their parent
             and therefore their width changed. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,4" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>   <!-- deck A -->
                    <RowDefinition Height="*"/>   <!-- deck B -->
                </Grid.RowDefinitions>

                <!-- ===== Deck A ===== -->
                <Grid Grid.Row="0" DataContext="{Binding DeckA}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- Quiet bed so the peaks and the beat ticks read against
                             the panel instead of floating on it. -->
                        <Border CornerRadius="3" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10151D" Offset="0"/>
                                    <GradientStop Color="#0A0C10" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas x:Name="WaveformA" MinHeight="30" ClipToBounds="True" Tag="primary"
                                Cursor="Hand" Background="Transparent"
                                Loaded="OnDeckWaveformLoaded"
                                SizeChanged="OnDeckWaveformSizeChanged"
                                MouseLeftButtonDown="OnDeckWaveformMouseDown"
                                MouseMove="OnDeckWaveformMouseMove"
                                MouseLeftButtonUp="OnDeckWaveformMouseUp"
                                LostMouseCapture="OnDeckWaveformLostCapture"/>
                        <TextBlock Text="A" Margin="7,2,0,0" FontSize="11" FontWeight="Black"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Foreground="{StaticResource AccentABrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Bpm, StringFormat={}{0:0}}"
                                   Margin="0,3,7,0" FontSize="9" FontFamily="Consolas"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextDimBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- No tempo analysis, no number: the card's
                                             BPM readout already says "BPM —". -->
                                        <DataTrigger Binding="{Binding Bpm}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Canvas Grid.Row="1" x:Name="KaraokeWaveformA" Height="12" Margin="0,2,0,0"
                            ClipToBounds="True" Tag="karaoke"
                            Visibility="{Binding HasKaraoke, Converter={StaticResource BoolToVisibility}}"
                            Loaded="OnDeckWaveformLoaded"
                            SizeChanged="OnDeckWaveformSizeChanged"/>
                </Grid>

                <!-- ===== Deck B ===== -->
                <Grid Grid.Row="1" DataContext="{Binding DeckB}" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border CornerRadius="3" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10151D" Offset="0"/>
                                    <GradientStop Color="#0A0C10" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas x:Name="WaveformB" MinHeight="30" ClipToBounds="True" Tag="primary"
                                Cursor="Hand" Background="Transparent"
                                Loaded="OnDeckWaveformLoaded"
                                SizeChanged="OnDeckWaveformSizeChanged"
                                MouseLeftButtonDown="OnDeckWaveformMouseDown"
                                MouseMove="OnDeckWaveformMouseMove"
                                MouseLeftButtonUp="OnDeckWaveformMouseUp"
                                LostMouseCapture="OnDeckWaveformLostCapture"/>
                        <TextBlock Text="B" Margin="7,2,0,0" FontSize="11" FontWeight="Black"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Foreground="{StaticResource AccentBBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Bpm, StringFormat={}{0:0}}"
                                   Margin="0,3,7,0" FontSize="9" FontFamily="Consolas"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextDimBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Bpm}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Canvas Grid.Row="1" x:Name="KaraokeWaveformB" Height="12" Margin="0,2,0,0"
                            ClipToBounds="True" Tag="karaoke"
                            Visibility="{Binding HasKaraoke, Converter={StaticResource BoolToVisibility}}"
                            Loaded="OnDeckWaveformLoaded"
                            SizeChanged="OnDeckWaveformSizeChanged"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Splitter: balances the deck block against the browser -->
        <!-- Height matches the 6 px row it lives in; the style's 8 would overflow
             the row by a pixel at each end and sit on the card edges. -->
        <GridSplitter Grid.Row="2" Height="6" Style="{StaticResource RowSplitter}"/>

        <!-- ================= Browser + Lyrics ================= -->
        <!-- The browser row needs a definite height, and 480 is only the seed for the
             first pass. The shell measures its content at infinite height, and under
             that constraint a star row degrades to a content-sized one, which leaves the
             tab's track list with no viewport to virtualize against (it realizes a
             container for every row - 4 150 of them). The window replaces this with its
             viewport share (OnShellLayoutChanged); the seed is what keeps the very first
             pass, before a viewport exists, finite. -->
        <!-- ================= Centre documents =================
             What the operator switches between mid-set. The library tree and the queue
             are not documents any more: they left for the left pane, so a document gets
             the whole centre column instead of a 3:2 split. Lyrics is a document for the
             same reason Spotify is - it is a view, and it is read, not configured. -->
        <Grid Grid.Row="3" Grid.Column="0" x:Name="BrowserHost" MinHeight="150" Height="480">
            <Border Style="{StaticResource Card}" Padding="8">
                <TabControl x:Name="BrowserTabs" Style="{StaticResource BrowserTabControl}">
                <!-- Spotify, YouTube and Lyrics left this strip in phase 2: the first
                     two are LIB tabs now and lyrics is the LYRIC dock panel. The strip
                     itself stays (empty) until phase 3 puts the mixer here, because
                     the centre column's geometry is measured off this element. -->
                </TabControl>
            </Border>
        </Grid>


            <!-- ================= Retired flyout =================
                 ROUTE, SRC, VIRT and DEV were the four contents of this region; each
                 is a dock panel now (Views/RoutingPanel.xaml and friends), so nothing
                 renders here and nothing but this element itself is left. Phase 5
                 removes it with row 3, DocumentsRow and BrowserHost, which are
                 rewritten together. Kept until then because the row is measured and
                 a bare row deletion would move the centre column in this pass. -->
            <Border Grid.Row="3" x:Name="FlyoutPanel" HorizontalAlignment="Right"
                    VerticalAlignment="Stretch" Panel.ZIndex="20" Margin="0" Width="400"
                    Visibility="Collapsed"/>

            </Grid>

        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
