<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==========================================================================
         One right-click menu for every track list. The order is fixed:

             Play, Preview, Add to Queue, Add to Playlist, Download,
             Make Karaoke Version, Show in Explorer, Tags,
             Find on YouTube, Find on Spotify

         A surface never edits this file to drop an entry it cannot perform.
         Instead each host sets Tag to a vm:TrackMenuCapabilities object
         (code-behind, or MainViewModel.TrackMenu for the library) and every item
         shows only when that object carries a command for it. A null command
         means the item is removed, not greyed out, so the menu never offers a
         click that goes nowhere.

         "Add to Playlist" renders twice: as a submenu when the surface supplies
         playlist rows, as a single item when it only has a "add to the current
         playlist" gesture. Exactly one of the two is ever visible.
         ========================================================================== -->

    <BooleanToVisibilityConverter x:Key="MenuVisibility"/>

    <ContextMenu x:Key="TrackMenu" x:Shared="False"
                 AutomationProperties.Name="Track actions">

        <!-- 1. Play -->
        <MenuItem Header="Play"
                  Command="{Binding PlacementTarget.Tag.Play, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.ShowFlatPlay, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <!-- 1a. Play, one item per take the row actually has. A row with a single
             take keeps the flat item above and never sees this one, so nothing
             about a plain track's menu changes. The items are built from disk
             (TrackEntry.Variants), so a take that is not there is not offered. -->
        <MenuItem Header="Play"
                  ItemsSource="{Binding PlacementTarget.Tag.PlayVariants, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.ShowVariantPlay, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}">
            <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Header" Value="{Binding}"/>
                    <Setter Property="Command" Value="{Binding Command}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Header}"/>
                    <!-- Mark then name, drawn by a template rather than a
                         Setter.Value: a style setter holds one element and
                         shares it, so a UIElement there can only ever appear on
                         the last item. A template is built per item. -->
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Consolas"
                                               FontSize="13" Width="16"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Variant}"
                                                                 Value="Karaoke">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AccentABrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Header}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </MenuItem.ItemContainerStyle>
        </MenuItem>

        <!-- 2. Preview (stream) -->
        <MenuItem Header="Preview"
                  Command="{Binding PlacementTarget.Tag.Preview, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanPreview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <!-- 3. Add to Queue: local playback only, so remote tabs never show it.
             3a is the same split as Play: per-take items when the row has more
             than one, the flat item otherwise. -->
        <MenuItem Header="Add to Queue"
                  InputGestureText="Ctrl+Q"
                  Command="{Binding PlacementTarget.Tag.AddToQueue, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.ShowFlatQueue, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <MenuItem Header="Add to Queue"
                  ItemsSource="{Binding PlacementTarget.Tag.QueueVariants, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.ShowVariantQueue, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}">
            <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Header" Value="{Binding}"/>
                    <Setter Property="Command" Value="{Binding Command}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Header}"/>
                    <!-- Mark then name, drawn by a template rather than a
                         Setter.Value: a style setter holds one element and
                         shares it, so a UIElement there can only ever appear on
                         the last item. A template is built per item. -->
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Consolas"
                                               FontSize="13" Width="16"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Variant}"
                                                                 Value="Karaoke">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AccentABrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Header}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </MenuItem.ItemContainerStyle>
        </MenuItem>

        <!-- 4a. Add to Playlist, as a submenu of the user's playlists -->
        <MenuItem Header="Add to Playlist"
                  ItemsSource="{Binding PlacementTarget.Tag.PlaylistTargets, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanChoosePlaylist, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}">
            <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <!-- Each row carries its own ready-made command, so nothing here
                         has to reach back up the menu's visual tree. -->
                    <Setter Property="Header" Value="{Binding Name}"/>
                    <Setter Property="Command" Value="{Binding Command}"/>
                </Style>
            </MenuItem.ItemContainerStyle>
        </MenuItem>

        <!-- 4b. Add to Playlist, as one gesture, for surfaces without a playlist row list -->
        <MenuItem Header="Add to Playlist"
                  Command="{Binding PlacementTarget.Tag.AddToPlaylist, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanAddToPlaylistDirectly, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <!-- 5. Download -->
        <MenuItem Header="Download"
                  Command="{Binding PlacementTarget.Tag.Download, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanDownload, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <!-- 6a. Make Karaoke Version, as a submenu of the three stem modes. A
             library row can express all three; the remote tabs cannot, so they
             set one command and fall through to 6b instead. -->
        <MenuItem Header="Make Karaoke Version"
                  AutomationProperties.Name="Make Karaoke Version"
                  Visibility="{Binding PlacementTarget.Tag.CanChooseKaraokeMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}">
            <!-- Each mode reads the row the surface selected, so no
                 CommandParameter is needed here (see TrackMenuCapabilities). -->
            <MenuItem Header="Instrumental (all vocals out)"
                      Command="{Binding PlacementTarget.Tag.MakeKaraoke, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.Tag.CanMakeKaraoke, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>
            <MenuItem Header="Instrumental (keep backing vocals)"
                      Command="{Binding PlacementTarget.Tag.MakeKaraokeKeepBacking, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.Tag.CanMakeKaraokeKeepBacking, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>
            <MenuItem Header="Vocals only"
                      Command="{Binding PlacementTarget.Tag.MakeKaraokeVocalsOnly, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.Tag.CanMakeKaraokeVocalsOnly, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>
        </MenuItem>

        <!-- 6b. Make Karaoke Version, as one gesture, for surfaces with no mode choice -->
        <MenuItem Header="Make Karaoke Version"
                  AutomationProperties.Name="Make Karaoke Version"
                  Command="{Binding PlacementTarget.Tag.MakeKaraoke, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanMakeKaraokeDirectly, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <!-- 7. Show in Explorer: one verb everywhere -->
        <MenuItem Header="Show in Explorer"
                  Command="{Binding PlacementTarget.Tag.ShowInExplorer, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanShowInExplorer, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <!-- 8. Tags -->
        <MenuItem Header="Tags"
                  Command="{Binding PlacementTarget.Tag.Tags, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanEditTags, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <!-- 9. Find on YouTube -->
        <MenuItem Header="Find on YouTube"
                  Command="{Binding PlacementTarget.Tag.FindOnYouTube, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanFindOnYouTube, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>

        <!-- 10. Find on Spotify -->
        <MenuItem Header="Find on Spotify"
                  Command="{Binding PlacementTarget.Tag.FindOnSpotify, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  Visibility="{Binding PlacementTarget.Tag.CanFindOnSpotify, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MenuVisibility}}"/>
    </ContextMenu>

</ResourceDictionary>
