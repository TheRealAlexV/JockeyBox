<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lib="clr-namespace:JockeyBox.Library"
                    xmlns:vm="clr-namespace:JockeyBox.ViewModels">

    <!-- ==========================================================================
         One row design for every track list in the app: library tree, Spotify
         tracks, YouTube results.
         Column order is fixed: Name | Artist | BPM | Key | Length | Icons.
         The Icons column is one strip, not two slots: a mark per take this row
         actually has (see VariantGlyphs), in the fixed order
             ■ Original   ◆ Karaoke   ◐ Keep backing   ♪ Vocals only
         and nothing for a take it does not have. ◆ is the only accented mark:
         it answers "can I start this one now", the rest describe the row.
         Every mark carries a tooltip, so state is never carried by colour or
         fill alone. A scanned row with no file behind it shows an em dash.

         Why the layout lives here as styles plus thin per-type templates: the
         three lists bind to three different item types (BrowserNode, SourceTrack,
         YtEntry) with different property names. A DataTemplateSelector would add
         a class and three adapter objects for the same saving; instead every
         visual decision (row height, cell typography, trimming, badge slots,
         column widths) is a style in this file and each per-type template is a
         six-cell binding map. Nothing else in the row is written per surface.
         ========================================================================== -->

    <SolidColorBrush x:Key="SlotOffBrush" Color="#4A5160"/>

    <!-- ===== Row grid: one height for all three lists ===== -->
    <Style x:Key="TrackRowGrid" TargetType="Grid">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ===== Cells ===== -->
    <Style x:Key="TrackCell" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="TrackCellDim" TargetType="TextBlock" BasedOn="{StaticResource TrackCell}">
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
    </Style>

    <Style x:Key="TrackCellNum" TargetType="TextBlock" BasedOn="{StaticResource TrackCellDim}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="TrackTitle" TargetType="TextBlock" BasedOn="{StaticResource TrackCell}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===== Column headers: one instance per surface, same widths ===== -->
    <Style x:Key="TrackColumnHeader" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
    </Style>

    <Border x:Key="TrackColumnHeaders" x:Shared="False"
            Background="{DynamicResource PanelAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Height="26">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="76"/>
                <!-- Artist is the column that gives way: at 1518 the browser has
                     664 px and this sits at its 150 px natural width; at 1040 it
                     has 382 px for six columns, so Artist shrinks to 60 and the
                     Icons column stays on screen. Nothing to the right of it can
                     scroll (the tree disables horizontal scrolling), so an
                     overflowed badge strip is unreachable, not merely tight. -->
                <ColumnDefinition Width="0.5*" MinWidth="60" MaxWidth="150"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Track name" Style="{StaticResource TrackColumnHeader}"/>
            <TextBlock Grid.Column="1" Text="Artist" Style="{StaticResource TrackColumnHeader}"/>
            <TextBlock Grid.Column="2" Text="BPM" Style="{StaticResource TrackColumnHeader}"/>
            <TextBlock Grid.Column="3" Text="Key" Style="{StaticResource TrackColumnHeader}"/>
            <TextBlock Grid.Column="4" Text="Length" Style="{StaticResource TrackColumnHeader}"/>
            <TextBlock Grid.Column="5" Text="Icons" Style="{StaticResource TrackColumnHeader}"
                       TextAlignment="Center" Padding="0"/>
        </Grid>
    </Border>

    <!-- ===== Badge slots =====
         One slot is 14 px wide at 13 px Consolas: the glyph advances about
         7.2 px, so neighbours sit ~3.4 px apart with no explicit margin, and
         four slots come to 56 px. That is the size the Icons column is cut for.
         Default is the dim ink, for the marks that say "absent" (a hollow
         square or diamond); the strip sets the brighter ink per mark. -->
    <Style x:Key="BadgeSlot" TargetType="TextBlock">
        <Setter Property="Width" Value="14"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- ================= Library row ================= -->
    <HierarchicalDataTemplate x:Key="LibraryNodeRow" DataType="{x:Type lib:BrowserNode}"
                              ItemsSource="{Binding Children}">
        <Grid Style="{StaticResource TrackRowGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="76"/>
                <!-- Artist is the column that gives way: at 1518 the browser has
                     664 px and this sits at its 150 px natural width; at 1040 it
                     has 382 px for six columns, so Artist shrinks to 60 and the
                     Icons column stays on screen. Nothing to the right of it can
                     scroll (the tree disables horizontal scrolling), so an
                     overflowed badge strip is unreachable, not merely tight. -->
                <ColumnDefinition Width="0.5*" MinWidth="60" MaxWidth="150"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource TrackTitle}"
                       Text="{Binding Name}" ToolTip="{Binding PathText}"/>

            <!-- Leaf: artist. Folder rows show their track count instead. -->
            <TextBlock Grid.Column="1" Text="{Binding Track.Artist}" ToolTip="{Binding Track.Artist}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TrackCellDim}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="1" Text="{Binding CountText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TrackCellDim}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- BPM | Key | Length | Icons: hidden on folder rows -->
            <Grid Grid.Column="2" Grid.ColumnSpan="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource TrackCellNum}"
                           Text="{Binding Track.BpmText}"/>
                <!-- No musical key on the model yet: shows an em dash until it lands. -->
                <TextBlock Grid.Column="1" Style="{StaticResource TrackCellNum}"
                           Text="{Binding Track.KeyText}"
                           ToolTip="Musical key: ~ marks a key estimated from the audio, not tagged"/>
                <TextBlock Grid.Column="2" Style="{StaticResource TrackCellNum}"
                           Text="{Binding Track.DurationText}"/>

                <!-- The whole icon column is the variant strip: one mark per
                     take that exists, in the model's stable order (Original,
                     Karaoke, Backing, Vocals). It replaced a two-slot statement
                     (square = local file, diamond = karaoke yes/no), because on a
                     scanned row the Original mark IS the local-file mark and the
                     absence of a Karaoke mark IS "no karaoke". Four marks is the
                     ceiling, so the column is 56 px of slot in 60 px. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Track.Variants.Present}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock ToolTip="{Binding Label}"
                                           AutomationProperties.Name="{Binding Label}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource BadgeSlot}">
                                            <Setter Property="Text" Value="{Binding Icon}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Variant}"
                                                             Value="Karaoke">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AccentABrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Scanned row with no file behind it: no take to draw, so
                         say "nothing here" rather than leave the cell blank and
                         look like a row nobody has looked at yet. -->
                    <TextBlock Text="{x:Static lib:VariantGlyphs.Absent}"
                               ToolTip="No audio file found for this track"
                               AutomationProperties.Name="No audio file found">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeSlot}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Track.Variants.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </HierarchicalDataTemplate>

    <!-- ================= Remote track row (Spotify + YouTube playlists) ================= -->
    <DataTemplate x:Key="RemoteTrackRow">
        <Grid Style="{StaticResource TrackRowGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="76"/>
                <!-- Artist is the column that gives way: at 1518 the browser has
                     664 px and this sits at its 150 px natural width; at 1040 it
                     has 382 px for six columns, so Artist shrinks to 60 and the
                     Icons column stays on screen. Nothing to the right of it can
                     scroll (the tree disables horizontal scrolling), so an
                     overflowed badge strip is unreachable, not merely tight. -->
                <ColumnDefinition Width="0.5*" MinWidth="60" MaxWidth="150"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource TrackTitle}"
                       Text="{Binding Title}" ToolTip="{Binding Title}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TrackCellDim}"
                       Text="{Binding Artist}" ToolTip="{Binding Artist}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource TrackCellNum}"
                       Text="{Binding Bpm, TargetNullValue=—, FallbackValue=—}"/>
            <TextBlock Grid.Column="3" Style="{StaticResource TrackCellNum}"
                       Text="{Binding KeyText}"
                       ToolTip="Musical key: ~ marks a key estimated from the audio, not tagged"/>
            <TextBlock Grid.Column="4" Style="{StaticResource TrackCellNum}"
                       Text="{Binding DurationText}" ToolTip="{Binding DurationText}"/>

            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeSlot}">
                            <Setter Property="Text" Value="■"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="ToolTip" Value="Local file in the library"/>
                            <Setter Property="AutomationProperties.Name" Value="Local file in the library"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LocalEntry}" Value="{x:Null}">
                                    <Setter Property="Text" Value="□"/>
                                    <Setter Property="Foreground" Value="{StaticResource SlotOffBrush}"/>
                                    <Setter Property="ToolTip" Value="Not in the local library"/>
                                    <Setter Property="AutomationProperties.Name" Value="Not in the local library"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeSlot}">
                            <Setter Property="Text" Value="◇"/>
                            <Setter Property="ToolTip" Value="No karaoke version"/>
                            <Setter Property="AutomationProperties.Name" Value="No karaoke version"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasKaraoke}" Value="True">
                                    <Setter Property="Text" Value="◆"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentABrush}"/>
                                    <Setter Property="ToolTip" Value="Karaoke version ready"/>
                                    <Setter Property="AutomationProperties.Name" Value="Karaoke version ready"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ================= YouTube search result row ================= -->
    <DataTemplate x:Key="YouTubeResultRow">
        <Grid Style="{StaticResource TrackRowGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="76"/>
                <!-- Artist is the column that gives way: at 1518 the browser has
                     664 px and this sits at its 150 px natural width; at 1040 it
                     has 382 px for six columns, so Artist shrinks to 60 and the
                     Icons column stays on screen. Nothing to the right of it can
                     scroll (the tree disables horizontal scrolling), so an
                     overflowed badge strip is unreachable, not merely tight. -->
                <ColumnDefinition Width="0.5*" MinWidth="60" MaxWidth="150"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource TrackTitle}"
                       Text="{Binding Title}" ToolTip="{Binding Title}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TrackCellDim}"
                       Text="{Binding Uploader}" ToolTip="{Binding Uploader}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource TrackCellNum}" Text="—"/>
            <TextBlock Grid.Column="3" Style="{StaticResource TrackCellNum}"
                       Text="{x:Static lib:KeyNotation.NoKey}" ToolTip="Musical key"/>
            <TextBlock Grid.Column="4" Style="{StaticResource TrackCellNum}"
                       Text="{Binding Duration, StringFormat={}{0:m\:ss}}"/>

            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource BadgeSlot}" Text="□"
                           ToolTip="Not in the local library"
                           AutomationProperties.Name="Not in the local library"/>
                <TextBlock Style="{StaticResource BadgeSlot}" Text="◇"
                           ToolTip="No karaoke version"
                           AutomationProperties.Name="No karaoke version"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ==========================================================================
         Filter + sort strip. One row, no panel: filter box, sort field, direction.
         Its DataContext is a vm:TrackListView, which holds the chosen filter text,
         the sort field and the direction. Hosts supply callbacks when the list
         already has a filter of its own, so this strip drives the real list.
         ========================================================================== -->
    <Style x:Key="StripLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
    </Style>

    <!-- The strip's three controls were the only untemplated ones in the window:
         a keyed Style with no BasedOn replaces the theme's implicit style, so the
         filter box, the sort combo and the order button rendered with default
         Windows chrome (white field, classic Win32 arrow) next to dark ones. Each
         now derives from its theme style and only overrides size and padding, so
         they take PanelAltBrush fill, BorderBrush 1px and TextBrush text exactly
         like the deck OUTPUT combos and DELAY MS fields.
         22 px is the height the review measured on the old native box; it also
         matches the 10/6,3 buttons beside them in the same row. MinHeight has to
         be pinned at 22 as well, because the theme floors TextBox and ComboBox at
         MinHeight 32 and MinHeight beats Height in measure. -->
    <Style x:Key="StripFilterBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StripSortCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Width" Value="118"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- MinWidth is what stops this collapsing to a sliver when the row is tight:
         the label is a single glyph pair, so without a floor the button had no
         width of its own. -->
    <Style x:Key="StripDirectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="MinWidth" Value="38"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <DataTemplate x:Key="FilterSortStrip">
        <!-- Grid, not StackPanel: the filter box takes the row's slack (a
             StackPanel gives every child its desired width, so the box could
             only ever be its fixed 210). FILTER and SORT keep Auto. In an
             auto-sized host the star column falls back to the box's MinWidth. -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="FILTER" Style="{StaticResource StripLabel}"
                       Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" Style="{StaticResource StripFilterBox}"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding FilterHint}"
                     AutomationProperties.Name="{Binding FilterHint}"/>

            <TextBlock Grid.Column="2" Text="SORT" Style="{StaticResource StripLabel}"
                       Margin="10,0,6,0"/>
            <ComboBox Grid.Column="3" Style="{StaticResource StripSortCombo}"
                      ItemsSource="{Binding SortChoices}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SortField, Mode=TwoWay}"
                      AutomationProperties.Name="Sort by"
                      ToolTip="Sort field"/>
            <Button Grid.Column="4" Style="{StaticResource StripDirectionButton}"
                    Content="{Binding DirectionLabel}"
                    Command="{Binding ToggleDirectionCommand}"
                    ToolTip="{Binding DirectionToolTip}"
                    AutomationProperties.Name="Sort direction"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
