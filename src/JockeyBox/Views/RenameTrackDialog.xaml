<Window x:Class="JockeyBox.Views.RenameTrackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename track" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <!-- Pink accent: the dialog's primary action. Same as the other dialogs. -->
        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBBrush}"/>
            <Setter Property="Foreground" Value="#12141A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="16" Padding="18">
        <StackPanel>
            <TextBlock Text="Rename track" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="CURRENT FILE" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="CurrentFileLine" Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
            <TextBlock x:Name="CurrentFolderLine" Foreground="{StaticResource TextDimBrush}"
                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

            <TextBlock Text="NEW NAME" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Grid.Column="0" TextChanged="OnNameChanged"/>
                <TextBox x:Name="ExtensionBox" Grid.Column="1" IsReadOnly="True" IsTabStop="False"
                         MinWidth="70" Margin="8,0,0,0"
                         Foreground="{StaticResource TextDimBrush}"/>
            </Grid>
            <TextBlock Text="The extension is kept from the file; sidecars (.lrc, cover) follow the new name."
                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>

            <TextBlock x:Name="ValidationLine" TextWrapping="Wrap" MinHeight="18"
                       Margin="0,6,0,0" Foreground="{StaticResource AccentBBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
                <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="OnOk"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
