<Window x:Class="JockeyBox.Views.SpotifySetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Spotify" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LinkText" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pink accent: primary action of the dialog. -->
        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBBrush}"/>
            <Setter Property="Foreground" Value="#12141A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4" Margin="16" Padding="18">
        <StackPanel>
            <TextBlock Text="Connect Spotify" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                       Margin="0,0,0,16"
                       Text="Playlist import needs a Spotify app of your own. Spotify's built-in app cannot grant playlist access. This takes about two minutes."/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEP 1" Style="{StaticResource StepLabel}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource StepText}"
                           Text="Create an app at developer.spotify.com/dashboard"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEP 2" Style="{StaticResource StepLabel}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource StepText}">
                    <Run Text="Add redirect URI "/><Run Text="{Binding RedirectUri, Mode=OneWay}"
                         FontFamily="Consolas" Foreground="{StaticResource AccentABrush}"/><Run Text=" in the app's settings"/>
                </TextBlock>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEP 3" Style="{StaticResource StepLabel}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource StepText}"
                           Text="Paste the app's Client ID here and press Connect"/>
            </Grid>

            <TextBlock Text="CLIENT ID" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="ClientIdBox" Margin="0,2,0,0"
                     Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock x:Name="StatusLine" TextWrapping="Wrap" MinHeight="18"
                       Margin="0,10,0,0" Foreground="{StaticResource TextDimBrush}"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenDashboardButton" Grid.Column="0" Content="Open dashboard"
                        Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Click="OnOpenDashboard"/>
                <Button Grid.Column="1" Content="Cancel" MinWidth="90" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button x:Name="ConnectButton" Grid.Column="2" Content="Connect"
                        Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConnect"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
