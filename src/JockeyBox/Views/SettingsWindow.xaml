<Window x:Class="JockeyBox.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="720" Width="660" ResizeMode="CanResize"
        MinHeight="420" MinWidth="560"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Device-row Mute/Monitor pill. Same recipe as the main window's MUTE/MON
             toggles (MicToggle): dark fill + dim border when off, accent fill and
             dark label when on. That "on" fill is the only thing telling a muted
             device from an unmuted one and a monitored one from an unmonitored
             one, so it must stay. Default ToggleButton chrome was rendering these
             white-on-white. -->
        <Style x:Key="MicPill" TargetType="ToggleButton">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <!-- The caption is a TextBlock with its own Foreground, not a
                                 ContentPresenter: a presenter's TextElement.Foreground does
                                 not follow this style's triggers, so the lit state used to
                                 paint light text on the cyan fill (1.6:1). -->
                            <TextBlock x:Name="label" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentABrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                <Setter TargetName="label" Property="Foreground" Value="{StaticResource WindowBrush}"/>
                            </Trigger>
                            <!-- A row that is not recording is dimmed with a dim *ink*,
                                 not by fading the whole pill: an opacity blend over the
                                 panel turned the caption into 3.3:1 grey. TextDim is
                                 5.2:1 on this fill and still reads as secondary next to
                                 the 7.6:1 enabled rows. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#262B35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Device-row enable box. Both row states share this one template: the
             rows are built in code, so without an explicit style the WPF default
             checkbox drew a solid white 12x11 block on the AVAILABLE rows while
             the ENABLED rows (same control, ticked) drew dark. One look, one
             hit target, and it follows the panel palette. -->
        <Style x:Key="MicCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="14" Height="14" CornerRadius="3"
                                Background="#212121" BorderBrush="#3D4553" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Path x:Name="tick" Data="M3.2,7.3 L5.9,10 L10.8,4.3"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#5A6578"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="box" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageContent">

                <!-- ================= AUDIO ROUTING ================= -->
                <TextBlock Text="AUDIO ROUTING" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Main output"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               ToolTip="Deck audio only, no microphones or soundboard. Karaoke mode sends the karaoke stem here."/>
                    <ComboBox x:Name="MainOutputBox"
                              AutomationProperties.Name="Main output" AutomationProperties.AutomationId="MainOutputBox" Grid.Column="1" Margin="0,4"
                              Width="300" HorizontalAlignment="Left"
                              ToolTip="Deck audio only, no microphones or soundboard. Karaoke mode sends the karaoke stem here."/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Karaoke aid output"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               ToolTip="The original vocal stem while Karaoke mode is on — set this to the operator's headphones."/>
                    <ComboBox x:Name="KaraokeAidOutputBox"
                              AutomationProperties.Name="Karaoke aid output" AutomationProperties.AutomationId="KaraokeAidOutputBox" Grid.Column="1" Margin="0,4"
                              Width="300" HorizontalAlignment="Left"
                              ToolTip="The original vocal stem while Karaoke mode is on — set this to the operator's headphones."/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Recording device output"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               ToolTip="Every unmuted recording device."/>
                    <ComboBox x:Name="RecordingOutputBox"
                              AutomationProperties.Name="Recording device output" AutomationProperties.AutomationId="RecordingOutputBox" Grid.Column="1" Margin="0,4"
                              Width="300" HorizontalAlignment="Left"
                              ToolTip="Every unmuted recording device."/>
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Soundboard output"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               ToolTip="The soundboard."/>
                    <ComboBox x:Name="SoundboardOutputBox"
                              AutomationProperties.Name="Soundboard output" AutomationProperties.AutomationId="SoundboardOutputBox" Grid.Column="1" Margin="0,4"
                              Width="300" HorizontalAlignment="Left"
                              ToolTip="The soundboard."/>
                </Grid>

                <CheckBox x:Name="SoundboardFollowsMainCheck"
                          AutomationProperties.Name="Play the soundboard on Main when it has no output of its own" AutomationProperties.AutomationId="SoundboardFollowsMainCheck" Margin="150,2,0,8"
                          Foreground="{StaticResource TextBrush}"
                          ToolTip="When the soundboard has no output of its own, mix it into Main instead of leaving it silent.">
                    <TextBlock TextWrapping="Wrap" MaxWidth="420"
                               Text="Play the soundboard on Main when it has no output of its own"/>
                </CheckBox>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Monitoring device output"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               ToolTip="Only recording devices with Monitor on. Never heard by the audience."/>
                    <ComboBox x:Name="MonitorOutputBox"
                              AutomationProperties.Name="Monitoring device output" AutomationProperties.AutomationId="MonitorOutputBox" Grid.Column="1" Margin="0,4"
                              Width="300" HorizontalAlignment="Left"
                              ToolTip="Only recording devices with Monitor on. Never heard by the audience."/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Master mix bridge (as microphone)"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               ToolTip="Main + unmuted microphones + soundboard, for other applications to record. Route it to a virtual cable and use the cable's capture side."/>
                    <ComboBox x:Name="BridgeOutputBox"
                              AutomationProperties.Name="Master mix bridge (as microphone)" AutomationProperties.AutomationId="BridgeOutputBox" Grid.Column="1" Margin="0,4"
                              Width="300" HorizontalAlignment="Left" VerticalAlignment="Top"
                              ToolTip="Main + unmuted microphones + soundboard, for other applications to record. Route it to a virtual cable and use the cable's capture side."/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                           Margin="150,0,0,14"
                           Text="Every output can be set to None. The monitoring and karaoke-aid buses are operator cues and are not delayed; the audience buses carry the output delay."/>

                <!-- ========== MICROPHONES / RECORDING DEVICES ========== -->
                <TextBlock Text="MICROPHONES / RECORDING DEVICES" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,2"/>

                <Border x:Name="MicListPanelBorder"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="2" Margin="0,0,0,3"
                        MaxHeight="201">
                    <!-- The list scrolls inside this panel, and only here: the bar is
                         hidden and the wheel steps whole rows, so the page keeps the
                         single visible scrollbar it had. FitMicList caps this box at the
                         height of a whole number of rows, so the panel's bottom edge
                         falls between rows and can never cut one; a shorter device list
                         still sizes to its content.
                         With no bar, the fade below is the only sign that rows continue
                         past the edge. Code turns it on, and only while there is more to
                         reach, so a complete list shows no affordance at all. -->
                    <Grid>
                        <ScrollViewer x:Name="MicListScroll" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      PreviewMouseWheel="MicListScroll_PreviewMouseWheel"
                                      ScrollChanged="MicListScroll_ScrollChanged">
                            <StackPanel x:Name="MicListPanel" Margin="6,2,6,2"/>
                        </ScrollViewer>

                        <!-- Over the slack band at the panel's foot, so it never covers a
                             row: the panel is capped to whole rows, so that band is the
                             same height at every scroll offset. A soft scrim plus a
                             chevron that appears only while rows remain below — the list
                             is otherwise silent about them, because its own bar is hidden
                             to keep the page's the only scrollbar in the frame. Never
                             takes a click or a wheel notch. -->
                        <Border x:Name="MicListFade" Height="22" VerticalAlignment="Bottom"
                                IsHitTestVisible="False" Visibility="Collapsed"
                                CornerRadius="0,0,3,3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00171A1F" Offset="0"/>
                                    <GradientStop Color="#B3171A1F" Offset="0.55"/>
                                    <GradientStop Color="#FF171A1F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#x25BE;" FontSize="8"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="more" FontSize="9"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,2,0,14"
                           Text="Volume is applied inside JockeyBox; the Windows recording level is never changed."/>

                <!-- ================= OUTPUT DELAY ================= -->
                <TextBlock Text="OUTPUT DELAY" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Global output delay (ms)"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               ToolTip="0 to 2000 ms. The usual fix for audio that arrives before the video."/>
                    <TextBox x:Name="OutputDelayBox" Grid.Column="1" Margin="0,4"
                             Width="120" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                           Margin="150,0,0,14"
                           Text="Delays program audio to line up with camera video in OBS. The monitor output and the on-screen lyrics are not delayed."/>

                <!-- ================= TEMPO ================= -->
                <TextBlock Text="TEMPO" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tempo slider range (&#xB1;%)"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               ToolTip="1 to 50%. How far a deck's tempo slider can push a track away from its own BPM."/>
                    <TextBox x:Name="TempoRangeBox" Grid.Column="1" Margin="0,4"
                             Width="120" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,2,0,14"
                           Text="How far the deck tempo sliders can push a track from its own BPM. The centre of the slider is always the track's original speed."/>

                <!-- ================= AUTOMATIC MIXING ================= -->
                <TextBlock Text="AUTOMATIC MIXING" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Transition style" VerticalAlignment="Center"
                               ToolTip="What happens when a queued track takes over from the one playing."/>
                    <ComboBox x:Name="TransitionModeBox" Grid.Column="1" Margin="0,4"
                              Width="300" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Fade length (s)" VerticalAlignment="Center"
                               ToolTip="0.2 to 30 seconds. Tracks with very different tempos get a shorter fade."/>
                    <TextBox x:Name="TransitionFadeBox" Grid.Column="1" Margin="0,4"
                             Width="120" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,2,0,14"
                           Text="Applied when a queued track takes over. Auto-mix needs a beat grid for both tracks, and falls back to a crossfade when the tempos are too far apart."/>

                <!-- ================= LIBRARY FOLDERS ================= -->
                <TextBlock Text="LIBRARY FOLDERS" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Music folder" VerticalAlignment="Center"
                               ToolTip="Your full library (originals with vocals) - plays on Deck B"/>
                    <TextBox x:Name="MusicDirBox" Grid.Column="1" Margin="0,4"/>
                    <Button Grid.Column="2" Content="Browse&#x2026;" Width="80" Margin="6,4,0,4" Click="OnBrowseMusic"/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,14"
                           Text="One library root. Karaoke stems are written next to their original as &quot;Song.karaoke.ext&quot;, so they appear in the same list as the track they belong to."/>

                <!-- ================= VOCAL REMOVAL ENGINE ================= -->
                <TextBlock Text="VOCAL REMOVAL ENGINE (UVR)" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Python (optional)" VerticalAlignment="Center"
                               ToolTip="Explicit python.exe used to build the engine environment. Leave empty to auto-detect."/>
                    <TextBox x:Name="PythonBox" Grid.Column="1" Margin="0,4"/>
                </Grid>

                <CheckBox x:Name="GpuCheck" Margin="150,4,0,4" Content="Use NVIDIA GPU (CUDA) build"
                          Foreground="{StaticResource TextBrush}"
                          ToolTip="Much faster, but the install is ~3 GB and requires NVIDIA CUDA 12 with cuDNN 9 installed."/>

                <StackPanel Orientation="Horizontal" Margin="150,4,0,4">
                    <Button x:Name="InstallEngineButton" Content="Install / Reinstall Engine&#x2026;" Width="200" Click="OnInstallEngine"/>
                    <TextBlock x:Name="EngineStateText" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,14"
                           Text="The engine runs Ultimate Vocal Remover models through audio-separator in a private Python environment (%APPDATA%\JockeyBox). Requires Python 3.10-3.13 installed on this PC."/>

                <!-- ================= LYRICS ================= -->
                <TextBlock Text="LYRICS INTEGRATION" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Lyrics API URL (optional)" VerticalAlignment="Center"
                               ToolTip="Self-hosted spotify-lyrics-api (with SP_DC cookie). Optional — OAuth login below works without it."/>
                    <TextBox x:Name="ApiUrlBox" Grid.Column="1" Margin="0,4"/>
                </Grid>

                <StackPanel Margin="150,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SpotifyLoginButton" Content="Login with Spotify"
                                Width="160" Click="OnSpotifyLoginClick"/>
                        <Button x:Name="SpotifySetupButton" Content="Set up playlist access"
                                Width="170" Margin="8,0,0,0" Click="OnSpotifySetupClick"/>
                    </StackPanel>
                    <TextBlock x:Name="SpotifyStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"
                               Text="Login opens your browser for a one-time sign-in. Playlist import needs your own Spotify app - use Set up playlist access."/>
                </StackPanel>

                <Grid Margin="150,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Spotify Client ID (optional)" VerticalAlignment="Center"
                               ToolTip="Only needed if you run your own Spotify developer app."/>
                    <TextBox x:Name="SpotifyClientIdBox" Grid.Column="1" Margin="0,4"/>
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="300,0,0,14"
                           Text="Leave empty to use the built-in public client."/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Lyrics offset (ms)" VerticalAlignment="Center"
                               ToolTip="Shifts lyric highlighting relative to the master clock. Positive = lyrics later."/>
                    <TextBox x:Name="OffsetBox" Grid.Column="1" Margin="0,4" Width="120" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,4"
                           Text="Leave empty to use LRCLIB only (free, no setup). A .lrc file next to the audio file always wins."/>

                <!-- ================= DOWNLOADS &amp; YOUTUBE ================= -->
                <TextBlock Text="DOWNLOADS &amp; YOUTUBE" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Folder layout" VerticalAlignment="Center"
                               ToolTip="How downloaded files are arranged inside the Music folder."/>
                    <ComboBox x:Name="LayoutPresetBox" Grid.Column="1" Margin="0,4" Width="220"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="Artist / Album / Track" Tag="artist-album"/>
                        <ComboBoxItem Content="Artist / Track" Tag="artist"/>
                        <ComboBoxItem Content="Playlist / Artist - Track" Tag="playlist"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Custom template" VerticalAlignment="Center"
                               ToolTip="Overrides the folder layout above. Leave empty to use the preset."/>
                    <TextBox x:Name="LayoutTemplateBox" Grid.Column="1" Margin="0,4"
                             ToolTip="Example: {artist}/{album}/{track} {title}"/>
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="150,0,0,8"
                           Text="Tokens: {artist} {title} {album} {track} {playlist} {source}"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MP3 bitrate" VerticalAlignment="Center"
                               ToolTip="128-320 kbps transcode to MP3, or keep the original m4a stream."/>
                    <ComboBox x:Name="BitrateBox" Grid.Column="1" Margin="0,4" Width="170"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="128 kbps" Tag="128"/>
                        <ComboBoxItem Content="192 kbps" Tag="192"/>
                        <ComboBoxItem Content="256 kbps" Tag="256"/>
                        <ComboBoxItem Content="320 kbps" Tag="320"/>
                        <ComboBoxItem Content="Copy original (m4a)" Tag="0"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Concurrent downloads" VerticalAlignment="Center"
                               ToolTip="How many files download at the same time."/>
                    <ComboBox x:Name="ConcurrencyBox" Grid.Column="1" Margin="0,4" Width="80"
                              HorizontalAlignment="Left"/>
                </Grid>

                <CheckBox x:Name="SkipExistingCheck" Margin="150,4,0,4"
                          Content="Skip tracks already in the library"
                          Foreground="{StaticResource TextBrush}"/>

                <CheckBox x:Name="AutoKaraokeCheck" Margin="150,0,0,10"
                          Content="Also generate karaoke versions after a batch"
                          Foreground="{StaticResource TextBrush}"
                          ToolTip="Runs the vocal removal engine on every downloaded track once the queue finishes."/>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Browser cookies" VerticalAlignment="Center"
                               ToolTip="Lets yt-dlp read your browser session to get past YouTube's bot check."/>
                    <ComboBox x:Name="CookiesBox" Grid.Column="1" Margin="0,4" Width="150"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="None" Tag=""/>
                        <ComboBoxItem Content="Chrome" Tag="chrome"/>
                        <ComboBoxItem Content="Edge" Tag="edge"/>
                        <ComboBoxItem Content="Firefox" Tag="firefox"/>
                    </ComboBox>
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="150,0,0,10"
                           Text="YouTube sometimes answers automated downloads with &quot;confirm you're not a bot&quot;. Picking the browser you are signed in with lets yt-dlp reuse that session."/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Stream cache size" VerticalAlignment="Center"
                               ToolTip="Space reserved for throwaway copies of streamed tracks. Cleared from the ACTIVITY strip's DOWNLOADS tab."/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="CacheBox" Margin="0,4" Width="120"/>
                        <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,4,0,0"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Auto-sync playlists" VerticalAlignment="Center"
                               ToolTip="Re-reads imported Spotify and YouTube playlists on a timer and queues tracks added upstream."/>
                    <ComboBox x:Name="AutoSyncBox" Margin="0,4" Width="120"/>
                </Grid>

                <!-- ================= TOOLS (YT-DLP & FFMPEG) ================= -->
                <TextBlock Text="TOOLS (YT-DLP &amp; FFMPEG)" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="yt-dlp path" VerticalAlignment="Center"
                               ToolTip="Explicit yt-dlp.exe. Leave empty to use the bundled copy."/>
                    <TextBox x:Name="YtDlpPathBox" Grid.Column="1" Margin="0,4"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ffmpeg path" VerticalAlignment="Center"
                               ToolTip="Explicit ffmpeg.exe. Leave empty to use the bundled copy."/>
                    <TextBox x:Name="FfmpegPathBox" Grid.Column="1" Margin="0,4"/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="150,0,0,6"
                           Text="Empty means bundled: the app downloads both tools into %APPDATA%\JockeyBox\tools on first use. Versions are shown in the ACTIVITY strip's DOWNLOADS tab, which also has the install and update buttons."/>

                <StackPanel Orientation="Horizontal" Margin="150,0,0,14">
                    <Button x:Name="InstallToolsButton" Content="Install tools" Width="110"
                            Click="OnInstallTools"/>
                    <Button x:Name="UpdateYtDlpButton" Content="Update yt-dlp" Width="110"
                            Margin="8,0,0,0" Click="OnUpdateYtDlp"/>
                    <TextBlock x:Name="ToolsStatusText" VerticalAlignment="Center" Margin="10,0,0,0"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>

                <!-- ================= LIBRARY TOOLS ================= -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Margin="0,0,0,14"/>

                <TextBlock Text="LIBRARY TOOLS" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentABrush}" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="FindDuplicatesButton" Content="Find duplicates" Width="130"
                            FontSize="11" Padding="8,4" Click="OnFindDuplicatesClick"
                            ToolTip="Groups library files that share an artist and title, or a title"/>
                    <Button x:Name="ImportCsvButton" Content="Import Exportify CSV&#x2026;" Width="170"
                            FontSize="11" Padding="8,4" Margin="8,0,0,0" Click="OnImportCsvClick"
                            ToolTip="Adds the playlist from an Exportify .csv export"/>
                    <Button x:Name="ExportJsonButton" Content="Export library JSON&#x2026;" Width="170"
                            FontSize="11" Padding="8,4" Margin="8,0,0,0" Click="OnExportJsonClick"
                            ToolTip="Writes tracks and playlists to one JSON document"/>
                </StackPanel>

                <TextBlock x:Name="LibraryToolsStatusText" Margin="0,0,0,14" FontSize="11"
                           TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                           Text="Read-only scan of the loaded library. Audio files are never moved, renamed or deleted."/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Save" Width="90" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
