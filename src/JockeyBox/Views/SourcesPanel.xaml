<UserControl x:Class="JockeyBox.Views.SourcesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- The selected strip's own stages, in signal order: EQ, band limits, gate, comp,
         de-esser, limiter and the reverb send.
         This band used to fold out over the mixer, covering the deck controls it
         was configuring; in a panel beside the mix it can stay open while the
         operator listens.

         An independent XAML root: every key it names resolves from app scope
         (Themes/Dark.xaml) plus whatever it merges itself. It merges nothing. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="10,0,10,10" Focusable="False">
        <StackPanel>
                                    <TextBlock Text="{Binding SelectedMicStrip.Name, StringFormat={}STRIP: {0}}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Text="Attach a microphone in Devices to give this strip something to process.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMicStrips}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
            <Border Grid.Row="4" Panel.ZIndex="10" VerticalAlignment="Top"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8"
                    Visibility="{Binding ShowStripControls, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="196">
                    <ItemsControl ItemsSource="{Binding BandStrip}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Orientation="Horizontal">

                                    <!-- EQ: ten ISO octave bands, -15..+15 dB (the DSP's own limit,
                                         not the -12 a casual read would assume). Two columns of
                                         five keep the band short enough to sit under the row. -->
                                    <StackPanel Width="244" Margin="0,0,10,0">
                                        <TextBlock Text="EQ (dB)" Style="{StaticResource RackGroupTitle}"/>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.0" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="31" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq31Db, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq31Db, Mode=TwoWay}" AutomationProperties.Name="31 Hz"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.1" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="63" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq63Db, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq63Db, Mode=TwoWay}" AutomationProperties.Name="63 Hz"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.2" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="125" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq125Db, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq125Db, Mode=TwoWay}" AutomationProperties.Name="125 Hz"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.3" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="250" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq250Db, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq250Db, Mode=TwoWay}" AutomationProperties.Name="250 Hz"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.4" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="500" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq500Db, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq500Db, Mode=TwoWay}" AutomationProperties.Name="500 Hz"/>
                                                </DockPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.5" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="1k" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq1kDb, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq1kDb, Mode=TwoWay}" AutomationProperties.Name="1 kHz"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.6" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="2k" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq2kDb, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq2kDb, Mode=TwoWay}" AutomationProperties.Name="2 kHz"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.7" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="4k" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq4kDb, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq4kDb, Mode=TwoWay}" AutomationProperties.Name="4 kHz"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.8" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="8k" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq8kDb, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq8kDb, Mode=TwoWay}" AutomationProperties.Name="8 kHz"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="eq.9" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="16k" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="{Binding Eq16kDb, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="50" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding Eq16kDb, Mode=TwoWay}" AutomationProperties.Name="16 kHz"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Band limits. Neutral is wide open; the fader is log so a voice
                                         filter's useful band is not two pixels wide. -->
                                    <StackPanel Width="190" Margin="0,0,10,0">
                                        <TextBlock Text="FILTERS (Hz)" Style="{StaticResource RackGroupTitle}"/>
                                        <DockPanel Style="{StaticResource RackRow}">
                                            <TextBlock Text="HP" Style="{StaticResource RackRowLabel}"/>
                                            <ToggleButton Style="{StaticResource RackBandGate}" Margin="0,0,6,0"
                                                          IsChecked="{Binding HighPassOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="High-pass on"/>
                                            <TextBlock Text="{Binding HighPassHz, StringFormat={}{0:0}}" Style="{StaticResource RackValue}" Width="52"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource RackRow}" Tag="hp.freq" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                    Value="{Binding HighPassSlider, Mode=TwoWay}"
                                                    AutomationProperties.Name="High-pass corner"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource RackRow}" Margin="0,6,0,0">
                                            <TextBlock Text="LP" Style="{StaticResource RackRowLabel}"/>
                                            <ToggleButton Style="{StaticResource RackBandGate}" Margin="0,0,6,0"
                                                          IsChecked="{Binding LowPassOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="Low-pass on"/>
                                            <TextBlock Text="{Binding LowPassHz, StringFormat={}{0:0}}" Style="{StaticResource RackValue}" Width="52"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource RackRow}" Tag="lp.freq" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                    Value="{Binding LowPassSlider, Mode=TwoWay}"
                                                    AutomationProperties.Name="Low-pass corner"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Gate: off is neutral, so the pill reads OFF on a fresh strip. -->
                                    <StackPanel Width="290" Margin="0,0,10,0">
                                        <DockPanel>
                                            <TextBlock Text="GATE" Style="{StaticResource RackGroupTitle}"/>
                                            <ToggleButton HorizontalAlignment="Left" Style="{StaticResource RackBandGate}"
                                                          Margin="6,0,0,0"
                                                          IsChecked="{Binding GateOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="Gate on"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <DockPanel Style="{StaticResource RackRow}" Tag="gate.threshold" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="THR" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding GateThresholdDb, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="-80" Maximum="0" SmallChange="1" LargeChange="6"
                                                            Value="{Binding GateThresholdDb, Mode=TwoWay}" AutomationProperties.Name="Gate threshold"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="gate.hysteresis" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="HYST" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding GateHysteresisDb, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="24" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding GateHysteresisDb, Mode=TwoWay}" AutomationProperties.Name="Gate hysteresis"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="gate.attack" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="ATK" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="ms" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding GateAttackMs, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.005" LargeChange="0.05"
                                                            Value="{Binding GateAttackSlider, Mode=TwoWay}" AutomationProperties.Name="Gate attack"/>
                                                </DockPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <DockPanel Style="{StaticResource RackRow}" Tag="gate.release" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="REL" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="ms" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding GateReleaseMs, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.005" LargeChange="0.05"
                                                            Value="{Binding GateReleaseSlider, Mode=TwoWay}" AutomationProperties.Name="Gate release"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="gate.hold" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="HOLD" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="ms" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding GateHoldMs, StringFormat={}{0:0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="2000" SmallChange="10" LargeChange="100"
                                                            Value="{Binding GateHoldMs, Mode=TwoWay}" AutomationProperties.Name="Gate hold"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="gate.floor" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="FLOOR" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding GateFloorDb, StringFormat={}{0:0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="-120" Maximum="0" SmallChange="1" LargeChange="6"
                                                            Value="{Binding GateFloorDb, Mode=TwoWay}" AutomationProperties.Name="Gate floor"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Compressor. -->
                                    <StackPanel Width="290" Margin="0,0,10,0">
                                        <DockPanel>
                                            <TextBlock Text="COMP" Style="{StaticResource RackGroupTitle}"/>
                                            <ToggleButton HorizontalAlignment="Left" Style="{StaticResource RackBandGate}"
                                                          Margin="6,0,0,0"
                                                          IsChecked="{Binding CompressorOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="Compressor on"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <DockPanel Style="{StaticResource RackRow}" Tag="comp.threshold" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="THR" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding CompThresholdDb, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="-60" Maximum="0" SmallChange="1" LargeChange="6"
                                                            Value="{Binding CompThresholdDb, Mode=TwoWay}" AutomationProperties.Name="Compressor threshold"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="comp.ratio" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="RATIO" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text=":1" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding CompRatio, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="1" Maximum="20" SmallChange="0.5" LargeChange="2"
                                                            Value="{Binding CompRatio, Mode=TwoWay}" AutomationProperties.Name="Compressor ratio"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="comp.knee" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="KNEE" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding CompKneeDb, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="24" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding CompKneeDb, Mode=TwoWay}" AutomationProperties.Name="Compressor knee"/>
                                                </DockPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <DockPanel Style="{StaticResource RackRow}" Tag="comp.attack" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="ATK" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="ms" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding CompAttackMs, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.005" LargeChange="0.05"
                                                            Value="{Binding CompAttackSlider, Mode=TwoWay}" AutomationProperties.Name="Compressor attack"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="comp.release" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="REL" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="ms" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding CompReleaseMs, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.005" LargeChange="0.05"
                                                            Value="{Binding CompReleaseSlider, Mode=TwoWay}" AutomationProperties.Name="Compressor release"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="comp.makeup" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="MAKE" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding CompMakeupDb, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="-12" Maximum="24" SmallChange="0.5" LargeChange="3"
                                                            Value="{Binding CompMakeupDb, Mode=TwoWay}" AutomationProperties.Name="Compressor makeup"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- De-esser. Between COMP and LIMITER because that is the order
                                         MixerStrip runs the stages. Off is neutral, so the pill reads
                                         OFF on a fresh strip. The split slider is log like the filters:
                                         sibilance lives at 4-8 kHz, and a linear fader would spend most
                                         of its travel above 12 kHz where nothing is being controlled.
                                         Its ends are the engine's own 1 kHz floor and 20 kHz ceiling.

                                         Eight values in one 180 column would tower over GATE and COMP,
                                         so the group takes their two-column 290 shape: the four that
                                         decide how much and where sit left, timing and the sidechain
                                         band sit right. This panel has no dual-handle slider, so the
                                         band is two ordinary rows whose bounds come from each other:
                                         LO's maximum is HI's position and HI's minimum is LO's, which
                                         stops the pair crossing without inventing a control. -->
                                    <StackPanel Width="290" Margin="0,0,10,0">
                                        <DockPanel Tag="deess.on" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <TextBlock Text="DE-ESS" Style="{StaticResource RackGroupTitle}"/>
                                            <ToggleButton HorizontalAlignment="Left" Style="{StaticResource RackBandGate}"
                                                          Margin="6,0,0,0"
                                                          IsChecked="{Binding DeEsserOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="De-esser on"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- How much and where: the four an operator reaches for first. -->
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="SHAPE" Style="{StaticResource RackCaption}" Margin="0,4,0,0"/>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="deess.threshold" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="THR" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding DeEsserThresholdDb, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}" Width="40"/>
                                                    <Slider Width="56" Minimum="-60" Maximum="0" SmallChange="1" LargeChange="6"
                                                            Value="{Binding DeEsserThresholdDb, Mode=TwoWay}"
                                                            AutomationProperties.Name="De-esser threshold"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="deess.amount" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="AMT" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text=":1" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding DeEsserRatio, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}" Width="40"/>
                                                    <Slider Width="56" Minimum="1" Maximum="20" SmallChange="0.5" LargeChange="2"
                                                            Value="{Binding DeEsserRatio, Mode=TwoWay}"
                                                            AutomationProperties.Name="De-esser amount"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="deess.split" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="SPLIT" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="Hz" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding DeEsserFrequencyHz, StringFormat={}{0:0}}" Style="{StaticResource RackValue}" Width="40"/>
                                                    <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                            Value="{Binding DeEsserSplitSlider, Mode=TwoWay}"
                                                            AutomationProperties.Name="De-esser split"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="deess.maxred" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="DEPTH" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding DeEsserMaxReductionDb, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}" Width="40"/>
                                                    <Slider Width="56" Minimum="0" Maximum="60" SmallChange="0.5" LargeChange="2"
                                                            Value="{Binding DeEsserMaxReductionDb, Mode=TwoWay}"
                                                            AutomationProperties.Name="De-esser depth"/>
                                                </DockPanel>
                                            </StackPanel>

                                            <!-- How fast it moves, and which band it listens to. The band's
                                                 two bounds are each slider's limit, so the pair cannot cross. -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="TIMING" Style="{StaticResource RackCaption}" Margin="0,4,0,0"/>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="deess.attack" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="ATT" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="ms" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding DeEsserAttackMs, StringFormat={}{0:0.##}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                            Value="{Binding DeEsserAttackSlider, Mode=TwoWay}"
                                                            AutomationProperties.Name="De-esser attack"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="deess.release" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="REL" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="ms" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding DeEsserReleaseMs, StringFormat={}{0:0.##}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                            Value="{Binding DeEsserReleaseSlider, Mode=TwoWay}"
                                                            AutomationProperties.Name="De-esser release"/>
                                                </DockPanel>
                                                <TextBlock Text="BAND" Style="{StaticResource RackCaption}" Margin="0,6,0,0"/>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="deess.sidechain.low" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="LO" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="Hz" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding DeEsserSidechainLowHz, StringFormat={}{0:0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56" Minimum="0"
                                                            Maximum="{Binding DeEsserSidechainLowSliderMax, Mode=OneWay}"
                                                            SmallChange="0.01" LargeChange="0.05"
                                                            Value="{Binding DeEsserSidechainLowSlider, Mode=TwoWay}"
                                                            AutomationProperties.Name="De-esser sidechain low"/>
                                                </DockPanel>
                                                <DockPanel Style="{StaticResource RackRow}" Tag="deess.sidechain.high" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                                    <TextBlock Text="HI" Style="{StaticResource RackRowLabel}"/>
                                                    <TextBlock Text="Hz" Style="{StaticResource RackUnit}"/>
                                                    <TextBlock Text="{Binding DeEsserSidechainHighHz, StringFormat={}{0:0}}" Style="{StaticResource RackValue}"/>
                                                    <Slider Width="56"
                                                            Minimum="{Binding DeEsserSidechainHighSliderMin, Mode=OneWay}"
                                                            Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                            Value="{Binding DeEsserSidechainHighSlider, Mode=TwoWay}"
                                                            AutomationProperties.Name="De-esser sidechain high"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Limiter: the one stage that costs latency, and the CHAIN column
                                         says so the moment it is switched on. -->
                                    <StackPanel Width="180" Margin="0,0,10,0">
                                        <DockPanel>
                                            <TextBlock Text="LIMITER" Style="{StaticResource RackGroupTitle}"/>
                                            <ToggleButton HorizontalAlignment="Left" Style="{StaticResource RackBandGate}"
                                                          Margin="6,0,0,0"
                                                          IsChecked="{Binding LimiterOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="Limiter on"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource RackRow}" Tag="limiter.ceiling" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <TextBlock Text="CEIL" Style="{StaticResource RackRowLabel}"/>
                                            <TextBlock Text="dB" Style="{StaticResource RackUnit}"/>
                                            <TextBlock Text="{Binding LimiterCeilingDb, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}" Width="40"/>
                                            <Slider Width="56" Minimum="-12" Maximum="0" SmallChange="0.5" LargeChange="3"
                                                    Value="{Binding LimiterCeilingDb, Mode=TwoWay}" AutomationProperties.Name="Limiter ceiling"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource RackRow}" Tag="limiter.release" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <TextBlock Text="REL" Style="{StaticResource RackRowLabel}"/>
                                            <TextBlock Text="ms" Style="{StaticResource RackUnit}"/>
                                            <TextBlock Text="{Binding LimiterReleaseMs, StringFormat={}{0:0.0}}" Style="{StaticResource RackValue}" Width="40"/>
                                            <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.005" LargeChange="0.05"
                                                    Value="{Binding LimiterReleaseSlider, Mode=TwoWay}" AutomationProperties.Name="Limiter release"/>
                                        </DockPanel>
                                        <TextBlock Text="240 frames of lookahead, only when on"
                                                   Style="{StaticResource RackCaption}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- Reverb send. Sits after the dynamics and de-esser because StripParameters puts it there; the pitch shifter follows it.
                                         Off is neutral, so the pill reads OFF on a fresh
                                         strip. Wet ends at 0.4 because the engine clamps there: the
                                         slider's right edge is the real ceiling, not a display choice. -->
                                    <StackPanel Width="180" Margin="0,0,10,0">
                                        <DockPanel Tag="rev.on" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <TextBlock Text="REVERB" Style="{StaticResource RackGroupTitle}"/>
                                            <ToggleButton HorizontalAlignment="Left" Style="{StaticResource RackBandGate}"
                                                          Margin="6,0,0,0"
                                                          IsChecked="{Binding ReverbOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="Reverb on"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource RackRow}" Tag="rev.size" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <TextBlock Text="SIZE" Style="{StaticResource RackRowLabel}"/>
                                            <!-- A 0..1 ratio carries no unit, but the empty 14 px gutter keeps
                                                 the slider on the same x as the rows beside this group. -->
                                            <TextBlock Style="{StaticResource RackUnit}"/>
                                            <TextBlock Text="{Binding ReverbSize, StringFormat={}{0:0.00}}" Style="{StaticResource RackValue}" Width="40"/>
                                            <Slider Width="56" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                    Value="{Binding ReverbSize, Mode=TwoWay}" AutomationProperties.Name="Reverb size"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource RackRow}" Tag="rev.wet" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <TextBlock Text="WET" Style="{StaticResource RackRowLabel}"/>
                                            <TextBlock Style="{StaticResource RackUnit}"/>
                                            <TextBlock Text="{Binding ReverbWet, StringFormat={}{0:0.00}}" Style="{StaticResource RackValue}" Width="40"/>
                                            <Slider Width="56" Minimum="0" Maximum="0.4" SmallChange="0.01" LargeChange="0.1"
                                                    Value="{Binding ReverbWet, Mode=TwoWay}" AutomationProperties.Name="Reverb wet"/>
                                        </DockPanel>
                                        <TextBlock Text="Wet stops at 0.40: that is the send's ceiling, not the slider's."
                                                   Style="{StaticResource RackCaption}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- Pitch shifter: last stage in StripParameters, so it sits after
                                         REVERB. It is not free the way the filters are: measured mean
                                         delay is 448 frames (9.3 ms) shifting up and 554 frames
                                         (11.5 ms) shifting down at 48 kHz. A deep down-shift peaks near
                                         22 ms, but that is the splice catching up, not the steady
                                         latency, so the caption names the means only. -->
                                    <StackPanel Width="180" Margin="0,0,10,0">
                                        <DockPanel Tag="pitch.on" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <TextBlock Text="PITCH" Style="{StaticResource RackGroupTitle}"/>
                                            <ToggleButton HorizontalAlignment="Left" Style="{StaticResource RackBandGate}"
                                                          Margin="6,0,0,0"
                                                          IsChecked="{Binding PitchShiftOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="Pitch shift on"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource RackRow}" Tag="pitch.semitones" PreviewMouseLeftButtonDown="OnStripValueDoubleClick">
                                            <TextBlock Text="SEMI" Style="{StaticResource RackRowLabel}"/>
                                            <!-- Semitones is already the label, so the unit gutter stays
                                                 empty and the slider keeps the shared x. -->
                                            <TextBlock Style="{StaticResource RackUnit}"/>
                                            <!-- Signed, three sections. The EQ rows use the same format:
                                                 an explicit + makes direction readable, and zero falls
                                                 through to the last section as "0.0" rather than "+0.0".
                                                 "+12.0" and "-12.0" are both five glyphs, so a 40 px box
                                                 holds the extremes with room to spare. -->
                                            <TextBlock Text="{Binding PitchShiftSemitones, StringFormat={}{0:+0.0;-0.0;0.0}}" Style="{StaticResource RackValue}" Width="40"/>
                                            <Slider Width="56" Minimum="-12" Maximum="12" SmallChange="0.1" LargeChange="1"
                                                    Value="{Binding PitchShiftSemitones, Mode=TwoWay}" AutomationProperties.Name="Pitch shift semitones"/>
                                        </DockPanel>
                                        <TextBlock Text="Vocal lands about 9 ms late shifting up, 11 ms down."
                                                   Style="{StaticResource RackCaption}" TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
