<Window x:Class="JockeyBox.Views.YouTubeAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect YouTube" Width="620" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LinkText" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pink accent: the dialog's primary action. -->
        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBBrush}"/>
            <Setter Property="Foreground" Value="#12141A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="4" Margin="16" Padding="18">
        <StackPanel>
            <TextBlock Text="Connect YouTube" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                       Margin="0,0,0,16"
                       Text="Playlist writes need a Google Cloud project of your own. This creates playlists and adds or removes videos on your channel. Credentials and tokens are kept in %APPDATA%\JockeyBox\youtube-oauth.json."/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEP 1" Style="{StaticResource StepLabel}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource StepText}"
                           Text="In console.cloud.google.com, enable the YouTube Data API v3 for a project"/>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEP 2" Style="{StaticResource StepLabel}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource StepText}"
                           Text="Create an OAuth client of type &quot;Desktop app&quot;. Desktop clients accept the loopback redirect on any 127.0.0.1 port, so there is nothing else to register."/>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEP 3" Style="{StaticResource StepLabel}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource StepText}">
                    <Run Text="Paste the client id and secret below, then press Connect. The browser returns to "/><Run
                        Text="http://127.0.0.1:&lt;port&gt;/" FontFamily="Consolas"
                        Foreground="{StaticResource AccentABrush}"/><Run Text=" automatically."/>
                </TextBlock>
            </Grid>

            <TextBlock Text="CLIENT ID" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="ClientIdBox" Margin="0,2,0,8"
                     Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="CLIENT SECRET" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="ClientSecretBox" Margin="0,2,0,0"
                     Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock x:Name="StatusLine" TextWrapping="Wrap" MinHeight="18"
                       Margin="0,10,0,0" Foreground="{StaticResource TextDimBrush}"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenConsoleButton" Grid.Column="0" Content="Open Google Cloud Console"
                        Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Click="OnOpenConsole"/>
                <Button x:Name="DisconnectButton" Grid.Column="1" Content="Disconnect"
                        MinWidth="90" Margin="0,0,8,0" Click="OnDisconnect"/>
                <Button Grid.Column="2" Content="Close" MinWidth="80" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button x:Name="ConnectButton" Grid.Column="3" Content="Connect"
                        Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConnect"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
