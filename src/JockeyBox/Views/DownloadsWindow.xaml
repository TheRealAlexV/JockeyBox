<Window x:Class="JockeyBox.Views.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads" Height="620" Width="560"
        MinHeight="460" MinWidth="480"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E06C7A"/>

        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="2"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Rectangle x:Name="PART_Track"/>
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat filter pills: the stock ListBoxItem chrome is too loud here. -->
        <Style x:Key="FilterPill" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="9,3" Margin="0,0,4,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="label" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="label" Property="TextDecorations" Value="Underline"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstallingTools}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Borderless glyph button used by the per-row actions. Small on purpose:
             the row must still read as a row, not as a toolbar. -->
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="MinWidth" Value="21"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One queue row. The card look keeps long lists readable without rules.
             The action group fades in on hover, so a resting row shows only its
             state glyph and progress. -->
        <DataTemplate x:Key="QueueRow">
            <Grid Margin="0,0,0,5">
                <Border x:Name="rowCard" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="10,7,10,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding Artist}" FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    <TextBlock Text="  &#x00B7;  " FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="{Binding StateGlyph}" FontSize="12" Margin="0,1,6,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ProgressText}" FontFamily="Consolas" FontSize="11"
                                           VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"
                                           Foreground="{StaticResource TextDimBrush}"/>

                                <!-- Hover-revealed row actions. The space is reserved so the
                                     progress text never shifts; only the opacity changes. -->
                                <StackPanel Orientation="Horizontal" Margin="3,0,0,0"
                                            IsHitTestVisible="{Binding IsMouseOver,
                                                              RelativeSource={RelativeSource AncestorType=Border}}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver,
                                                            RelativeSource={RelativeSource AncestorType=Border}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <!-- Tab focus must reveal what it landed on too. -->
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin,
                                                            RelativeSource={RelativeSource Self}}"
                                                             Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Button Content="&#x21BB;" ToolTip="Retry this download"
                                            AutomationProperties.Name="Retry this download"
                                            Command="{Binding DataContext.RetryItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="&#x2715;" ToolTip="Remove from queue"
                                            AutomationProperties.Name="Remove from queue"
                                            Command="{Binding DataContext.CancelItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Queued">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="&#x2197;" ToolTip="Show the file in Explorer"
                                            AutomationProperties.Name="Show the file in Explorer"
                                            Command="{Binding DataContext.OpenFileCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowAction}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Error text in dim red, otherwise speed / eta / stage detail -->
                        <TextBlock Grid.Row="1" Text="{Binding DetailText}" FontSize="11"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DetailText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ProgressBar Grid.Row="2" Margin="0,6,0,0"
                                     Minimum="0" Maximum="100" Value="{Binding Percent}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource SlimProgress}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <DockPanel>
                <TextBlock Text="DOWNLOADS" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <!-- Nothing queued: an empty bar and a bare "0%" is noise. -->
                            <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ProgressBar Grid.Column="0" Style="{StaticResource SlimProgress}" Height="6"
                             Minimum="0" Maximum="100" Value="{Binding OverallProgress}"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding OverallProgress, StringFormat={}{0:0}%}"
                           FontFamily="Consolas" FontSize="13" Margin="10,0,0,0"
                           Foreground="{StaticResource TextBrush}"/>
            </Grid>
        </StackPanel>

        <!-- ================= Toolbar ================= -->
        <DockPanel Grid.Row="1" Margin="2,0,2,8">
            <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Filters}"
                     SelectedItem="{Binding SelectedFilter}"
                     ItemContainerStyle="{StaticResource FilterPill}"
                     Background="Transparent" BorderThickness="0" Focusable="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}"
                        MinWidth="60" Padding="8,3" FontSize="11"
                        ToolTip="Pause/resume the workers; queued items stay queued"/>
                <Button Content="Cancel all" Command="{Binding CancelAllCommand}" Margin="5,0,0,0"
                        Padding="8,3" FontSize="11"
                        ToolTip="Stop the current download and drop everything still queued"/>
                <Button Content="{Binding RetryFailedLabel}" Command="{Binding RetryFailedCommand}"
                        Margin="5,0,0,0" Padding="8,3" FontSize="11"/>
                <Button Content="Clear done" Command="{Binding ClearCompletedCommand}" Margin="5,0,0,0"
                        Padding="8,3" FontSize="11"/>
            </StackPanel>
        </DockPanel>

        <!-- ================= Queue ================= -->
        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding View}" ItemTemplate="{StaticResource QueueRow}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock Text="{Binding EmptyHint}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" FontSize="12"
                       Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmptyHint}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- ================= Tools strip ================= -->
        <Border Grid.Row="3" Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="5" Padding="9,6" Margin="0,9,2,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                               DockPanel.Dock="Left" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="{Binding ToolsStatus}" FontSize="10" Margin="8,0,0,0"
                               DockPanel.Dock="Right" MaxWidth="200"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsInstallingTools, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding ToolVersions}" FontSize="10" Margin="7,0,0,0"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolVersions}"/>
                </DockPanel>
                <!-- Two rows: the three buttons do not fit beside the version
                     string at the window's minimum width. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Install tools" Command="{Binding InstallToolsCommand}"
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="Update yt-dlp" Command="{Binding UpdateYtDlpCommand}"
                            Style="{StaticResource ToolButton}" Margin="5,0,0,0"
                            ToolTip="Download the latest yt-dlp release"/>
                    <Button Content="Re-download ffmpeg" Command="{Binding UpdateFfmpegCommand}"
                            Style="{StaticResource ToolButton}" Margin="5,0,0,0"
                            ToolTip="ffmpeg has no self-updater: this fetches the bundled build again"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Footer: live status, cache, links ================= -->
        <StackPanel Grid.Row="4" Margin="2,8,2,0">
            <!-- Counts + current track; readable when the main window is in front. -->
            <TextBlock Text="{Binding StatusLine}" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusLine}"/>

            <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding CacheStats}" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                    <Button Content="Clear" Command="{Binding ClearCacheCommand}" Margin="6,0,0,0"
                            Style="{StaticResource LinkButton}"
                            ToolTip="Deletes the throwaway streamed copies (not your library files)"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Open music folder" Command="{Binding OpenMusicFolderCommand}"
                            Style="{StaticResource LinkButton}"/>
                    <TextBlock Text="&#x00B7;" FontSize="11" Margin="5,0"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                    <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
                            Style="{StaticResource LinkButton}"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
