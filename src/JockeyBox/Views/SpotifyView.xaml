<UserControl x:Class="JockeyBox.Views.SpotifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JockeyBox.Views"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E06C7A"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- Dim uppercase label used for every section head. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Playlist rail item: selected gets a left accent bar, no boxy chrome. -->
        <Style x:Key="PlaylistRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,4"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Track row: one dense line, tabular like the YouTube playlist. -->
        <Style x:Key="TrackRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,0"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" MinHeight="26">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat icon-ish action buttons in the header / table. -->
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTrack}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card holding one pane. -->
        <Style x:Key="PaneCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>

        <!-- Real column splitter between the rail and the table. -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="grip" Width="2" Height="26" CornerRadius="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Account / library bar ================= -->
        <Grid Grid.Row="0" Height="26" Margin="2,0,2,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="SPOTIFY" Style="{StaticResource SectionLabel}"
                       Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding AccountName}" Style="{StaticResource MetaText}"
                       HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"
                        Style="{StaticResource QuietButton}" Margin="0,0,5,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource QuietButton}" Margin="0,0,5,0"
                        ToolTip="Refresh the selected playlist from Spotify"/>
                <Button Content="Sync playlists" Command="{Binding SyncPlaylistsCommand}"
                        Style="{StaticResource QuietButton}" Margin="0,0,5,0"
                        ToolTip="Reload your Spotify playlists and their track lists"/>
                <Button Content="&#x2B07; Download all" Command="{Binding DownloadAllCommand}"
                        Style="{StaticResource QuietButton}"
                        ToolTip="Queue every track in the selected playlist that is not already in the library"/>
            </StackPanel>
        </Grid>

        <!-- ================= Two panes ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Playlist rail -->
            <Border Grid.Column="0" Style="{StaticResource PaneCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Height="14">
                        <TextBlock Text="PLAYLISTS" Style="{StaticResource SectionLabel}"/>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="PlaylistList" ItemsSource="{Binding Playlists}"
                             SelectedItem="{Binding SelectedPlaylist}"
                             ItemContainerStyle="{StaticResource PlaylistRow}"
                             Background="Transparent" BorderThickness="0"
                             Margin="0,4,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tracks.Count}"
                                               FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Rail empty hint, only when connected but nothing to show -->
                    <TextBlock Grid.Row="1" Margin="8,10,8,0" Text="No playlists yet. Press Sync playlists."
                               FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Playlists.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsLoggedIn}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Same spot while disconnected, so the rail is not a blank card -->
                    <TextBlock Grid.Row="1" Margin="8,10,8,0" Text="Connect Spotify to load your playlists."
                               FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Playlists.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsLoggedIn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                          ToolTip="Drag to resize the playlist rail"/>

            <!-- Track table -->
            <Border Grid.Column="2" Style="{StaticResource PaneCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section head: title, playlist progress hairline, counts -->
                    <Grid Grid.Row="0" Height="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TRACKS" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,10,0"/>
                        <ProgressBar Grid.Column="1" x:Name="PlaylistBar" Minimum="0" Maximum="100"
                                     Value="{Binding PlaylistProgress}" Height="5"
                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                     Foreground="{StaticResource AccentABrush}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border Background="{StaticResource PanelBrush}" CornerRadius="2"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <Rectangle x:Name="PART_Track"/>
                                        <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                   Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock Grid.Column="2" Text="{Binding CountsText}" FontFamily="Consolas"
                                   FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CountsText}"/>
                    </Grid>

                    <!-- Filter + actions on the selected track -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FILTER" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Height="24" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter the track list by title, artist or album"/>
                        <Button Grid.Column="2" Content="&#x25B6;" Style="{StaticResource RowActionButton}"
                                Margin="6,0,0,0"
                                Command="{Binding PlaySelectedCommand}"
                                ToolTip="Play the selected track through Deck B (Enter or double-click)"/>
                        <Button Grid.Column="3" Content="&#x2B07;" Style="{StaticResource RowActionButton}"
                                Margin="4,0,0,0"
                                Command="{Binding DownloadSelectedCommand}"
                                ToolTip="Queue the selected track"/>
                    </Grid>

                    <!-- Table -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <ListView x:Name="TrackList" ItemsSource="{Binding TracksView}"
                                  SelectedItem="{Binding SelectedTrack}"
                                  ItemContainerStyle="{StaticResource TrackRow}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Standard"
                                  MouseDoubleClick="OnTrackDoubleClick"
                                  PreviewMouseRightButtonDown="OnTrackRightClick"
                                  KeyDown="OnTrackKeyDown">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play"
                                              Command="{Binding PlacementTarget.DataContext.PlaySelectedCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Download"
                                              Command="{Binding PlacementTarget.DataContext.DownloadSelectedCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}"/>
                                            <TextBlock Text="{Binding Error}" FontSize="10"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Artist}" FontSize="10.5"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Artist}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="10.5"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Album}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                                   FontFamily="Consolas" FontSize="10.5"
                                                   VerticalAlignment="Center" Margin="6,0,4,0"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding StateGlyph}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="InLibrary">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Queued">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Busy / empty / disconnected states, layered over the table -->
                        <Border Background="{StaticResource PanelAltBrush}" Opacity="0.94" IsHitTestVisible="False"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Loading&#x2026;" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Select a playlist on the left to see its tracks."
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tracks.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsBusy}" Value="False"/>
                                                <Condition Binding="{Binding IsLoggedIn}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Disconnected: an invitation, not a blank table -->
                        <Border Background="{StaticResource PanelAltBrush}"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel MaxWidth="330" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Connect your Spotify account" FontSize="15" FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                <TextBlock Text="Pick a playlist, queue it, and JockeyBox keeps it in your library. Tracks you already own are skipped."
                                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,12"/>
                                <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"
                                        HorizontalAlignment="Center" Padding="16,5"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                                           TextAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status line (the disconnected card already carries the status) -->
                    <TextBlock Grid.Row="3" Text="{Binding StatusText}" Height="16" Margin="0,4,2,0"
                               ToolTip="{Binding StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
