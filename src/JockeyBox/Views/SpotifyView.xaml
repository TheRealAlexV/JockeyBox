<UserControl x:Class="JockeyBox.Views.SpotifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JockeyBox.Views"
             Unloaded="OnViewUnloaded"
             DataContextChanged="OnViewDataContextChanged"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Shared row design, context menu and filter/sort strip, identical to
             the library and YouTube lists. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Views/Shared/TrackRows.xaml"/>
            <ResourceDictionary Source="/Views/Shared/TrackMenu.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <SolidColorBrush x:Key="ErrorBrush" Color="#E06C7A"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <views:HeightBelowConverter x:Key="HeightBelow"/>

        <!-- Dim uppercase label used for every section head. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Playlist rail item: selected gets a left accent bar, no boxy chrome. -->
        <Style x:Key="PlaylistRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,4"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Track row: one dense line, tabular like the YouTube playlist. -->
        <Style x:Key="TrackRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" Padding="8,0"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" MinHeight="26">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Version row: two lines, so it sizes to content instead of the 26px table row. -->
        <Style x:Key="VersionRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" Padding="7,2"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" MinHeight="30">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat icon-ish action buttons in the header / table. -->
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTrack}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Folded edit strip toggle. Below roughly a 260 px card the row budget
             cannot hold the section head, the filter row, the edit strip, the
             column headers and even one track row at once; the edit strip is the
             one piece that is used rarely and can fold, so it does, and this chip
             is the way back to it. It rides in the 22 px filter row, so showing it
             costs the list no height. Only visible while the card is short: at a
             tall card the strip is already open and the chip would be noise. -->
        <Style x:Key="EditFoldToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="ToolTip" Value="Edit this playlist"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, ElementName=TrackCard, Converter={StaticResource HeightBelow}, ConverterParameter=260}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tiny in-row button (find versions): takes its own item as the parameter. -->
        <Style x:Key="RowMiniButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        </Style>

        <!-- Same, for the version-pick buttons. -->
        <Style x:Key="VersionButton" TargetType="Button" BasedOn="{StaticResource RowMiniButton}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- The preview action, spelled out: a bare play glyph was invisible next to the row. -->
        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Content" Value="PREVIEW"/>
            <Setter Property="ToolTip" Value="Streams instantly, nothing is saved"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        </Style>

        <!-- Card holding one pane. -->
        <Style x:Key="PaneCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>

        <!-- Real column splitter between the rail and the table. -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="grip" Width="2" Height="26" CornerRadius="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Account / library bar ================= -->
        <Grid Grid.Row="0" Height="26" Margin="2,0,2,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="SPOTIFY" Style="{StaticResource SectionLabel}"
                       Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding AccountName}" Style="{StaticResource MetaText}"
                       HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"
                        Style="{StaticResource QuietButton}" Margin="0,0,5,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource QuietButton}" Margin="0,0,5,0"
                        ToolTip="Refresh the selected playlist from Spotify"/>
                <Button Content="Sync playlists" Command="{Binding SyncPlaylistsCommand}"
                        Style="{StaticResource QuietButton}" Margin="0,0,5,0"
                        ToolTip="Reload your Spotify playlists and their track lists"/>
                <Button Content="&#x2B07; Download all" Command="{Binding DownloadAllCommand}"
                        Style="{StaticResource QuietButton}"
                        ToolTip="Download every track in the selected playlist that is not already in the library"/>
            </StackPanel>
        </Grid>

        <!-- ================= Two panes ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Playlist rail -->
            <Border Grid.Column="0" Style="{StaticResource PaneCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Height="14">
                        <TextBlock Text="PLAYLISTS" Style="{StaticResource SectionLabel}"/>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="PlaylistList" ItemsSource="{Binding Playlists}"
                             SelectedItem="{Binding SelectedPlaylist}"
                             ItemContainerStyle="{StaticResource PlaylistRow}"
                             Background="Transparent" BorderThickness="0"
                             Margin="0,4,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tracks.Count}"
                                               FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Rail empty hint, only when connected but nothing to show -->
                    <TextBlock Grid.Row="1" Margin="8,10,8,0" Text="No playlists yet. Press Sync playlists."
                               FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Playlists.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsLoggedIn}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Same spot while disconnected, so the rail is not a blank card -->
                    <TextBlock Grid.Row="1" Margin="8,10,8,0" Text="Connect Spotify to load your playlists."
                               FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Playlists.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsLoggedIn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                          ToolTip="Drag to resize the playlist rail"/>

            <!-- Track table. x:Name is the height probe for the fold below: the
                 card is stretched by its star row, so its ActualHeight is the
                 budget the list has to live inside. -->
            <Border Grid.Column="2" Style="{StaticResource PaneCard}" x:Name="TrackCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section head: title, playlist progress hairline, counts -->
                    <Grid Grid.Row="0" Height="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TRACKS" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,10,0"/>
                        <ProgressBar Grid.Column="1" x:Name="PlaylistBar" Minimum="0" Maximum="100"
                                     Value="{Binding PlaylistProgress}" Height="5"
                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                     Foreground="{StaticResource AccentABrush}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border Background="{StaticResource PanelBrush}" CornerRadius="2"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <Rectangle x:Name="PART_Track"/>
                                        <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                   Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock Grid.Column="2" Text="{Binding CountsText}" FontFamily="Consolas"
                                   FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CountsText}"/>
                    </Grid>

                    <!-- Filter + actions on the selected track -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Shared filter + sort strip; its DataContext is a
                             TrackListView built in the code-behind so the filter
                             still writes into FilterText. -->
                        <ContentControl Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                        x:Name="FilterHost" Focusable="False"
                                        ContentTemplate="{StaticResource FilterSortStrip}"/>
                        <Button Grid.Column="2" Content="&#x25B6;" Style="{StaticResource RowActionButton}"
                                Margin="6,0,0,0"
                                Command="{Binding PlaySelectedCommand}"
                                ToolTip="Play the selected track through Deck B (Enter or double-click)"/>
                        <Button Grid.Column="3" Content="&#x2B07;" Style="{StaticResource RowActionButton}"
                                Margin="4,0,0,0"
                                Command="{Binding DownloadSelectedCommand}"
                                ToolTip="Download the selected track"/>
                        <Button Grid.Column="4" Content="&#x2193;&#x25B6;" Style="{StaticResource RowActionButton}"
                                Margin="4,0,0,0"
                                Command="{Binding DownloadAndPlaySelectedCommand}"
                                ToolTip="Download the selected track and play the stream while it downloads"/>
                        <Button Grid.Column="5" Content="&#x21C4;" Style="{StaticResource RowActionButton}"
                                Margin="4,0,0,0"
                                Command="{Binding FindVersionsCommand}"
                                ToolTip="Find YouTube versions of the selected track before downloading it"/>
                        <!-- Way back to the edit strip when it is folded away. -->
                        <ToggleButton Grid.Column="6" x:Name="EditFoldToggle" Content="EDIT"
                                      Style="{StaticResource EditFoldToggle}"/>
                    </Grid>

                    <!-- Playlist editing strip. Writes need playlist-modify-*: when the
                         grant is read-only these are disabled and Re-authorize shows
                         instead. WrapPanel keeps it on one line until the pane is narrow.
                         Folds away instead of squeezing the list shut: at a short card
                         this row plus the idle preview bar are the difference between
                         zero track rows and three. -->
                    <WrapPanel Margin="0,5,0,0">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Grid.Row" Value="2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <!-- Short card: there is no Auto row to spare, so the
                                         strip rides over the top of the table instead of
                                         pushing it down. At a 120 px card it was buying its
                                         37 px out of the one star row, taking the body from
                                         58 px to 21 px and pushing the empty state out
                                         through the bottom border. Same controls, same
                                         place, no height taken. -->
                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=TrackCard, Converter={StaticResource HeightBelow}, ConverterParameter=260}" Value="True">
                                        <Setter Property="Grid.Row" Value="3"/>
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="Panel.ZIndex" Value="20"/>
                                        <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActualHeight, ElementName=TrackCard, Converter={StaticResource HeightBelow}, ConverterParameter=260}" Value="True"/>
                                            <Condition Binding="{Binding IsChecked, ElementName=EditFoldToggle}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <TextBlock Text="EDIT" Style="{StaticResource SectionLabel}" Margin="0,0,8,0"/>
                        <TextBox Width="150" Height="24" FontSize="11" Margin="0,0,4,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Name for a new private Spotify playlist">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CreateSpotifyPlaylistCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="+ New playlist" Style="{StaticResource QuietButton}"
                                Margin="0,0,4,0"
                                Command="{Binding CreateSpotifyPlaylistCommand}"
                                ToolTip="{Binding WriteTooltip}"
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button Content="Add selected" Style="{StaticResource QuietButton}"
                                Margin="0,0,4,0"
                                Command="{Binding AddSelectedToSpotifyPlaylistCommand}"
                                ToolTip="{Binding WriteTooltip}"
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button Content="Remove selected" Style="{StaticResource QuietButton}"
                                Margin="0,0,4,0"
                                Command="{Binding RemoveSelectedFromSpotifyPlaylistCommand}"
                                ToolTip="{Binding WriteTooltip}"
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button Content="Re-authorize" Style="{StaticResource QuietButton}"
                                Command="{Binding ReauthorizeSpotifyCommand}"
                                Visibility="{Binding ShowReauthorize, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Open Spotify's consent screen again to grant playlist editing"/>
                    </WrapPanel>

                    <!-- Table -->
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Short, disconnected: this row labels the columns of a table with
                             no rows, and it is the 26 px that made the card's own rows sit
                             15.7 px outside a 120.4 px card. The wrapper carries the fold so
                             the ContentControl keeps its own style, the way the preview strip
                             below does it. -->
                        <Grid Grid.Row="0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ActualHeight, ElementName=TrackCard, Converter={StaticResource HeightBelow}, ConverterParameter=260}" Value="True"/>
                                                <Condition Binding="{Binding IsLoggedIn}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentControl Content="{StaticResource TrackColumnHeaders}"
                                            Focusable="False" IsTabStop="False"/>
                        </Grid>
                        <ListView Grid.Row="1" x:Name="TrackList" ItemsSource="{Binding TracksView}"
                                  SelectedItem="{Binding SelectedTrack}"
                                  ItemContainerStyle="{StaticResource TrackRow}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  MouseDoubleClick="OnTrackDoubleClick"
                                  PreviewMouseRightButtonDown="OnTrackRightClick"
                                  KeyDown="OnTrackKeyDown"
                                  ItemTemplate="{StaticResource RemoteTrackRow}"
                                  ContextMenu="{StaticResource TrackMenu}">
                        </ListView>

                        <!-- Busy / empty / disconnected states, layered over the table.
                             Row 1 is the body: in row 0 they were competing with the
                             column headers for an Auto row, and the disconnected
                             prompt alone made that row 122 px tall - so the table body
                             was handed a viewport of zero on a short browser band. -->
                        <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}" Opacity="0.94" IsHitTestVisible="False"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Loading&#x2026;" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Select a playlist on the left to see its tracks."
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tracks.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsBusy}" Value="False"/>
                                                <Condition Binding="{Binding IsLoggedIn}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Disconnected: an invitation, not a blank table. Headline, one
                             line, the button. It used to carry four pieces of prose (the
                             same "not connected, press this" three ways) and measured 122 px
                             inside a 108 px card, so its bottom half lived outside the card.
                             The status line it gave up still reaches the user through the
                             button's tooltip; it needs 26 px of card to have a row again. -->
                        <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel MaxWidth="330" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <!-- Short card: bottom-anchor the invitation, folded or
                                                 strip-open. Folded used to centre (11.1 px slack) while
                                                 strip-open bottom-anchored, so the Connect button
                                                 drifted 3.1 px as the strip opened. One anchor for both
                                                 states pins it at 732.8. Tall cards keep the centring. -->
                                            <DataTrigger Binding="{Binding ActualHeight, ElementName=TrackCard, Converter={StaticResource HeightBelow}, ConverterParameter=260}" Value="True">
                                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Mid-edit there is nothing to invite: the strip is the task.
                                     The button alone still says what it does. -->
                                <StackPanel x:Name="InvitationCopy">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ActualHeight, ElementName=TrackCard, Converter={StaticResource HeightBelow}, ConverterParameter=260}" Value="True"/>
                                                        <Condition Binding="{Binding IsChecked, ElementName=EditFoldToggle}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Connect your Spotify account" FontSize="15" FontWeight="SemiBold"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="Loads playlists; tracks you already own are skipped."
                                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,2"/>
                                </StackPanel>
                                <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"
                                        HorizontalAlignment="Center" Padding="16,5"
                                        ToolTip="{Binding StatusText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Versions picker: choose which upload becomes the library file -->
                    <Border Grid.Row="4" Margin="0,5,0,0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource AccentBBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="6,4"
                            Visibility="{Binding IsVersionsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Height="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding VersionsHeader}"
                                           Style="{StaticResource MetaText}" FontSize="10"
                                           ToolTip="{Binding VersionsHeader}"/>
                                <TextBlock Grid.Column="1" Text="Searching&#x2026;" FontSize="10"
                                           Foreground="{StaticResource AccentBBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding IsFindingVersions, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource RowMiniButton}"
                                        Width="16" Height="16"
                                        Command="{Binding CloseVersionsCommand}"
                                        ToolTip="Close the version list"/>
                            </Grid>

                            <ListView Grid.Row="1" ItemsSource="{Binding Versions}"
                                      ItemContainerStyle="{StaticResource VersionRow}"
                                      Background="Transparent" BorderThickness="0"
                                      MaxHeight="132" Margin="0,2,0,0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Standard">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}"/>
                                                <TextBlock Text="{Binding DetailText}" FontSize="10"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DetailText}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Download this"
                                                    Style="{StaticResource VersionButton}" Width="Auto"
                                                    Padding="7,0" FontSize="10.5" Margin="6,0,4,0"
                                                    Foreground="{StaticResource TextBrush}"
                                                    Command="{Binding DataContext.DownloadVersionCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Download this upload into the library as the Spotify track"/>
                                            <Button Grid.Column="2" Style="{StaticResource PreviewButton}"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding DataContext.PreviewVersionCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="3" Content="&#x2197;"
                                                    Style="{StaticResource VersionButton}"
                                                    Command="{Binding DataContext.OpenVersionOnYouTubeCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Open this upload on YouTube"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Preview strip: position / seek / play-pause -->
                    <!-- Idle, at a short card, the transport is 32 px of disabled chrome
                         sitting under a list that has no room for a row, so it folds away
                         and comes back the moment there is something to transport. The
                         wrapper carries the fold: a Style on the bar itself would replace
                         its implicit style and cost the list a measure pass. -->
                    <Grid Grid.Row="5">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActualHeight, ElementName=TrackCard, Converter={StaticResource HeightBelow}, ConverterParameter=260}" Value="True"/>
                                            <Condition Binding="{Binding Preview.IsAvailable}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                    <!-- Short card, edit strip open: the strip and the
                                         transport are both 32 px of optional chrome and
                                         only one of them fits, so the strip wins and the
                                         transport comes back when the strip is folded. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActualHeight, ElementName=TrackCard, Converter={StaticResource HeightBelow}, ConverterParameter=260}" Value="True"/>
                                            <Condition Binding="{Binding IsChecked, ElementName=EditFoldToggle}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:PreviewBar DataContext="{Binding Preview}"/>
                    </Grid>

                    <!-- Status line (the disconnected card already carries the status) -->
                    <TextBlock Grid.Row="6" Text="{Binding StatusText}" Height="16" Margin="0,4,2,0"
                               ToolTip="{Binding StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
