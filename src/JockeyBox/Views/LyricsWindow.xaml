<Window x:Class="JockeyBox.Views.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JockeyBox.Views"
        Title="Lyrics"
        Width="780" Height="486" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True"
        AutomationProperties.Name="Lyrics window">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="LYRICS" FontSize="10" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}"/>
            <CheckBox x:Name="TopmostToggle" DockPanel.Dock="Right"
                      Content="Always on top" FontSize="10" VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Checked="OnTopmostChanged" Unchecked="OnTopmostChanged"
                      ToolTip="Keep this window above other windows"/>
        </DockPanel>

        <!-- The same control the main window hosts: one document, two views. -->
        <views:LyricsPanel Grid.Row="1" x:Name="Panel"/>
    </Grid>
</Window>
