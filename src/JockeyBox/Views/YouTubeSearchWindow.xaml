<Window x:Class="JockeyBox.Views.YouTubeSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JockeyBox.Views"
        Title="Find on YouTube" Width="780" Height="486" MinWidth="620" MinHeight="330"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Read-only: the shared cell styles, so a result row uses the
                     same type sizes and colours as every other track list. -->
                <ResourceDictionary Source="/Views/Shared/TrackRows.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Card around the result list. Same border, radius and tone as the
                 tab panes, so the window reads as part of the app. -->
            <Style x:Key="PaneCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="7,5"/>
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="MetaText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- Result row: hover and keyboard focus are both visible, because
                 the whole row selects and Enter previews it. -->
            <Style x:Key="SearchRow" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="Transparent" Padding="8,2"
                                    BorderBrush="Transparent" BorderThickness="2,0,0,0">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row's own button: small, flat, always 24px high so the row
                 height never depends on the text around it. -->
            <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="20"/>
                <Setter Property="MinWidth" Value="24"/>
                <Setter Property="Padding" Value="7,0"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10,9,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- What this search is for, so the window never looks like it lost its subject -->
        <Grid Grid.Row="0" Height="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="FIND ON YOUTUBE" Style="{StaticResource SectionLabel}"
                       Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Style="{StaticResource MetaText}"
                       Text="{Binding TargetLabel}" ToolTip="{Binding TargetLabel}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource MetaText}" Margin="10,0,0,0"
                       Text="Esc closes" ToolTip="Closing this window stops the preview it started"/>
        </Grid>

        <!-- Query: pre-filled, editable, Enter searches -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryBox" Grid.Column="0"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Artist and title, or whatever you would type into YouTube"
                     AutomationProperties.Name="YouTube search query"
                     VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1" Content="Search" Margin="6,0,0,0" Width="68"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SearchCommand}"
                    ToolTip="Search YouTube (Enter)"/>
        </Grid>

        <!-- Status line: one place for what happened, never a dialog -->
        <Grid Grid.Row="2" Height="18" Margin="0,4,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MetaText}"
                       TextWrapping="NoWrap"
                       ToolTip="{Binding StatusText}"/>
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="3" Margin="0,2,0,0">
            <Border Style="{StaticResource PaneCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Height="24" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource BorderBrush}"
                            Background="{StaticResource PanelAltBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TITLE" Style="{StaticResource TrackColumnHeader}"/>
                            <TextBlock Grid.Column="1" Text="CHANNEL" Style="{StaticResource TrackColumnHeader}"/>
                            <TextBlock Grid.Column="2" Text="LEN" Style="{StaticResource TrackColumnHeader}"/>
                            <TextBlock Grid.Column="3" Text="ACTIONS" Style="{StaticResource TrackColumnHeader}"
                                       Width="176"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="ResultList" Grid.Row="1"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}"
                             ItemContainerStyle="{StaticResource SearchRow}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             MouseDoubleClick="OnResultDoubleClick"
                             KeyDown="OnResultKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource TrackTitle}"
                                               Text="{Binding Title}" ToolTip="{Binding Title}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TrackCellDim}"
                                               Text="{Binding Uploader}" ToolTip="{Binding Uploader}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource TrackCellNum}"
                                               Text="{Binding Duration, StringFormat={}{0:m\:ss}}"
                                               ToolTip="{Binding DurationSeconds, StringFormat={}{0:0}s}"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Width="176"
                                                HorizontalAlignment="Right">
                                        <Button Content="PREVIEW" Style="{StaticResource RowAction}"
                                                Width="66" Margin="0,0,4,0"
                                                ToolTip="Stream this upload's audio, nothing is saved"
                                                Command="{Binding DataContext.PreviewCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="USE" Style="{StaticResource RowAction}"
                                                Width="48" Margin="0,0,4,0"
                                                ToolTip="Make this the YouTube upload for the track"
                                                Command="{Binding DataContext.PickCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanPick,
                                                             RelativeSource={RelativeSource AncestorType=ListBox},
                                                             Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="&#x2197;" Style="{StaticResource RowAction}"
                                                Width="26" FontSize="12" Padding="0"
                                                ToolTip="Open this upload in the browser"
                                                AutomationProperties.Name="Open in browser"
                                                Command="{Binding DataContext.OpenInBrowserCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state: never a blank pane -->
                    <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource MetaText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="16,0" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Audition strip: the shared PreviewBar, so a drag here seeks exactly
             like a drag on a tab strip - same control, same transport, one seek
             path. The frame stays this window's, hence ShowFrame="False". -->
        <Border Grid.Row="4" Margin="0,6,0,0" Padding="6,3"
                Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <views:PreviewBar Grid.Column="0" ShowFrame="False" Margin="0"
                                  DataContext="{Binding Strip}"/>

                <Button Grid.Column="1" Content="Stop" Style="{StaticResource RowAction}" Width="44"
                        Margin="8,0,0,0"
                        Command="{Binding StopPreviewCommand}"
                        AutomationProperties.Name="Stop the preview"
                        ToolTip="Stop the preview"/>
            </Grid>
        </Border>
    </Grid>
</Window>
