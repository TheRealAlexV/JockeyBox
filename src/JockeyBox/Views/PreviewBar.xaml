<UserControl x:Class="JockeyBox.Views.PreviewBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JockeyBox.Views"
             Background="Transparent">

    <UserControl.Resources>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!--
            Focus ring for the two sliders. The theme's default focus visual is a
            near-black dotted rectangle, which is invisible on this dark panel;
            accent at 1px outside the track, so it costs no layout.
        -->
        <Style x:Key="StripSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="-3" BorderThickness="1" CornerRadius="3"
                                            BorderBrush="{StaticResource AccentABrush}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Not seekable: dimmed, so "off" reads as weight and not only as
                     colour. The tooltip and the automation name say it in words. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            The upload the strip is showing. Left empty by the tabs, where the list
            directly above already names it - the empty triggers then collapse the
            column to zero width, so tab layout is untouched.
        -->
        <Style x:Key="StripTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="200"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Title}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
            Seek bar slot. The shared theme Slider paints its track in the panel
            colour, so on these strips there was no groove and no progress: a cyan
            dot on the panel, with no way to see where the bar began, ended, or how
            far along it was. Two tones fix that and nothing else moves: the same
            18px height, the same 14px thumb, the same slot in the row.

            Groove #6B7480 is 3.4:1 on the panel - visible, and flat enough to read
            as a recess under its 1px dark top edge rather than as a second bar.
            The played portion is a deeper accent than the thumb, so the eye gets
            position from the fill and the live point from the bright dot.
        -->
        <SolidColorBrush x:Key="SeekGrooveBrush" Color="#6B7480"/>
        <SolidColorBrush x:Key="SeekPlayedBrush" Color="#00A8D8"/>

        <Style x:Key="SeekPlayedRepeat" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Margin="1,0,0,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource SeekPlayedBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSlider" TargetType="Slider" BasedOn="{StaticResource StripSlider}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3"
                                    Background="{StaticResource SeekGrooveBrush}"
                                    BorderBrush="#0C0F13" BorderThickness="0,1,0,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PlayedFill"
                                                  Style="{StaticResource SeekPlayedRepeat}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeat}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14"
                                                         Fill="{StaticResource AccentABrush}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--
                                No length yet, so the slider sits with min equal to
                                max, which parks the thumb at the right end and would
                                paint a full-width fill claiming the whole track is
                                played. Hide the fill and let the empty groove say
                                that nothing is known yet.
                            -->
                            <Trigger Property="Maximum" Value="0">
                                <Setter TargetName="PlayedFill" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Audition strip for the Spotify / YouTube tabs: play-pause, position, a
        seekable slider and the total length, driven by the main transport through
        IPreviewTransport. Sits directly under the list it belongs to.
    -->
    <Border x:Name="Frame">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Style.Triggers>
                    <!--
                        ShowFrame="False": the host already draws the frame (the
                        Find on YouTube window), so this strip supplies only what
                        is inside it and does not double the border.
                    -->
                    <DataTrigger Value="False"
                                 Binding="{Binding ShowFrame, RelativeSource={RelativeSource AncestorType=views:PreviewBar}}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Height="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{Binding PlayGlyph}"
                    Width="22" Height="20" FontSize="10" Padding="0"
                    Margin="0,0,5,0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextBrush}"
                    IsEnabled="{Binding IsAvailable}"
                    Command="{Binding PlayPauseCommand}"
                    ToolTip="{Binding PlayPauseHint}"/>

            <!-- Which upload is playing. Only the search window has something to
                 name; the tabs leave Title empty and this column takes no width. -->
            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource StripTitle}"
                       ToolTip="{Binding Title}"/>

            <TextBlock Grid.Column="2" Text="{Binding PositionText}"
                       FontFamily="Consolas" FontSize="10.5" Width="38"
                       Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="0,0,6,0"/>

            <Slider Grid.Column="3" x:Name="SeekBar"
                    Minimum="0" Maximum="{Binding DurationSeconds}"
                    Value="{Binding PositionSeconds, Mode=OneWay}"
                    IsEnabled="{Binding IsSeekable}"
                    VerticalAlignment="Center" Height="18"
                    IsMoveToPointEnabled="True"
                    Style="{StaticResource SeekSlider}"
                    AutomationProperties.Name="Preview position"
                    AutomationProperties.HelpText="{Binding SeekHint}"
                    ToolTip="{Binding SeekHint}"
                    Visibility="{Binding ShowSeekBar, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Resolving / downloading / failure: the middle cell says what is
                 happening instead of showing a dead slider. Announced when it
                 changes, so a refused preview is not a silent one. -->
            <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                       AutomationProperties.LiveSetting="Polite"
                       FontSize="10.5" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"/>

            <TextBlock Grid.Column="4" Text="{Binding DurationText}"
                       FontFamily="Consolas" FontSize="10.5" Width="42"
                       Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Center" TextAlignment="Right"
                       Margin="6,0,0,0"/>

            <TextBlock Grid.Column="5" Text="{Binding ModeText}"
                       FontSize="9" Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Center" Margin="4,0,0,0"
                       ToolTip="{Binding ModeHint}"
                       Visibility="{Binding HasModeBadge, Converter={StaticResource BoolToVisibility}}"/>

            <Button Grid.Column="6" Content="{Binding MuteGlyph}"
                    Width="20" Height="20" FontSize="9" Padding="0"
                    Margin="2,0,2,0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextBrush}"
                    IsEnabled="{Binding IsAvailable}"
                    Command="{Binding ToggleMuteCommand}"
                    ToolTip="{Binding MuteHint}"/>

            <Slider Grid.Column="7" x:Name="VolumeBar"
                    Minimum="0" Maximum="100"
                    Value="{Binding Volume, Mode=TwoWay}"
                    IsEnabled="{Binding IsAvailable}"
                    VerticalAlignment="Center" Height="16" Width="56"
                    Focusable="True"
                    Style="{StaticResource StripSlider}"
                    AutomationProperties.Name="Preview volume"
                    ToolTip="{Binding VolumeHint}"/>

            <TextBlock Grid.Column="3" Text="Preview the track here, then download the version you want."
                       FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}"/>
        </Grid>
    </Border>
</UserControl>
