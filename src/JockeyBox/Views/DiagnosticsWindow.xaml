<Window x:Class="JockeyBox.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics" Width="1180" Height="760" MinWidth="900" MinHeight="520"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- A section is a heading with a hairline under it: the whole window is one
             document, so sections are ruled apart rather than boxed into cards. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Values are the reason this window exists: monospace, tabular, right
             aligned in a fixed column so a changing number never re-flows the row. -->
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Value}">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        </Style>

        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                            <!-- Focus is a 2 px accent border, not a dotted rectangle:
                                 visible, and it does not change the button's size. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="REFRESH" Style="{StaticResource RefreshButton}"
                    IsDefault="True" Click="OnRefreshClick"
                    AutomationProperties.Name="Refresh diagnostics"
                    ToolTip="Re-read engine state. Nothing is started, stopped or measured."/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="DIAGNOSTICS" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Live state of the audio engine and the M0 rails. Read-only."
                           FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ Left: build, engine, mixer, rails ============ -->
                <StackPanel Grid.Column="0">

                    <!-- BUILD & ENGINE -->
                    <StackPanel>
                        <TextBlock Text="BUILD &amp; ENGINE" Style="{StaticResource SectionHeader}"/>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,8"/>

                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="product version" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProductVersion}" Style="{StaticResource Value}"/>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="informational version" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding InformationalVersion}" Style="{StaticResource Value}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding InformationalVersion}"/>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="file version" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FileVersion}" Style="{StaticResource Value}"/>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="sample rate" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Value}">
                                <Run Text="{Binding SampleRate, Mode=OneWay}"/><Run Text=" Hz"/>
                            </TextBlock>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="channels" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Channels}" Style="{StaticResource Value}"/>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="block frames" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding BlockFrames}" Style="{StaticResource Value}"/>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="block duration" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding BlockDurationMs}" Style="{StaticResource Value}"/>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="engine" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding EngineState}" Style="{StaticResource Value}"/>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="frames rendered" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FrameIndex}" Style="{StaticResource Value}"/>
                        </Grid>
                    </StackPanel>

                    <!-- MIXER -->
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="MIXER" Style="{StaticResource SectionHeader}"/>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,8"/>

                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MixerEnabled" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding MixerEnabled}" Style="{StaticResource Value}"/>
                        </Grid>

                    </StackPanel>

                    <!-- M0 RAILS -->
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="M0 RAILS" Style="{StaticResource SectionHeader}"/>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,8"/>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="latency ledger" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="no instance in this build" Style="{StaticResource Muted}"/>
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="control registry" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="no instance in this build" Style="{StaticResource Muted}"/>
                        </Grid>
                        <TextBlock Text="Neither type is constructed anywhere yet, so there is no state to read."
                                   FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" Margin="0,6,12,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Right: buses, selftest ============ -->
                <StackPanel Grid.Column="2">

                    <!-- BUSES -->
                    <StackPanel>
                        <TextBlock Text="BUSES" Style="{StaticResource SectionHeader}"/>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,8"/>

                        <Grid Height="18" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="bus" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Grid.Column="1" Text="device" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Grid.Column="2" Text="delay" Style="{StaticResource SectionHeader}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="peak" Style="{StaticResource SectionHeader}" HorizontalAlignment="Right"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Buses}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="22" ToolTip="{Binding Kind}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="94"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Label}"
                                                   FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Device}" Style="{StaticResource Label}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Delay}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PeakDb}" Style="{StaticResource Value}"/>
                                        <!-- Peak bar: the same number as a shape, so five
                                             buses can be compared without reading five
                                             numbers. Fixed 150 px track, so the row
                                             never changes width. -->
                                        <Grid Grid.Column="4" Width="150" HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                            <Rectangle Height="3" Fill="{StaticResource BorderBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Rectangle Height="3" Fill="{StaticResource AccentABrush}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Width="{Binding BarWidth}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Peak is sampled from the block the engine last rendered, before the bus delay."
                                   FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" Margin="0,6,12,0"/>
                    </StackPanel>

                    <!-- SELFTEST -->
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="SELFTEST CASES" Style="{StaticResource SectionHeader}"/>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,8"/>
                        <TextBlock Text="The cases this build runs. Results are printed by the --selftest process and not kept, so there is no last result for a running app to show."
                                   FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" Margin="0,0,12,6"/>

                        <ItemsControl ItemsSource="{Binding Cases}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="19">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="168"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State}"
                                                   Style="{StaticResource Muted}" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="10"
                   Foreground="{StaticResource TextDimBrush}"
                   Text="Reads existing state only. This window opens no device, moves no audio and never runs the selftest."/>
    </Grid>
</Window>
