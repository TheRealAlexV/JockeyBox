<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:JockeyBox.Views">

    <!-- ============ Palette (Rekordbox-inspired dark) ============ -->
    <Color x:Key="WindowColor">#0E1013</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#171A1F"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#1E222A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2B303B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#8B93A1"/>
    <SolidColorBrush x:Key="AccentABrush" Color="#00C8FF"/>
    <SolidColorBrush x:Key="AccentBBrush" Color="#FF3DAD"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#262B35"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#303642"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#2E4A5A"/>
    <!-- Destructive actions: delete-track menu items, future danger buttons. -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C5C"/>
    <!-- Something the operator should know about but that did not fail: a feature
         that is off, a setting to fix. Amber, and always with a word beside it. -->
    <SolidColorBrush x:Key="WarningBrush" Color="#E8B44B"/>

    <!-- Default per-deck accent; overridden per deck card -->
    <SolidColorBrush x:Key="DeckAccent" Color="#00C8FF"/>

    <!-- ============ Base text ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- ============ Buttons ============ -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transport buttons (larger, round-ish) -->
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="RepeatButton" x:Key="NudgeButton">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one stepper geometry. A -/field/+ cluster is 18 px tall with 3 px
         between its boxes wherever it appears, so the TEMPO cluster and the
         karaoke DELAY cluster cannot drift into two shapes. The field beside a
         nudge is the global TextBox with MinHeight 18 and no vertical padding:
         it derives ~15 px from a 10 px font, the floor lifts it to the nudges'
         18, and the three boxes line up exactly. -->
    <Style x:Key="StepperNudge" TargetType="RepeatButton" BasedOn="{StaticResource NudgeButton}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ TextBox ============ -->
    <!-- Height is derived from the font, never fixed: the field grows with its
         text so the whole line box (ascent + descent + line gap) fits inside
         the padding. Segoe UI is ~1.33 em tall, so 12 px text needs ~16 px:
         16 + 6 + 6 (padding) + 1 + 1 (border) = 30 px - MinHeight 32 is a
         floor, not a cap, so a larger FontSize simply makes the box taller.
         Padding sits on the Border (not as a Margin on the host) so the text
         viewport, caret and scrollbars all share one content box, and the
         host follows VerticalContentAlignment so single-line text is centred
         instead of hugging the top of the field. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Multi-line fields fill the box and scroll instead of clipping. -->
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                            <Setter Property="MinHeight" Value="72"/>
                        </Trigger>
                        <Trigger Property="TextWrapping" Value="Wrap">
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ComboBox ============ -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                              Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextDimBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown rows: 8,6 keeps descenders (g, y, p) clear of the item edge
         at the default 12 px font (16 px line box + 12 px padding = 28 px). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <!-- No fixed Height: the closed box is MinHeight-driven exactly like a
             TextBox, so it grows with its font instead of cropping the text. -->
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- reserved lane for the drop-down arrow -->
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.ColumnSpan="2" Style="{StaticResource ComboToggle}" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Popup Grid.ColumnSpan="2" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Slider (seek bar + volume) ============ -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="18"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="5" CornerRadius="2.5" Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <!-- Inset by half the 14 px thumb, so the thumb's centre
                             stops one radius short of each end and the circle stays
                             inside its own groove. Without it the deck scrub at
                             position 0 (or at the end of a track) hung its knob
                             over the edge of the track and past the card's inner
                             edge. -->
                        <Track x:Name="PART_Track" Margin="7,0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="14" Height="14" Fill="{DynamicResource DeckAccent}"
                                                     Stroke="#0E1013" StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <!-- Clickable marks under the groove, for the faders that
                             declare a tick ladder (see SliderTickBar). Last child so
                             it is on top, but it only claims hits within 6 px of a
                             mark: everywhere else the click falls through to the
                             groove and its repeat buttons, so dragging the thumb and
                             click-to-seek behave exactly as they did. Height 6 sits
                             inside the 18 px band the repeat buttons already ask for,
                             so a slider row is no taller than before. -->
                        <views:SliderTickBar Margin="7,0" Height="6" VerticalAlignment="Bottom"
                                             TickBrush="{StaticResource TextDimBrush}"
                                             CenterBrush="{DynamicResource DeckAccent}"
                                             HoverBrush="{StaticResource TextBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ListView / GridView ============ -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <!-- Gripper keeps columns user-resizable -->
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6"
                               Margin="0,0,-3,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- ============ ScrollBar (slim, dark) ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A4150" CornerRadius="4"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ContextMenu & MenuItem ============ -->

    <!-- ============ ToolTip ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BoolToVisibility converter (must be before MenuItem style) -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              Width="16" Height="16"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Path Grid.Column="2" Data="M 0 0 L 4 6 L 8 0 Z"
                                  Fill="{StaticResource TextDimBrush}" Margin="20,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},
                                              Path=HasItems, Converter={StaticResource BoolToVisibility}}"/>
                            <Popup Grid.Column="1" Grid.ColumnSpan="2"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="2">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ============ Panel-root styles (app scope) ============
         A shell panel is a XAML root of its own: it is built before it has a
         parent, so anything it names with StaticResource has to resolve at
         application scope or not at all. These lived in MainWindow.xaml
         (Window.Resources and ShellGrid.Resources), which a docked MIX panel
         or a popped-out one never inherits; phase 3 built MixerPanel before
         its parent existed and it died on RackCaption at line 202.
         One definition, here. MainWindow references it like any other panel.
         Order matters: a StaticResource is resolved where it is written, so
         MicToggle follows DeckCueBrush and RackGate/StripCell follow MicToggle
         and RackCaption (the 7b687b4 defect: StripCell above RackCaption). -->

    <views:ActivityElapsedConverter x:Key="ActivityElapsed"/>

    <!-- The fill a cue toggle lights with when it is engaged. Cyan is what the
         header MON and the mic strip's MON already light with (deck A's own
         accent), and each deck card overrides this key beside DeckAccent, so a
         deck's cue button lights in that deck's colour. One key, one look. -->
    <SolidColorBrush x:Key="DeckCueBrush" Color="#00C8FF"/>

    <Style x:Key="CuePad" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <!-- 15 px: a third of the 44 px pad this used to be, on the operator's
             call that the bank was eating the deck card's height. One line of
             text instead of two stacked ones, so a 15 px pad still reads. -->
        <Setter Property="Height" Value="15"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <!-- 5 px between pads, not 3: nine 15 px boxes in a row need a gap the
             eye can read as a gap before the dashed edge starts to look like
             one continuous dotted rule. -->
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="frame" RadiusX="2" RadiusY="2"
                                   Stroke="{StaticResource TextDimBrush}"
                                   StrokeThickness="1" StrokeDashArray="5 2"
                                   Fill="{TemplateBinding Background}"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock x:Name="slotText" Text="{Binding SlotText}"
                                       FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <!-- The position is only drawn when there is one.
                                 At 15 px an 8 px en dash between the frame edges
                                 read as dust on the button, and an empty pad is
                                 already saying "empty" with its dashed outline. -->
                            <TextBlock x:Name="posText" Text="{Binding PositionText}"
                                       FontFamily="Consolas" FontSize="8"
                                       Margin="4,0,0,0"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasPosition}" Value="True">
                            <Setter TargetName="frame" Property="Stroke"
                                    Value="{StaticResource TextDimBrush}"/>
                            <Setter TargetName="frame" Property="StrokeDashArray"
                                    Value="{x:Null}"/>
                            <Setter TargetName="frame" Property="Fill"
                                    Value="{StaticResource PanelAltBrush}"/>
                            <Setter TargetName="slotText" Property="Foreground"
                                    Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="posText" Property="Visibility"
                                    Value="Visible"/>
                            <Setter TargetName="posText" Property="Foreground"
                                    Value="{StaticResource TextBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsQuick}" Value="True">
                            <Setter Property="Margin" Value="8,0,5,0"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="frame" Property="Stroke"
                                    Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="frame" Property="Stroke"
                                    Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="frame" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle pill for the cue strips: 18 px, dim until engaged, accent fill
    while on. One style, three places - the header's MON/MVSYNC, the mic
    strip's MON/MUTE and each deck card's CUE - so they read as the same kind
    of switch. It has to be declared before the deck card template: a
    StaticResource inside a DataTemplate resolves against the dictionary as
    it stood at that point, so a style defined further down is not found. -->
    <Style x:Key="MicToggle" TargetType="ToggleButton">
    <Setter Property="Height" Value="18"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
    <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
    <Border x:Name="bd" Background="{StaticResource PanelAltBrush}"
    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
    CornerRadius="3">
    <!-- A TextBlock with its own Foreground, not a presenter:
    a ContentPresenter does not follow these triggers, so
    the checked state painted light text on the cyan fill. -->
    <TextBlock x:Name="label" Text="{TemplateBinding Content}"
    Foreground="{TemplateBinding Foreground}"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
    <Setter TargetName="bd" Property="Background"
    Value="{StaticResource HoverBrush}"/>
    </Trigger>
    <Trigger Property="IsChecked" Value="True">
    <Setter TargetName="bd" Property="Background"
    Value="{DynamicResource DeckCueBrush}"/>
    <Setter TargetName="label" Property="Foreground" Value="#08131A"/>
    </Trigger>
    <!-- Keyboard focus. The pill has no chrome to lose, so without this a
    tabbed-to MON or CUE looks identical to the one beside it. -->
    <Trigger Property="IsKeyboardFocused" Value="True">
    <Setter TargetName="bd" Property="BorderBrush"
    Value="{StaticResource TextBrush}"/>
    </Trigger>
    </ControlTemplate.Triggers>
    </ControlTemplate>
    </Setter.Value>
    </Setter>
    </Style>

    <!-- ======== Soundboard pad tile ========
         Same card idiom as the rest of the window: dark panel, 1 px border,
         6 px radius. While the pad is sounding the border takes the deck-A
         accent and a soft glow, so the playing pad reads at a glance from
         across the booth. -->
    <DataTemplate x:Key="SoundboardPadTile">
        <Border Width="128" Height="112" Margin="0,0,8,8" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            <Setter Property="Background" Value="#1B2733"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00C8FF" BlurRadius="16"
                                                      ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="8,7,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Width="16" Height="16" Padding="0"
                            FontSize="10" Margin="4,0,0,0" VerticalAlignment="Top"
                            Foreground="{StaticResource TextDimBrush}"
                            Content="&#x00D7;"
                            ToolTip="Remove this sound"
                            Command="{Binding DataContext.RemoveCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                    <!-- Bind: captures the next chord for this pad. While
                         capturing the glyph turns into a dot so the tile says
                         "waiting for keys" without a dialog. -->
                    <Button DockPanel.Dock="Right" Width="16" Height="16" Padding="0"
                            FontSize="9" Margin="0,0,2,0" VerticalAlignment="Top"
                            Command="{Binding DataContext.BindCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Bind a hotkey (click, then press the keys)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="&#x2328;"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Content" Value="&#x25CF;"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- A real stop, only while the pad sounds: the big button
                         below always means "play" and never changes meaning. -->
                    <Button DockPanel.Dock="Right" Width="16" Height="16" Padding="0"
                            FontSize="8" Margin="0,0,2,0" VerticalAlignment="Top"
                            Foreground="{StaticResource AccentABrush}"
                            Content="&#x25A0;"
                            ToolTip="Stop this sound"
                            Command="{Binding DataContext.StopCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Name}"/>
                </DockPanel>

                <!-- Hotkey, or a quiet "unbound" so the row never jumps.
                     Clicking the line starts a capture, same as the ⌨ button. -->
                <TextBlock Grid.Row="1" Margin="0,2,0,0" FontSize="9" FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                           ToolTip="Click to bind a key combination">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.BindCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}"/>
                    </TextBlock.InputBindings>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Hotkey, TargetNullValue=unbound}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hotkey}" Value="">
                                    <Setter Property="Text" Value="unbound"/>
                                    <Setter Property="Foreground" Value="#5A6270"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hotkey}" Value="{x:Null}">
                                    <Setter Property="Text" Value="unbound"/>
                                    <Setter Property="Foreground" Value="#5A6270"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                    <Setter Property="Text" Value="press keys…"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Text" Value="{Binding Status}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Play affordance. It always reads as play; the playing state
                     shows on the tile border, the accent glyph and the stop
                     button above. Firing again restarts from the top. -->
                <Grid Grid.Row="2" Margin="0,6,0,4">
                    <Button Padding="0" FontSize="16"
                            Command="{Binding DataContext.PlayCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Play this sound (fires again from the top)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="&#x25B6;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                                    </DataTrigger>
                                    <!-- A downloading pad says so instead of pretending
                                         it can be fired. -->
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Content" Value="&#x2026;"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ProgressBar Height="3" VerticalAlignment="Bottom" Margin="2,0,2,-2"
                                 Minimum="0" Maximum="1" Value="{Binding Progress}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>

                <Slider Grid.Row="3" Minimum="0" Maximum="1" SmallChange="0.01"
                        Value="{Binding Volume, Mode=TwoWay}"
                        ToolTip="Level of this sound"/>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="RackGate" TargetType="ToggleButton" BasedOn="{StaticResource MicToggle}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Content" Value="OFF"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="ON"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RackCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- One definition for a CHAIN/PAD cell, used by the strip header and by
         every channel row. Written twice by hand, the two grids drifted: the
         header put its unit inside a 40 px right-aligned value ("0 f"), the row
         put a bare "0" in the same box, so the digits differed by 11 px and the
         right-aligned value never lined up. Here the digit sits right-aligned in
         a fixed 34 px box and the unit has its own 12 px box, so the digit's x
         depends on nothing but the column. -->
    <ControlTemplate x:Key="StripCell" TargetType="HeaderedContentControl">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="12"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{TemplateBinding Header}"
                       Style="{StaticResource RackCaption}"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right"
                       FontFamily="Consolas" FontSize="10"
                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
            <TextBlock Grid.Column="2" Text="{TemplateBinding Tag}"
                       Style="{StaticResource RackCaption}"/>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
