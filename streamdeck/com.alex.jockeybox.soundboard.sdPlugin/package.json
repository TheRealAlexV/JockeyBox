{
  "name": "com.alex.jockeybox.soundboard",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Deck soundboard pads for JockeyBox",
  "type": "module",
  "engines": {
    "node": ">=20.5.1"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "checks": "rollup -c checks/rollup.config.mjs && node checks/run-checks.mjs",
    "validate": "streamdeck validate .",
    "link": "streamdeck link .",
    "restart": "streamdeck restart com.alex.jockeybox.soundboard",
    "check": "node --check bin/plugin.js",
    "e2e": "node checks/run-e2e.mjs",
    "pi": "node checks/run-pi.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^24.1.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  }
}
